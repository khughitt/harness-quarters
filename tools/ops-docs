#!/usr/bin/env python3
# ops-docs version 2
"""A project's guide files — README.md for people, AGENTS.md for agents — rendered and
checked inside one repository.

Vendored from ops bin/ops-docs as tools/ops-docs. `identity.toml` at the repository root
(and at each subsystem root it names) declares what the project is; this tool renders
the declared and derived parts into marked regions of the two files and checks the rest
against the contract. It never writes prose. Design:
docs/specs/2026-09-22-project-guides-design.md.

Exit 0 clean, 1 on a stale region or a constraint finding, 2 when it cannot run.
"""
import argparse
import difflib
import json
import os
import pathlib
import re
import subprocess
import sys
import tomllib

PURPOSE_MAX = 80
ABSTRACT_MAX = 400
ABSTRACT_SENTENCES = 3
AGENTS_BUDGET = 120
README_SECTIONS = ("Setup", "Usage", "Layout", "Consumers")
AGENTS_SECTIONS = ("Setup", "Gates", "Layout", "Rules")
SECTIONS = {"readme": README_SECTIONS, "agents": AGENTS_SECTIONS}
FIELDS = ("name", "aliases", "purpose", "abstract", "authority", "subsystems", "agents")
AGENTS_FIELDS = ("budget", "scope")
SCOPES = ("project", "global")
GUIDES = ("README.md", "AGENTS.md")
IDENTITY_START = "<!-- ops:identity start — generated by ops-docs; edit identity.toml -->"
IDENTITY_END = "<!-- ops:identity end -->"
STATUS_START = "<!-- ops:status start — generated by ops-docs from the tracker; run just docs -->"
STATUS_END = "<!-- ops:status end -->"
STATUS_COMMAND = ["tasks", "list", "--json"] + [
    word for status in ("idea", "todo", "doing", "blocked", "shelved", "done", "dropped")
    for word in ("--status", status)]
OPEN = ("idea", "todo", "doing", "blocked", "shelved")

_SENTENCE = re.compile(r"[.!?]+(?=\s|$)")


class TrackerError(RuntimeError):
    """The tracker ran but did not return its task array."""


def status_records(root, run=subprocess.run):
    """Read every task status in JSON so ambient formatting cannot alter the input."""
    try:
        done = run(STATUS_COMMAND, cwd=str(root), capture_output=True, text=True)
    except FileNotFoundError as error:
        raise LookupError("the tasks binary is not on PATH and README.md has a status region") from error
    if done.returncode != 0:
        raise TrackerError(f"tasks list failed: {done.stderr.strip()}")
    try:
        records = json.loads(done.stdout)["tasks"]
    except (json.JSONDecodeError, KeyError, TypeError) as error:
        raise TrackerError(f"tasks list returned no task array: {error}") from error
    if not isinstance(records, list):
        raise TrackerError("tasks list returned no task array")
    return records


def goal_rows(records):
    """Count direct non-dropped children of each open goal."""
    by_parent = {}
    for task in records:
        if task.get("parent"):
            by_parent.setdefault(task["parent"], []).append(task)
    rows = []
    for task in records:
        if task["status"] not in OPEN or not task.get("child_count"):
            continue
        children = [c for c in by_parent.get(task["id"], []) if c["status"] != "dropped"]
        done = sum(c["status"] == "done" for c in children)
        rows.append({"id": task["id"], "title": task["title"], "done": done,
                     "total": len(children), "closed": done == len(children)})
    return sorted(rows, key=lambda row: row["id"])


def render_status(rows):
    if not rows:
        return f"{STATUS_START}\nNo open goals.\n{STATUS_END}"
    lines = [STATUS_START, "Open goals:"]
    for row in rows:
        line = f"- {row['id']} — {row['title']} — {row['done']} of {row['total']} children done"
        if row["closed"]:
            line += "; direct children closed"
        lines.append(line)
    lines.append(STATUS_END)
    return "\n".join(lines)


def repository_root(cwd):
    """The git toplevel for `cwd`; LookupError outside a repository."""
    done = subprocess.run(["git", "-C", str(cwd), "rev-parse", "--show-toplevel"],
                          capture_output=True, text=True)
    if done.returncode != 0:
        raise LookupError(f"{cwd} is not inside a git repository")
    return pathlib.Path(done.stdout.strip()).resolve()


def tracked(root, rel):
    done = subprocess.run(["git", "-C", str(root), "ls-files", "--error-unmatch", "--", rel],
                          capture_output=True, text=True)
    return done.returncode == 0


def load_identity(path):
    """Parsed identity.toml. A parse failure raises rather than returning {}: an empty
    result would report every field missing instead of the one line that is wrong."""
    try:
        return tomllib.loads(path.read_text())
    except tomllib.TOMLDecodeError as error:
        raise ValueError(f"{path}: {error}") from error


def sentences(text):
    return max(1, len(_SENTENCE.findall(text.strip())))


def _line(value):
    return isinstance(value, str) and value.strip() and "\n" not in value


def inside(top, path):
    """`path`, resolved through every symlink, lies strictly under `top`."""
    resolved = path.resolve()
    return resolved != top and resolved.is_relative_to(top)


def identity_problems(root, ident, nested=False, top=None):
    """Every §3 violation for the file at `root`, one line each. Empty means valid.

    Containment is checked here, on every file the tool will later read or write, and
    a violation blocks every command: `write` renders into these paths, so a guide that
    is a symlink to a file outside the repository would be a write outside it."""
    top = top or root.resolve()
    found = []
    for name in GUIDES + ("identity.toml",):
        path = root / name
        if name != "identity.toml" and not path.is_file():
            found.append(f"{name} is missing")
        elif not inside(top, path):
            found.append(f"{name} resolves outside the repository ({path.resolve()})")
    found.extend(f"unknown key {key}" for key in sorted(set(ident) - set(FIELDS)))
    for key in ("name", "purpose"):
        if not _line(ident.get(key)):
            found.append(f"{key} must be a non-empty single line")
    purpose = ident.get("purpose")
    if isinstance(purpose, str) and len(purpose) > PURPOSE_MAX:
        found.append(f"purpose is {len(purpose)} characters, over {PURPOSE_MAX}")
    abstract = ident.get("abstract")
    if not isinstance(abstract, str) or not abstract.strip():
        found.append("abstract must be a non-empty string")
    else:
        if len(abstract) > ABSTRACT_MAX:
            found.append(f"abstract is {len(abstract)} characters, over {ABSTRACT_MAX}")
        if sentences(abstract) > ABSTRACT_SENTENCES:
            found.append(f"abstract has {sentences(abstract)} sentences, over {ABSTRACT_SENTENCES}")
    aliases = ident.get("aliases", [])
    if not isinstance(aliases, list) or any(not _line(a) for a in aliases):
        found.append("aliases must be a list of non-empty single lines")
    for rel in _string_list(ident, "authority", found):
        if not (root / rel).exists():
            found.append(f"authority {rel} does not exist")
        elif not tracked(root, rel):
            found.append(f"authority {rel} is not tracked")
    subsystems = _string_list(ident, "subsystems", found)
    if nested and "subsystems" in ident:
        found.append("subsystems is not allowed in a subsystem")
    elif not nested:
        for rel in subsystems:
            sub = root / rel
            # Containment before any read: the directory, resolved through every
            # symlink, must be strictly inside the repository. Everything after this
            # reads and later writes under `sub`.
            if pathlib.PurePath(rel).is_absolute() or ".." in pathlib.PurePath(rel).parts:
                found.append(f"subsystem {rel} must be a relative path inside the repository")
                continue
            if not inside(top, sub):
                found.append(f"subsystem {rel} is outside the repository (resolves to {sub.resolve()})")
                continue
            if not sub.is_dir():
                found.append(f"subsystem {rel} does not exist")
                continue
            if not tracked(root, rel):
                found.append(f"subsystem {rel} is not tracked")
            child = sub / "identity.toml"
            if not inside(top, child):
                found.append(f"subsystem {rel}/identity.toml resolves outside the repository")
                continue
            if not child.is_file():
                found.append(f"subsystem {rel} has no identity.toml")
                continue
            try:
                inner = identity_problems(sub, load_identity(child), nested=True, top=top)
            except ValueError as error:
                inner = [str(error)]
            found.extend(f"{rel}/identity.toml: {p}" for p in inner)
    agents = ident.get("agents", {})
    if not isinstance(agents, dict):
        found.append("agents must be a table")
    else:
        found.extend(f"agents: unknown key {k}" for k in sorted(set(agents) - set(AGENTS_FIELDS)))
        budget = agents.get("budget", AGENTS_BUDGET)
        if not isinstance(budget, int) or isinstance(budget, bool) or budget <= 0:
            found.append("agents.budget must be a positive integer")
        elif "budget" in agents and budget <= AGENTS_BUDGET:
            found.append(f"agents.budget must be greater than {AGENTS_BUDGET}")
        if agents.get("scope", "project") not in SCOPES:
            found.append(f"agents.scope must be one of {', '.join(SCOPES)}")
    return found


def render_identity(root, ident, kind):
    """Render identity.toml into the generated region for one guide."""
    lead = ident["abstract"].strip() if kind == "readme" else ident["purpose"].strip()
    lines = [IDENTITY_START, lead]
    authority = ident.get("authority") or []
    if authority:
        lines += ["", "Authority: " + ", ".join(f"`{path}`" for path in authority)]
    subsystems = ident.get("subsystems") or []
    if subsystems:
        lines += ["", "Subsystems:"]
        for rel in subsystems:
            child = load_identity(root / rel / "identity.toml")
            lines.append(f"- `{rel}/` — {child['purpose'].strip()}")
    lines.append(IDENTITY_END)
    return "\n".join(lines)


def _outside_fences(text):
    fenced = False
    for i, line in enumerate(text.splitlines()):
        if line.startswith("```") or line.startswith("~~~"):
            fenced = not fenced
            continue
        if not fenced:
            yield i, line


def headings(text):
    return [(i, line[3:].strip()) for i, line in _outside_fences(text) if line.startswith("## ")]


def h1_index(text):
    for i, line in _outside_fences(text):
        if line.startswith("# "):
            return i
    return None


def _global(kind, ident):
    return kind == "agents" and (ident.get("agents") or {}).get("scope") == "global"


def region(text, start, end, found):
    """Record malformed markers and otherwise return their region."""
    try:
        return find_region(text, start, end)
    except ValueError as error:
        found.append(str(error))
        return None


def marker_problems(kind, text, subsystem=False):
    found = []
    identity = region(text, IDENTITY_START, IDENTITY_END, found)
    status = region(text, STATUS_START, STATUS_END, found)
    if identity is not None and status is not None and identity[0] < status[1] and status[0] < identity[1]:
        found.append("identity and status regions overlap")
    if status is not None and (kind == "agents" or subsystem):
        found.append("status region is allowed only in the root README")
    return found


def shape_problems(kind, text, ident, subsystem=False):
    found = marker_problems(kind, text, subsystem)
    lines = text.splitlines()
    try:
        span = find_region(text, IDENTITY_START, IDENTITY_END)
    except ValueError:
        span = None
    if span is None and not any("ops:identity" in problem for problem in found):
        found.append("identity region is missing")
    if _global(kind, ident):
        return found
    h1 = h1_index(text)
    if h1 is None:
        found.append("no H1")
    elif span is not None:
        after = next((i for i in range(h1 + 1, len(lines)) if lines[i].strip()), None)
        if after is None or lines[after] != IDENTITY_START:
            found.append("identity region must directly follow the H1")
    order = SECTIONS[kind]
    seen = headings(text)
    contracted = [(i, title) for i, title in seen if title in order]
    for (_, earlier), (_, later) in zip(contracted, contracted[1:]):
        if order.index(earlier) > order.index(later):
            found.append(f"{later} must come before {earlier}")
    if contracted:
        last_i, last_title = contracted[-1]
        for i, title in seen:
            if title not in order and i < last_i:
                found.append(f"{title} must come after {last_title}")
    if kind == "readme" and not subsystem:
        try:
            status = find_region(text, STATUS_START, STATUS_END)
        except ValueError:
            status = None
        if status is not None:
            at = text[:status[0]].count("\n")
            before = [title for i, title in seen if i < at and title in ("Setup", "Usage", "Layout")]
            required_before = [title for _, title in seen if title in ("Setup", "Usage", "Layout")]
            if before != required_before:
                found.append(f"status region must come after {required_before[-1]}")
            later = [title for i, title in seen if i < at and (title == "Consumers" or title not in order)]
            if later:
                found.append(f"status region must come before {later[0]}")
    return found


def budget_problems(text, ident):
    if _global("agents", ident):
        return []
    budget = (ident.get("agents") or {}).get("budget", AGENTS_BUDGET)
    count = len(text.splitlines())
    if count > budget:
        return [f"AGENTS.md is {count} lines, over the budget of {budget}"]
    return []


def claude_problems(root):
    path = root / "CLAUDE.md"
    if not path.exists() and not path.is_symlink():
        return []
    if path.is_symlink():
        if path.resolve() == (root / "AGENTS.md").resolve():
            return []
    elif path.read_text().strip() == "@AGENTS.md":
        return []
    return ["CLAUDE.md must be `@AGENTS.md` or a symlink to AGENTS.md; two agent guides diverge"]


def find_region(text, start, end):
    """Return marker offsets, or None when both markers are absent."""
    starts, ends = text.count(start), text.count(end)
    if starts == 0 and ends == 0:
        return None
    name = start.split()[1]
    if starts != 1 or ends != 1:
        raise ValueError(f"{name} markers are malformed: {starts} start, {ends} end; exactly one pair is allowed")
    a, b = text.find(start), text.find(end)
    if b < a:
        raise ValueError(f"{name} markers are malformed: end before start")
    return a, b + len(end)


def replace_region(text, start, end, block):
    span = find_region(text, start, end)
    if span is None:
        raise LookupError(f"no {start.split()[1]} markers; run `write --init` once")
    a, b = span
    return text[:a] + block + text[b:]


def _string_list(ident, key, found):
    value = ident.get(key, [])
    if not isinstance(value, list) or any(not _line(v) for v in value):
        found.append(f"{key} must be a list of non-empty single lines")
        return []
    return value


def insert_identity(text, global_scope=False):
    """`text` with empty identity markers at their contracted place: right after the H1.
    A global guide (§4, *The global file*) is exempt from the H1; without one the region
    opens the file."""
    if find_region(text, IDENTITY_START, IDENTITY_END) is not None:
        return text
    h1 = h1_index(text)
    if h1 is None and global_scope:
        return f"{IDENTITY_START}\n{IDENTITY_END}\n\n{text}"
    if h1 is None:
        raise LookupError("no H1 to place the identity region after")
    lines = text.splitlines(keepends=True)
    block = f"\n{IDENTITY_START}\n{IDENTITY_END}\n"
    head = "".join(lines[:h1 + 1])
    tail = "".join(lines[h1 + 1:])
    if not tail.startswith("\n"):
        block += "\n"
    return head + block + tail


def insert_status(text):
    if find_region(text, STATUS_START, STATUS_END) is not None:
        return text
    lines = text.splitlines(keepends=True)
    seen = headings(text)
    at = next((i for i, title in seen if title == "Consumers"), None)
    if at is None:
        at = next((i for i, title in seen if title not in README_SECTIONS), None)
    block = f"{STATUS_START}\n{STATUS_END}\n"
    if at is None:
        return text.rstrip("\n") + "\n\n" + block
    return "".join(lines[:at]) + block + "\n" + "".join(lines[at:])


def guides(root, ident):
    """The root and every declared subsystem, each with its identity and label prefix."""
    yield root, ident, "", False
    for rel in ident.get("subsystems") or []:
        yield root / rel, load_identity(root / rel / "identity.toml"), f"{rel}/", True


def rendered(root, ident, name, text, run=subprocess.run, subsystem=False):
    kind = "readme" if name == "README.md" else "agents"
    problems = marker_problems(kind, text, subsystem)
    if problems:
        raise ValueError("; ".join(problems))
    out = replace_region(text, IDENTITY_START, IDENTITY_END, render_identity(root, ident, kind))
    if kind == "readme" and not subsystem and find_region(out, STATUS_START, STATUS_END) is not None:
        out = replace_region(out, STATUS_START, STATUS_END, render_status(goal_rows(status_records(root, run))))
    return out


def _report(found, diffs, brief):
    if brief:
        summary = "; ".join(found[:3]) if found else "a guide region is out of date"
        if len(found) > 3:
            summary += f" (+{len(found) - 3} more)"
        sys.stderr.write(f"ops-docs: {summary} — run `just docs`\n")
        return 1
    for problem in found:
        sys.stderr.write(f"ops-docs: {problem}\n")
    for diff in diffs:
        sys.stderr.writelines(diff)
    sys.stderr.write("ops-docs: run `just docs` to apply\n")
    return 1


def main(argv, env, cwd, run=subprocess.run):
    parser = argparse.ArgumentParser(prog="ops-docs", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("render").add_argument("file", choices=GUIDES)
    writer = sub.add_parser("write")
    writer.add_argument("--init", action="store_true", help="insert the identity markers after the H1 when absent")
    writer.add_argument("--init-status", action="store_true", help="insert the README status markers when absent")
    checker = sub.add_parser("check")
    checker.add_argument("--brief", action="store_true", help="one line instead of a diff, for a hook")
    args = parser.parse_args(argv)
    brief = getattr(args, "brief", False)

    try:
        root = repository_root(pathlib.Path(cwd))
    except LookupError as error:
        sys.stderr.write(f"ops-docs: {error}\n")
        return 2
    path = root / "identity.toml"
    if not path.is_file():
        sys.stderr.write(f"ops-docs: {path} is missing; every adopted project declares one\n")
        return 2
    if not inside(root, path):
        sys.stderr.write(f"ops-docs: {path} resolves outside the repository ({path.resolve()})\n")
        return 2
    try:
        ident = load_identity(path)
    except ValueError as error:
        sys.stderr.write(f"ops-docs: {error}\n")
        return 2
    if not (root / "README.md").is_file():
        sys.stderr.write("ops-docs: README.md is missing\n")
        return 2

    identity_findings = [f"identity.toml: {problem}" for problem in identity_problems(root, ident)]
    if identity_findings:
        if args.command == "check" and all(problem.endswith("is not tracked") for problem in identity_findings):
            pass
        elif args.command == "check":
            return _report(identity_findings, [], brief)
        else:
            for problem in identity_findings:
                sys.stderr.write(f"ops-docs: {problem}\n")
            return 2

    if args.command == "write":
        texts = [(base, decl, prefix, subsystem, name, (base / name).read_text())
                 for base, decl, prefix, subsystem in guides(root, ident) for name in GUIDES]
        refusals = [f"{prefix}{name}: {problem}"
                    for base, decl, prefix, subsystem, name, text in texts
                    for problem in marker_problems("readme" if name == "README.md" else "agents", text, subsystem)]
        if refusals:
            for problem in refusals:
                sys.stderr.write(f"ops-docs: {problem}\n")
            return 2
        outputs = []
        try:
            for base, decl, prefix, subsystem, name, text in texts:
                if args.init:
                    kind = "readme" if name == "README.md" else "agents"
                    text = insert_identity(text, _global(kind, decl))
                if args.init_status and name == "README.md" and not subsystem:
                    text = insert_status(text)
                outputs.append((base / name, rendered(base, decl, name, text, run, subsystem)))
        except (LookupError, ValueError, TrackerError) as error:
            sys.stderr.write(f"ops-docs: {error}\n")
            return 2
        for path, text in outputs:
            path.write_text(text)
        return 0

    if args.command == "render":
        try:
            sys.stdout.write(rendered(root, ident, args.file, (root / args.file).read_text(), run))
        except (LookupError, ValueError, TrackerError) as error:
            sys.stderr.write(f"ops-docs: {error}\n")
            return 2
        return 0

    found, diffs = identity_findings, []
    for base, decl, prefix, subsystem in guides(root, ident):
        if subsystem and not tracked(root, prefix.rstrip("/")):
            found.append(f"subsystem {prefix.rstrip('/')} is not tracked")
        for name in GUIDES:
            label, text = prefix + name, (base / name).read_text()
            kind = "readme" if name == "README.md" else "agents"
            shape = shape_problems(kind, text, decl, subsystem)
            found.extend(f"{label}: {problem}" for problem in shape)
            if kind == "agents":
                found.extend(f"{label}: {problem}" for problem in budget_problems(text, decl))
            if marker_problems(kind, text, subsystem) or "identity region is missing" in shape:
                continue
            try:
                current = rendered(base, decl, name, text, run, subsystem)
            except LookupError as error:
                sys.stderr.write(f"ops-docs: {error}\n")
                return 2
            except TrackerError as error:
                found.append(f"{label}: {error}")
                continue
            if current != text:
                diffs.append(difflib.unified_diff(text.splitlines(keepends=True), current.splitlines(keepends=True),
                                                  fromfile=label, tofile=f"ops-docs render {label}"))
        found.extend(f"{prefix}{problem}" for problem in claude_problems(base))
    if not found and not diffs:
        return 0
    return _report(found, diffs, brief)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:], dict(os.environ), os.getcwd()))
