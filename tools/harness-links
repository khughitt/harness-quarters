#!/usr/bin/env python3
"""Converge this host's home links and directories from links.toml.

Report mode prints one line per entry and writes nothing; --check exits 1 on any
drift; --apply writes, and only when no entry is refused. A link counts as ok when its
immediate target matches, allowing parent-directory aliases. A dangling or foreign
link is repointed; a real file or directory at a link path is refused, never
overwritten, except a regular file at a link listed in a harness's `adopt` (`--check`
exits 1). Once one of its `anchors` already points into this checkout, the file replaced
the link, and `--apply` syncs and relinks it through `.githooks/live-picks sync`. Before
any anchor is linked, the file is a first-run file the harness wrote before this checkout
managed its home: it is adopted only when this run would create every anchor (nothing,
not even a foreign link, is at any of them), and `--apply` runs `.githooks/live-picks
first-run`, which keeps the tracked config and refuses keys outside the live state that
it does not hold, before it creates any link. Required links go on
every host (their parent directory is created); a harness group applies only where its
home is a real directory. Run from the main checkout: links must never resolve into a
worktree. A target is checked only when its entry applies (a required link, or a group
whose home is a real directory); a missing one is an error, never created. Design:
docs/specs/2026-09-27-rename-to-tack-design.md, docs/specs/2026-09-28-local-layer-design.md.

Targets are checkout-relative or <project>:<relative-path>, resolved through
`tasks projects --paths`. [directories] maps directory paths to their former link
targets: only a link to that target can be converted, before child links are made.
[retired] maps paths to former targets: only matching links, dangling or not, are
removed. Undeclared paths are never pruned. See the agent-layer split design in ops.
"""
import argparse
import json
import os
import stat
import subprocess
import sys
import tomllib
from dataclasses import dataclass
from pathlib import Path

HERE = Path(__file__).resolve().parent


class ManifestError(Exception):
    pass


class ApplyRefused(Exception):
    pass


@dataclass(frozen=True)
class Entry:
    link: Path
    target: Path
    home: Path | None      # None for a required link
    kind: str = "link"     # link, directory, or retired
    adopt: bool = False
    anchors: tuple[Path, ...] = ()


def git(*args):
    result = subprocess.run(["git", "-C", str(HERE), *args], text=True, capture_output=True)
    if result.returncode != 0:
        sys.exit(f"harness-links: git {' '.join(args)}: {result.stderr.strip()}")
    return result.stdout.strip()


def checkout_root():
    git_dir = Path(git("rev-parse", "--absolute-git-dir"))
    common = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir"))
    if git_dir.resolve() != common.resolve():
        print("harness-links: run from the main checkout, not a worktree", file=sys.stderr)
        sys.exit(2)
    return Path(git("rev-parse", "--show-toplevel"))


def expand(path):
    return Path(os.path.expanduser(path))


def load(root):
    data = tomllib.loads((root / "links.toml").read_text())
    projects = None

    def target(value, home=None):
        nonlocal projects
        if ":" not in value:
            if Path(value).is_absolute() or ".." in Path(value).parts:
                raise ManifestError(f"{value}: target must be a relative path within its checkout")
            return root / value
        if home is not None and not is_real_dir(home):
            return root / value
        prefix, rel = value.split(":", 1)
        if not rel or Path(rel).is_absolute() or ".." in Path(rel).parts:
            raise ManifestError(f"{value}: project target must be a relative path within its checkout")
        if projects is None:
            try:
                result = subprocess.run(["tasks", "projects", "--paths", "--json"], text=True,
                                        capture_output=True)
                if result.returncode:
                    raise ManifestError(f"tasks projects --paths failed: {result.stderr.strip()}")
                projects = {p["prefix"]: expand(p["root"]) for p in json.loads(result.stdout)["projects"]}
            except (OSError, ValueError, KeyError) as error:
                raise ManifestError(f"cannot read the tasks project registry: {error}") from error
        if prefix not in projects:
            raise ManifestError(f"{prefix}: project is not registered; register its checkout with tasks init")
        return projects[prefix] / rel

    entries = [Entry(expand(link), target(rel), None, "directory")
               for link, rel in data.get("directories", {}).items()]
    for entry in entries:
        if root != entry.target and root not in entry.target.parents:
            raise ManifestError(f"{entry.link}: directory's former target must belong to the running checkout")
    entries += [Entry(expand(link), target(rel), None) for link, rel in data.get("required", {}).items()]
    raw_targets = {expand(link): rel for link, rel in data.get("required", {}).items()}
    homes = []
    for name, table in data.get("harness", {}).items():
        home = expand(table["home"])
        homes.append(home)
        raw_adopt = table.get("adopt", [])
        if not isinstance(raw_adopt, list) or not all(isinstance(item, str) for item in raw_adopt):
            raise ManifestError(f"harness.{name}.adopt must be a list of link names")
        adopt_set = set(raw_adopt)
        for item in raw_adopt:
            if item not in table["links"]:
                raise ManifestError(f"harness.{name}.adopt: {item!r} is not in harness.{name}.links")
        raw_anchors = table.get("anchors")
        if not adopt_set and raw_anchors is not None:
            raise ManifestError(f"harness.{name}.anchors requires adopt")
        if adopt_set:
            if raw_anchors is None:
                anchor_paths = tuple(home / other for other in table["links"] if other not in adopt_set)
            elif isinstance(raw_anchors, list) and all(isinstance(a, str) for a in raw_anchors):
                anchor_paths = tuple(expand(a) for a in raw_anchors)
            else:
                raise ManifestError(f"harness.{name}.anchors must be a list of link paths")
            if not anchor_paths:
                raise ManifestError(f"harness.{name}.adopt requires at least one anchor link")
        else:
            anchor_paths = ()
        for link, rel in table["links"].items():
            raw_targets[home / link] = rel
            entry_target = target(rel, home)
            is_adopt = link in adopt_set
            if is_adopt and (":" in rel or root not in entry_target.parents):
                raise ManifestError(f"{home / link}: adopted link target must belong to the running checkout")
            entries.append(Entry(home / link, entry_target, home, adopt=is_adopt,
                                 anchors=anchor_paths if is_adopt else ()))
    by_link = {entry.link: entry for entry in entries if entry.kind == "link"}
    for entry in entries:
        for anchor in entry.anchors:
            anchor_entry = by_link.get(anchor)
            if (anchor_entry is None or anchor == entry.link
                    or ":" in raw_targets.get(anchor, "")
                    or root not in anchor_entry.target.parents):
                raise ManifestError(
                    f"{entry.link}: anchor {anchor} must be another declared link into the running checkout"
                )
            if anchor_entry.adopt:
                raise ManifestError(f"{entry.link}: anchor {anchor} must not itself be adopted")
    declared = {entry.link for entry in entries}
    for link, rel in data.get("retired", {}).items():
        path = expand(link)
        if path in declared:
            raise ManifestError(f"{path} is both declared and retired")
        entries.append(Entry(path, target(rel), None, "retired"))
    links = [entry.link for entry in entries if entry.kind == "link"]
    paths = [entry.link for entry in entries]
    for path in [*paths, *homes]:
        if ".." in path.parts:
            raise ManifestError(f"{path}: managed home paths must not contain ..")
    if len(paths) != len(set(paths)):
        raise ManifestError("a path is declared more than once")
    for managed in links:
        for path in [*paths, *homes]:
            if path != managed and managed in path.parents:
                raise ManifestError(f"{path} lies under the managed link {managed}")
    for home in homes:
        if home in links:
            raise ManifestError(f"harness home {home} is a managed link")
    return entries, homes


def is_real_dir(path):
    return path.is_dir() and not path.is_symlink()


def active(entry):
    return entry.home is None or is_real_dir(entry.home)


def check_targets(root, entries):
    """Every target this host will link to exists. A skipped group's targets are not
    checked: a public clone has no local/, and a host without a work home needs none."""
    for entry in entries:
        if entry.kind == "retired" or not active(entry) or entry.target.exists():
            continue
        message = f"{entry.link}: target {entry.target} does not exist"
        if (root / "local") in entry.target.parents:
            message += ("; local/ is untracked: copy it from another host's `local/`, "
                        "or run `just setup` for the directories it creates")
        raise ManifestError(message)


def is_anchored(entry, by_link):
    if not by_link:
        return False
    return any(
        anchor in by_link
        and by_link[anchor].link.is_symlink()
        and by_link[anchor].link.exists()
        and owns_link(by_link[anchor])
        for anchor in entry.anchors
    )


def first_run(entry, by_link):
    """Whether this run would create every anchor of entry: nothing, not even a link, is at any."""
    if not by_link:
        return False
    return all(
        anchor in by_link
        and active(by_link[anchor])
        and state(by_link[anchor], by_link)[0] == "create"
        for anchor in entry.anchors
    )


def state(entry, by_link=None):
    if entry.kind == "retired":
        if entry.link.is_symlink():
            if owns_link(entry):
                return "remove", ""
            return "refuse", f"a foreign link is there: {os.readlink(entry.link)}"
        if not entry.link.exists():
            return "ok", ""
        return "refuse", "a real file or directory is there"
    if entry.kind == "directory":
        if entry.link.is_symlink():
            if owns_link(entry):
                return "convert", f"was {os.readlink(entry.link)}"
            return "refuse", f"a foreign link is there: {os.readlink(entry.link)}"
        if is_real_dir(entry.link):
            return "ok", ""
        if entry.link.exists():
            return "refuse", "a real file is there"
        return "create", ""
    if entry.link.is_symlink():
        if entry.link.exists() and owns_link(entry):
            return "ok", ""
        return "repoint", f"was {os.readlink(entry.link)}"
    if entry.link.exists():
        if entry.adopt and stat.S_ISREG(entry.link.lstat().st_mode):
            if is_anchored(entry, by_link):
                return "adopt", "replaced by a regular file"
            if first_run(entry, by_link):
                return "adopt", "a first-run file, adopted before its anchors are linked"
        kind = "directory" if entry.link.is_dir() else "file"
        return "refuse", f"a real {kind} is there"
    return "create", ""


def owns_link(entry):
    # Resolve parent aliases, but not the final target: a replacement link to the
    # same ultimate object is not the link we installed and cannot prove ownership.
    actual = entry.link.parent / os.readlink(entry.link)
    target = entry.target
    return actual.parent.resolve() / actual.name == target.parent.resolve() / target.name


def show(path):
    home = Path.home()
    return f"~/{path.relative_to(home)}" if home in path.parents else str(path)


def plan(entries, homes):
    rows, skipped, converting = [], set(), set()
    by_link = {entry.link: entry for entry in entries if entry.kind == "link"}
    # Parent directories are planned first. Children of a conversion do not exist
    # in the future home yet: inspecting them now would follow the old checkout link.
    ordered = sorted(entries, key=lambda e: (e.kind != "directory", len(e.link.parts)))
    for entry in ordered:
        if not active(entry):
            if entry.home not in skipped:
                skipped.add(entry.home)
                rows.append(("skipped", entry.home, f"{show(entry.home)} absent", None))
            continue
        if any(parent in converting for parent in entry.link.parents):
            name, detail = ("ok" if entry.kind == "retired" else "create"), ""
        else:
            name, detail = state(entry, by_link)
        if name == "convert":
            converting.add(entry.link)
        rows.append((name, entry.link, detail, entry))
    return rows


def restage_if_filtered_equal(checkout, target_path):
    rel = target_path.relative_to(checkout).as_posix()
    lock_res = subprocess.run(
        ["git", "-C", str(checkout), "rev-parse", "--path-format=absolute", "--git-path", "index.lock"],
        text=True,
        capture_output=True,
    )
    if lock_res.returncode != 0 or Path(lock_res.stdout.strip()).exists():
        return
    diff = subprocess.run(["git", "-C", str(checkout), "diff", "--quiet", "--", rel],
                          text=True, capture_output=True)
    if diff.returncode == 0:
        add = subprocess.run(["git", "-C", str(checkout), "add", "--", rel],
                             text=True, capture_output=True)
        if add.returncode != 0:
            raise ApplyRefused(f"git add {rel}: {add.stderr.strip()}")


def live_picks(checkout, operation):
    env = {**os.environ, "PYTHONDONTWRITEBYTECODE": "1"}
    result = subprocess.run([sys.executable, "-B", str(checkout / ".githooks" / "live-picks"), operation],
                            env=env, text=True, capture_output=True)
    if result.returncode != 0:
        raise ApplyRefused(result.stderr.strip() or f"live-picks {operation} exited {result.returncode}")


def adopt_rows(entries, by_link, checkout, operation):
    """Refuse an adopted entry refused since the plan, run live-picks, then require each one linked."""
    for entry in entries:
        current, detail = state(entry, by_link)
        if current == "refuse":
            raise ApplyRefused(f"{show(entry.link)}: {detail}")
    live_picks(checkout, operation)
    for entry in entries:
        current, detail = state(entry, by_link)
        if current != "ok":
            raise ApplyRefused(f"{show(entry.link)}: {detail or f'still {current} after live-picks {operation}'}")
        restage_if_filtered_equal(checkout, entry.target)


def apply(rows, root=None):
    by_link = {entry.link: entry for _, _, _, entry in rows if entry is not None and entry.kind == "link"}
    # A first-run file is adopted before anything is written: once an anchor is linked,
    # the file would read as a replaced link and become the base of the tracked config.
    first = [entry for name, _, _, entry in rows
             if name == "adopt" and not is_anchored(entry, by_link)]
    if first:
        adopt_rows(first, by_link, root or Path(git("rev-parse", "--show-toplevel")), "first-run")
    adopted = []
    for name, _, _, entry in rows:
        if entry is None:
            continue
        if entry.kind == "directory":
            current, detail = state(entry, by_link)
            if current == "refuse":
                raise ApplyRefused(f"{show(entry.link)}: {detail}")
            if current == "convert":
                entry.link.unlink()
            entry.link.mkdir(parents=True, exist_ok=True)
            continue
        if entry.kind == "retired":
            if name == "remove":
                current, detail = state(entry, by_link)
                if current == "refuse":
                    raise ApplyRefused(f"{show(entry.link)}: {detail}")
                if current == "remove":
                    entry.link.unlink()
            continue
        if name == "adopt":
            if entry not in first:
                adopted.append(entry)
            continue
        if name not in ("create", "repoint"):
            continue
        entry.link.parent.mkdir(parents=True, exist_ok=True)
        staging = entry.link.with_name(f".{entry.link.name}.harness-links")
        if staging.is_symlink():
            staging.unlink()
        staging.symlink_to(entry.target)
        # Re-check immediately before the swap: plan() ran earlier, and a real file or
        # directory may have appeared at this link path since. Never replace one.
        if entry.link.exists() and not entry.link.is_symlink():
            kind = "directory" if entry.link.is_dir() else "file"
            staging.unlink()
            raise ApplyRefused(f"{show(entry.link)}: a real {kind} is there")
        os.replace(staging, entry.link)
    if adopted:
        adopt_rows(adopted, by_link, root or Path(git("rev-parse", "--show-toplevel")), "sync")


def main(argv):
    parser = argparse.ArgumentParser(prog="harness-links", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check", action="store_true", help="exit 1 on any drift")
    mode.add_argument("--apply", action="store_true", help="converge the links")
    args = parser.parse_args(argv)
    root = checkout_root()
    try:
        entries, homes = load(root)
        check_targets(root, entries)
    except (ManifestError, KeyError, tomllib.TOMLDecodeError) as error:
        print(f"harness-links: links.toml: {error}", file=sys.stderr)
        return 2
    rows = plan(entries, homes)
    for name, path, detail, _ in rows:
        print(f"{name}\t{show(path)}\t{detail}".rstrip("\t"))
    refused = any(row[0] == "refuse" for row in rows)
    if args.check:
        return 1 if any(row[0] in ("create", "repoint", "convert", "remove", "adopt", "refuse") for row in rows) else 0
    if args.apply and not refused:
        try:
            apply(rows, root)
        except ApplyRefused as error:
            print(f"harness-links: {error}", file=sys.stderr)
            return 1
    return 1 if refused else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
