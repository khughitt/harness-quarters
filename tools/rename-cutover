#!/usr/bin/env python3
"""A project rename's cutover: save originals, apply, retarget, link, verify, roll back.

Written for docs/specs/2026-09-27-rename-to-tack-design.md and made general by
docs/specs/2026-10-06-rename-to-hq-design.md §3.1. Every path comes from the command line
or the snapshot's meta.json, and every tasks call inherits HOME, XDG_CONFIG_HOME and
XDG_STATE_HOME, so a sandbox rehearsal runs exactly this code. `tasks rename` is
irreversible; rollback restores the saved originals and stops, leaving the state for a
person, at the first check that fails.

The renamed project is the checkout; the other repositories are the ones the cutover
retargets in. Each may be an in-tree or a detached tasks project (tasks
docs/project-operations.md, Layout and adoption); a detached project's records live in a
records repository outside every snapshot repository, where the cutover owns `<old>/` and
`<new>/` (the checkout's) and `<p>/` (each detached repository's). Rollback resets the
checkout and the in-tree repositories, never a detached repository's code checkout, and
in a records repository restores only the owned paths, leaving every other project's
records there alone (docs/specs/2026-11-02-detached-rename-cutover-design.md). `apply`
renames and moves (for a detached checkout it prints the records commit the runbook
runs), `retarget` fixes dependencies on retired ids in one of them or, with `--forward`,
in every project outside them, `link` applies the home links, and `verify` checks the
result: the runbook commits between them.

The other host, once its sync has delivered the moved checkout (and the committed records
repository), runs `tasks rename <old> <new> --adopt` in the new root; no `init` follows.
"""
import argparse
import filecmp
import json
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tomllib
from pathlib import Path


class Stop(Exception):
    pass


def run(*cmd, cwd=None):
    result = subprocess.run([str(c) for c in cmd], cwd=cwd, text=True, capture_output=True)
    if result.returncode != 0:
        raise Stop(f"{' '.join(map(str, cmd))}: {(result.stderr or result.stdout).strip()}")
    return result.stdout


def xdg(name, default):
    return Path(os.environ.get(name) or Path.home() / default)


def porcelain(root):
    return run("git", "-C", root, "status", "--porcelain", "--untracked-files=all").splitlines()


def branch_of(root):
    """`git symbolic-ref -q HEAD`: the current branch, or "" when detached."""
    result = subprocess.run(["git", "-C", str(root), "symbolic-ref", "-q", "HEAD"], text=True,
                            capture_output=True)
    return result.stdout.strip() if result.returncode == 0 else ""


def record(root):
    """A repository as save finds it: its path, its commit and its branch."""
    return {"root": str(root), "head": run("git", "-C", root, "rev-parse", "HEAD").strip(),
            "branch": branch_of(root)}


def load_meta(snap):
    return json.loads((Path(snap) / "meta.json").read_text())


def checkout_now(meta):
    """The checkout's path at this moment: the new root once apply has moved it."""
    new_root = Path(meta["new_root"])
    return new_root if new_root.exists() else Path(meta["checkout"]["root"])


def link_tool(root, meta):
    return Path(root) / meta["link_tool"]


def check_environment(command, meta):
    """A rehearsal snapshot and a live one both carry meta.json; refuse to run one
    against the other host's HOME/XDG dirs rather than silently touching the wrong state."""
    checks = {
        "home": Path.home().resolve() == Path(meta["home"]).resolve(),
        "config": (xdg("XDG_CONFIG_HOME", ".config") / "tasks").resolve() == Path(meta["config"]).resolve(),
        "state": (xdg("XDG_STATE_HOME", ".local/state") / "tasks").resolve() == Path(meta["state"]).resolve(),
    }
    bad = [name for name, ok in checks.items() if not ok]
    if bad:
        raise Stop(f"{command}: environment does not match the snapshot ({', '.join(bad)})")


def in_tree_repos(meta):
    """The --repo repositories rollback resets: a detached one's code checkout is never
    written by the cutover, so it is not reset, checked for leftovers or required clean."""
    return [r for r in meta["repos"] if r["kind"] == "in-tree"]


def check_branches(meta):
    """The current branch of each repository, checked before any mutation: rollback must
    not reset or restore in a branch a person has since switched away from."""
    pairs = [(checkout_now(meta), meta["checkout"]["branch"])]
    pairs += [(Path(r["root"]), r["branch"]) for r in in_tree_repos(meta)]
    pairs += [(Path(r["root"]), r["branch"]) for r in meta["records_repos"]]
    for root, expected in pairs:
        current = branch_of(root)
        if current != expected:
            raise Stop(f"rollback: {root} is on {current or '(detached)'}, "
                       f"expected {expected or '(detached)'}")


def link_report(tool):
    result = subprocess.run([str(tool)], text=True, capture_output=True)
    if result.returncode not in (0, 1):
        raise Stop(f"{tool.name}: {result.stderr.strip()}")
    return result.stdout


def project_row(root, command):
    """The `tasks projects` row registered at `root`: its prefix, and `records`, where its
    task records live (tasks docs/project-operations.md, Layout and adoption)."""
    root = Path(root).resolve()
    # Run where the root is: tasks reads the working directory, which a moved checkout
    # may have left behind in the caller's shell.
    for row in json.loads(run("tasks", "projects", "--json", cwd=root))["projects"]:
        if Path(row["root"]).resolve() == root:
            return row
    raise Stop(f"{command}: no registered project has its root at {root}")


def project_kind(root, command):
    """The row of a snapshot project this cutover renames or retargets in: reachable, and
    in-tree or detached. An unreachable row has no kind because its config was not read. A linked
    project's records sit in an overlay directory the cutover neither saves nor resets."""
    row = project_row(root, command)
    kind = row.get("kind")
    if not row.get("reachable"):
        raise Stop(f"{command}: {root} ({row['prefix']}) is unreachable: tasks projects cannot read its "
                   f"records, so its kind is unknown; make them readable first")
    if kind is None:
        raise Stop(f"{command}: {root} ({row['prefix']}) is reachable but tasks projects gives it no kind; "
                   f"update tasks to one that reports kind (records-home) first")
    if kind == "linked":
        raise Stop(f"{command}: {root} is a linked project; this cutover renames and retargets only "
                   f"in-tree and detached projects")
    if kind not in ("in-tree", "detached"):
        raise Stop(f"{command}: {root} has kind {kind!r}, which this cutover does not know")
    return row


def records_repo(row):
    """A detached project's records repository: the git top level of its records directory,
    which this cutover requires directly under that top level and named for the prefix. The
    owned paths (`<old>/`, `<new>/`, `<p>/`) are relative to it, so both must hold."""
    records = Path(row["records"]).resolve()
    top = Path(run("git", "-C", records, "rev-parse", "--show-toplevel").strip()).resolve()
    if records.parent != top or records.name != row["prefix"]:
        raise Stop(f"save: {row['prefix']}'s records directory {records} must be named {row['prefix']} "
                   f"and sit directly under its repository's top level {top}")
    return top


def unmerged_branches(root):
    """Local branches holding commits the current branch, main, lacks. Merged after the
    rename, such a branch would bring old-prefix task files back."""
    current = branch_of(root)
    names = run("git", "-C", root, "for-each-ref", "--format=%(refname)", "refs/heads").split()
    return [name.removeprefix("refs/heads/") for name in names
            if name != current and run("git", "-C", root, "rev-list", "--count", f"HEAD..{name}").strip() != "0"]


def check_main_only(root):
    """On main, with no stash, one worktree and no unmerged branch: any of those could bring
    old-prefix records back after the rename."""
    if branch_of(root) != "refs/heads/main":
        raise Stop(f"preconditions: {root} is on {branch_of(root) or '(detached)'}, not main")
    if run("git", "-C", root, "stash", "list").strip():
        raise Stop(f"preconditions: {root} has stashes; one popped after the rename could bring "
                   f"old-prefix task files back")
    if run("git", "-C", root, "worktree", "list", "--porcelain").count("\nworktree ") != 0:
        raise Stop(f"preconditions: {root} has more than one worktree")
    ahead = unmerged_branches(root)
    if ahead:
        raise Stop(f"preconditions: {root} has branches with commits its current branch lacks: "
                   f"{', '.join(ahead)}")


def check_records_repo(top, entry, old):
    """A records repository the cutover owns paths in. `<old>/` holds no untracked, ignored
    or changed file, so every file there after the rename is the rename's; each `<p>/` has no tracked
    change; nothing is staged anywhere, since tasks defers every record commit while
    something is, which would leave `retarget --repo`'s writes uncommitted. Untracked files
    under `<p>/` and outside the owned paths are another session's, and left alone."""
    check_main_only(top)
    if entry["rename"]:
        found = run("git", "-C", top, "status", "--porcelain", "--untracked-files=all", "--ignored",
                    "--", f"{old}/").splitlines()
        if found:
            raise Stop(f"preconditions: {top} has untracked, ignored or changed files under {old}/: "
                       f"{', '.join(line.strip() for line in found)}; every file there after the rename "
                       f"must be the rename's, so commit, discard or move them aside first")
    for p in entry["prefixes"]:
        found = run("git", "-C", top, "status", "--porcelain", "--untracked-files=no",
                    "--", f"{p}/").splitlines()
        if found:
            raise Stop(f"preconditions: {top} has tracked changes under {p}/: "
                       f"{', '.join(line.strip() for line in found)}; commit or discard them first")
    staged = run("git", "-C", top, "diff", "--cached", "--name-only").splitlines()
    if staged:
        raise Stop(f"preconditions: {top} has staged changes ({', '.join(staged)}); tasks defers every "
                   f"record commit while something is staged, so commit or unstage them first")


def preconditions(checkout, rows, records, old, tool):
    repos = [root for root in rows if root != checkout]
    claims = json.loads(run("tasks", "claims"))["claims"]
    retargeted = {rows[root]["prefix"] for root in repos}
    # A `tasks dep` write prunes dead claims from the project it writes in, and the guard
    # compares every other project's claims file byte for byte: a repository the cutover
    # retargets in must hold no claim at all, live or dead.
    held = [c["id"] for c in claims if c.get("prefix") in retargeted]
    if held:
        raise Stop(f"preconditions: a retargeted repository has claims (live or dead): {', '.join(held)}; "
                   f"end or clear them first")
    live = [c for c in claims if c.get("live")]
    if live:
        raise Stop("preconditions: live claim(s): " + ", ".join(c["id"] for c in live))
    # The cutover never writes in a detached --repo's code checkout: its writes land in the
    # records repository, checked below.
    for root in (checkout, *(r for r in repos if rows[r]["kind"] == "in-tree")):
        if porcelain(root):
            raise Stop(f"preconditions: {root} is not clean")
    for top, entry in records.items():
        check_records_repo(top, entry, old)
    for root in (checkout, *repos):
        if run("tasks", "check", cwd=root).strip():
            raise Stop(f"preconditions: tasks check reports findings in {root}; verify and rollback "
                       f"both require it clean, so resolve them first")
    check_main_only(checkout)
    check = subprocess.run([str(tool), "--check"], text=True, capture_output=True)
    if check.returncode != 0:
        raise Stop(f"preconditions: link drift:\n{check.stdout}")


def kept_paths(checkout, paths):
    """Files git cannot restore (a clean filter keeps their live content out of every
    commit, or they are ignored), named relative to the checkout so they follow its move."""
    for rel in paths:
        if Path(rel).is_absolute() or ".." in Path(rel).parts:
            raise Stop(f"save: --keep {rel}: name a path inside the checkout, relative to it")
        path = checkout / rel
        if not path.is_file() or path.is_symlink():
            raise Stop(f"save: --keep {rel}: no regular file at {path}")
        if checkout.resolve() not in path.resolve().parents:
            raise Stop(f"save: --keep {rel}: {path} resolves outside the checkout, to {path.resolve()}")
    return list(paths)


def validate_kept_destinations(meta):
    """Run before any mutation: each kept file must still be restored inside the checkout,
    so a link planted in its path since save cannot carry the restore elsewhere."""
    root = checkout_now(meta).resolve()
    for entry in meta["kept"]:
        dest = root / entry["path"]
        if dest.is_symlink() or root not in dest.resolve().parents:
            raise Stop(f"rollback: kept {entry['path']} would be written through a link, "
                       f"to {dest.resolve()}")
        if dest.exists() and not dest.is_file():
            raise Stop(f"rollback: kept {entry['path']} is not a regular file; move it aside first")


def owned_paths(entry, old, new):
    """A records repository's owned paths, relative to its top level, sorted."""
    return sorted(([f"{old}/", f"{new}/"] if entry["rename"] else []) + [f"{p}/" for p in entry["prefixes"]])


def check_new_records_absent(top, records_root, new):
    """`<records-root>/<new>` is where `tasks rename` writes: nothing may be there, not even a
    dangling link (which `exists()` misses), and git may not still track `<new>/` in HEAD or
    the index: rollback restores the owned paths from the saved head and checks them."""
    path = records_root / new
    if path.exists() or path.is_symlink():
        raise Stop(f"save: {path} already exists")
    # The pathspec `<new>` without a slash: it matches a tracked file named <new> as well as
    # a directory's contents.
    for where, cmd in (("HEAD", ("ls-tree", "-r", "--name-only", "HEAD")), ("index", ("ls-files",))):
        if run("git", "-C", top, *cmd, "--", new).strip():
            raise Stop(f"save: {top} still tracks {new} in its {where} although {path} is absent; "
                       f"remove it from git (git rm -r --cached {new}, then commit) first")


def records_repos(checkout, repos, rows, new):
    """The records repositories of the detached snapshot projects, deduplicated, each with
    what it owns: `rename` when the checkout's records live there (`<old>/` and `<new>/`),
    and the prefix of each detached --repo whose records do. A detached --repo contributes
    only that: the cutover never writes in its code checkout. Also returns the checkout's
    `records` entry for meta.json (None in-tree), without `dirs`, which save lists once
    every check has passed. Every check here runs before the first mutation."""
    records, checkout_records = {}, None
    for root, row in rows.items():
        if row["kind"] != "detached":
            continue
        top = records_repo(row)
        for which, other in (("the checkout", checkout), *(("--repo", r) for r in repos)):
            if top == other:
                raise Stop(f"save: {row['prefix']}'s records repository is {which} {other}; "
                           f"a records repository must lie outside every snapshot repository")
            if other in top.parents:
                raise Stop(f"save: {row['prefix']}'s records repository {top} lies inside {which} {other}; "
                           f"a records repository must lie outside every snapshot repository")
        entry = records.setdefault(top, {"rename": False, "prefixes": []})
        if root == checkout:
            records_root = Path(row["records"]).resolve().parent
            check_new_records_absent(top, records_root, new)
            entry["rename"] = True
            checkout_records = {"repo": str(top), "records_root": str(records_root)}
        else:
            entry["prefixes"].append(row["prefix"])
    by_name = {}
    for top in records:
        if top.name in by_name:
            first, second = sorted((by_name[top.name], top))
            raise Stop(f"save: the records repositories {first} and {second} share the directory name "
                       f"{top.name}, which rollback labels each one's patches and copies by; rename one of "
                       f"the directories first")
        by_name[top.name] = top
    return records, checkout_records


def save(args):
    checkout, snap = Path(args.checkout).resolve(), Path(args.snapshot)
    if snap.exists():
        raise Stop(f"save: snapshot {snap} already exists")
    repos = [Path(r).resolve() for r in args.repo]
    if checkout in repos or len(set(repos)) != len(repos):
        raise Stop("save: name each --repo once, and never the checkout")
    tool = checkout / args.link_tool
    if not tool.is_file():
        raise Stop(f"save: no link tool at {tool}")
    config, state = xdg("XDG_CONFIG_HOME", ".config") / "tasks", xdg("XDG_STATE_HOME", ".local/state") / "tasks"
    for path in (config, state):
        if path.is_symlink() or not path.is_dir():
            raise Stop(f"save: {path} must be a real directory: rollback replaces it whole")
    rows = {root: project_kind(root, "save") for root in (checkout, *repos)}
    # `tasks rename` acts on whatever project --old names; it must be this checkout.
    prefix = rows[checkout]["prefix"]
    if prefix != args.old:
        raise Stop(f"save: {checkout} has the prefix {prefix!r}, not --old {args.old!r}")
    records, checkout_records = records_repos(checkout, repos, rows, args.new)
    worktrees = checkout / ".worktrees"
    link_text = os.readlink(worktrees) if worktrees.is_symlink() else None
    storage_old = (checkout / link_text).resolve() if link_text else None
    protected = {"checkout": checkout, "config": config, "state": state,
                 **{f"repo {root}": root for root in repos}}
    if storage_old:
        protected["storage_old"] = storage_old
    protected |= {f"records repository {top}": top for top in records}
    snap_resolved = snap.resolve()
    for which, path in protected.items():
        path = path.resolve()
        if snap_resolved == path or path in snap_resolved.parents:
            raise Stop(f"save: snapshot {snap} lies inside {which}")
    kept = kept_paths(checkout, args.keep)
    preconditions(checkout, rows, records, args.old, tool)
    new_root = Path(args.new_root)
    new_root = new_root.parent.resolve() / new_root.name
    # work-link names a checkout's storage after the checkout's directory, not its prefix.
    storage_new = storage_old.parent.parent / new_root.name / storage_old.name if storage_old else None
    if checkout_records:
        # Rollback recreates each, so <old>/'s empty docs/specs and docs/plans come back.
        repo = Path(checkout_records["repo"])
        checkout_records["dirs"] = sorted(str(d.relative_to(repo)) for d in (repo / args.old).rglob("*")
                                          if d.is_dir() and not d.is_symlink())
    meta = {
        "checkout": {**record(checkout), "records": checkout_records},
        "repos": [{**record(root), "kind": rows[root]["kind"]} for root in repos],
        "records_repos": [{**record(top), "owned": owned_paths(entry, args.old, args.new)}
                          for top, entry in records.items()],
        "new_root": str(new_root), "old": args.old, "new": args.new, "link_tool": args.link_tool,
        "home": str(Path.home()), "config": str(config), "state": str(state),
        "worktrees_link": link_text,
        "storage_old": str(storage_old) if storage_old else None,
        "storage_new": str(storage_new) if storage_new else None,
        "kept": [{"path": rel, "mode": stat.S_IMODE((checkout / rel).stat().st_mode)} for rel in kept],
    }
    snap.mkdir(parents=True, exist_ok=False)
    shutil.copytree(config, snap / "config", symlinks=True)
    shutil.copytree(state, snap / "state", symlinks=True)
    (snap / "links.txt").write_text(link_report(tool))
    for n, rel in enumerate(kept):
        (snap / "kept").mkdir(exist_ok=True)
        shutil.copy2(checkout / rel, snap / "kept" / str(n))
    shutil.copy2(Path(__file__).resolve(), snap / "rename-cutover")
    (snap / "meta.json").write_text(json.dumps(meta, indent=2) + "\n")
    print(f"saved {snap}")


REGISTRY_TABLES = ("projects", "aliases", "groups", "locations", "records")


def registry_view(path, old, new):
    """The registry as the guard compares it: the renamed project's own entries removed,
    and the rename's own rewrites of other entries read the same on both sides.
    `tasks rename` retargets an alias that named the old prefix (`ai = "tack"` becomes
    `ai = "hq"`) and rewrites a group member from the old prefix to the new; reading the
    old prefix as the new one makes exactly those equal. Every other difference remains,
    except the order of a group's members: tasks keeps them sorted and re-sorts on the
    rewrite, so both sides are compared sorted. The renamed project's location history,
    `[locations.<old>]` before and `[locations.<new>]` after, is its own as well: `tasks
    rename` moves the table and `tasks init --force` appends the displaced root. So is a
    detached project's `[records]` key, which `tasks rename` moves with the prefix."""
    data = tomllib.loads(path.read_text()) if path.exists() else {}

    def renamed(prefix):
        return new if prefix == old else prefix

    projects = {k: v for k, v in data.get("projects", {}).items() if k not in (old, new)}
    aliases = {k: renamed(v) for k, v in data.get("aliases", {}).items() if k not in (old, new)}
    groups = {k: sorted(renamed(m) for m in members) for k, members in data.get("groups", {}).items()}
    locations = {k: v for k, v in data.get("locations", {}).items() if k not in (old, new)}
    records = {k: v for k, v in data.get("records", {}).items() if k not in (old, new)}
    rest = {k: v for k, v in data.items() if k not in REGISTRY_TABLES}
    return {**rest, "projects": projects, "aliases": aliases, "groups": groups, "locations": locations,
            "records": records}


def registry_changes(live, saved):
    """The names of the entries that differ, for the guard's message."""
    tables = REGISTRY_TABLES
    names = {k for k in (live.keys() | saved.keys()) - set(tables) if live.get(k) != saved.get(k)}
    for table in tables:
        names |= {f"{table}.{k}" for k in live[table].keys() | saved[table].keys()
                  if live[table].get(k) != saved[table].get(k)}
    return sorted(names)


def files(root, skip):
    return {str(p.relative_to(root)) for p in root.rglob("*") if p.is_file()} - skip


def validate_inventory(path, meta):
    """An interrupted `tasks rename` leaves rename/<old>.toml. It belongs to this cutover
    only when its source, target and root are exactly this rename's."""
    try:
        data = tomllib.loads(path.read_text())
    except tomllib.TOMLDecodeError as error:
        raise Stop(f"guard: {path} is not a readable rename inventory: {error}")
    expected = {"source": meta["old"], "target": meta["new"], "root": meta["checkout"]["root"]}
    for key, value in expected.items():
        found = data.get(key)
        same = found is not None and (Path(found).resolve() == Path(value).resolve() if key == "root" else found == value)
        if not same:
            raise Stop(f"guard: {path} is a rename inventory for {key} {found!r}, not {value!r}")


def claims_tolerated(path, live_root, saved_root):
    """A `tasks` command against a project this cutover does not own can create empty
    claims/<prefix>.{toml,lock} files. An empty claims file records no claim, so it is
    not a foreign change: tolerate it when the live copy is empty and the saved copy is
    absent or also empty. A non-empty file is a real claim and must still stop the guard."""
    if not path.startswith("claims/"):
        return False
    live = live_root / path
    if not (live.exists() and live.stat().st_size == 0):
        return False
    saved = saved_root / path
    return not saved.exists() or saved.stat().st_size == 0


def guard(meta, snap):
    old, new = meta["old"], meta["new"]
    config, state = Path(meta["config"]), Path(meta["state"])
    live = registry_view(config / "projects.toml", old, new)
    saved = registry_view(snap / "config" / "projects.toml", old, new)
    if live != saved:
        raise Stop(f"guard: the registry changed outside {old}/{new}: {', '.join(registry_changes(live, saved))}")
    own = {f"claims/{p}.{ext}" for p in (old, new) for ext in ("toml", "lock")}
    inventory = state / "rename" / f"{old}.toml"
    if inventory.exists():
        validate_inventory(inventory, meta)
        own.add(f"rename/{old}.toml")
    for live_root, saved_root, skip in ((config, snap / "config", {"projects.toml", "projects.lock"}),
                                        (state, snap / "state", own)):
        live_files, saved_files = files(live_root, skip), files(saved_root, skip)
        changed = sorted(
            f for f in live_files ^ saved_files
            if not claims_tolerated(f, live_root, saved_root)) + sorted(
            f for f in live_files & saved_files
            if not f.endswith(".lock") and not filecmp.cmp(live_root / f, saved_root / f, shallow=False))
        if changed:
            raise Stop(f"guard: {live_root} changed outside {old}/{new}: {', '.join(changed)}")


def move_back(meta):
    """Move the checkout (and its worktree storage) back to their pre-rename paths.

    Each pair — (checkout, new_root) and, when there is one, (storage_old, storage_new) —
    must have exactly one side present; both or neither is an ambiguous state a person
    must resolve. Every check for both pairs, and for a real file/dir blocking the managed
    link, runs before either pair is touched."""
    checkout, new_root = Path(meta["checkout"]["root"]), Path(meta["new_root"])
    checkout_present, new_root_present = checkout.exists(), new_root.exists()
    if checkout_present and new_root_present:
        raise Stop(f"move back: both {checkout} and {new_root} exist")
    if not checkout_present and not new_root_present:
        raise Stop(f"move back: neither {checkout} nor {new_root} exists")
    move_checkout = new_root_present

    move_storage = False
    s_old = s_new = None
    if meta["storage_old"]:
        s_old, s_new = Path(meta["storage_old"]).parent, Path(meta["storage_new"]).parent
        old_present, new_present = s_old.exists(), s_new.exists()
        if old_present and new_present:
            raise Stop(f"move back: both {s_old} and {s_new} exist")
        if not old_present and not new_present:
            raise Stop(f"move back: neither {s_old} nor {s_new} exists")
        move_storage = new_present
        link = (new_root if move_checkout else checkout) / ".worktrees"
        if link.exists() and not link.is_symlink():
            raise Stop(f"move back: {link} is not a link")

    if move_checkout:
        os.rename(new_root, checkout)
    if meta["storage_old"]:
        if move_storage:
            os.rename(s_new, s_old)
        link = checkout / ".worktrees"
        if link.is_symlink():
            link.unlink()
        link.symlink_to(meta["worktrees_link"])


def leftover_original(path, old, new):
    """The pre-rename path a rename leftover replaces, or None. `tasks rename` writes
    tasks/<new>-<hex>.md and moves the task's attachments folder to tasks/files/<new>-<hex>/."""
    parts = Path(path).parts
    if len(parts) == 2 and parts[0] == "tasks" and parts[1].startswith(f"{new}-"):
        return f"tasks/{old}-{parts[1][len(new) + 1:]}"
    if len(parts) >= 4 and parts[:2] == ("tasks", "files") and parts[2].startswith(f"{new}-"):
        return "/".join(("tasks", "files", f"{old}-{parts[2][len(new) + 1:]}", *parts[3:]))
    return None


def remove_leftovers(checkout, leftovers):
    """Delete each validated leftover, then the attachment folders that emptied: an empty
    tasks/files/<new>-<hex>/ would be an orphan to rollback's final tasks check."""
    files = checkout / "tasks" / "files"
    for path in leftovers:
        (checkout / path).unlink()
    for path in leftovers:
        folder = (checkout / path).parent
        while files in folder.parents and folder.is_dir() and not any(folder.iterdir()):
            folder.rmdir()
            folder = folder.parent


def validate_leftovers(meta):
    """The foreign-untracked check, run before any mutation: whichever checkout path
    exists may only have rename leftovers untracked — each a renamed record or attachment
    (leftover_original) with its pre-rename original present at the saved head — and no other repository may
    have any. Returns the validated paths so the caller can delete them after the reset
    without listing again."""
    old, new, head = meta["old"], meta["new"], meta["checkout"]["head"]
    checkout = checkout_now(meta)
    untracked = run("git", "-C", checkout, "ls-files", "--others", "--exclude-standard").splitlines()
    for path in untracked:
        original = leftover_original(path, old, new)
        if original is None:
            raise Stop(f"leftovers: {path} is not a rename leftover")
        check = subprocess.run(["git", "-C", str(checkout), "cat-file", "-e", f"{head}:{original}"],
                               capture_output=True)
        if check.returncode != 0:
            raise Stop(f"leftovers: {path} has no restored original {original}")
    for repo in in_tree_repos(meta):
        if run("git", "-C", repo["root"], "ls-files", "--others", "--exclude-standard").strip():
            raise Stop(f"leftovers: {repo['root']} has untracked files")
    return untracked


def renames_records(meta, entry):
    """Whether this records repository holds the renamed checkout's records (`<old>/` and
    `<new>/`), not only the `<p>/` of detached --repo projects."""
    records = meta["checkout"]["records"]
    return records is not None and records["repo"] == entry["root"]


def git_files(root, where, paths):
    """The files under `paths` that `where` holds: the index, or a commit's tree."""
    if not paths:
        return set()
    if where == "index":
        out = run("git", "-C", root, "ls-files", "-z", "--", *paths)
    else:
        out = run("git", "-C", root, "ls-tree", "-r", "-z", "--name-only", where, "--", *paths)
    return set(filter(None, out.split("\0")))


def holds(root, where, path):
    return bool(git_files(root, where, [path]))


def unreadable(error):
    raise Stop(f"rollback: cannot read the directory {error.filename} ({error.strerror}); make it readable "
               f"or move it aside first")


def files_on_disk(directory):
    """Every file under `directory`, ignored or not, a link counted as a file and never
    followed; empty when the directory is absent. A directory it cannot read stops it."""
    if not Path(directory).exists():
        return []
    found = []
    for parent, dirs, names in os.walk(directory, onerror=unreadable):
        parent = Path(parent)
        for name in list(dirs):
            if (parent / name).is_symlink():
                dirs.remove(name)
                names.append(name)
        found += [parent / name for name in names]
    return found


def check_owned_directory(root, name):
    """An owned directory is absent or a real directory: through a link the walk, the
    restore and the deletion of `<new>/` would reach elsewhere, and a file there cannot be
    walked or deleted as one."""
    path = Path(root) / name
    if path.is_symlink():
        raise Stop(f"rollback: {root}: {name} is a link; move it aside first")
    if path.exists() and not path.is_dir():
        raise Stop(f"rollback: {root}: {name} is not a directory; move it aside first")


def validate_records_repos(meta):
    """The walk, run before any mutation, in each records repository that holds the renamed
    checkout's records. Every file on disk under `<old>/` and `<new>/` (ignored files
    included) that none of the index, the current HEAD and the saved head holds must be a
    rename leftover. A file at a path one of them holds is left out: it is an original the
    restore puts back, a tracked change the patch holds, or one an earlier attempt's
    restore staged, which is what lets a retry pass. Under `<new>/`, `<new>/<rest>` maps to
    `<old>/<rest>` with the id mapping applied, or to `<old>/<rest>` itself; under `<old>/`,
    only the id mapping applies (a rename that stopped before it moved the directory). The
    original must be at the saved head. Any other file stops rollback, naming it. First,
    in every records repository, each owned path must be a real directory or absent.
    Returns each repository's leftovers, relative to its top level."""
    old, new = meta["old"], meta["new"]
    found = {}
    for entry in meta["records_repos"]:
        for path in entry["owned"]:
            check_owned_directory(entry["root"], path.rstrip("/"))
        if not renames_records(meta, entry):
            continue
        root, paths = Path(entry["root"]), [f"{old}/", f"{new}/"]
        known = git_files(root, "index", paths) | git_files(root, "HEAD", paths)
        saved = git_files(root, entry["head"], paths)
        known |= saved
        leftovers = []
        for path in sorted(str(p.relative_to(root)) for name in (old, new) for p in files_on_disk(root / name)):
            if path in known:
                continue
            top, rest = path.split("/", 1)
            mapped = leftover_original(rest, old, new)
            if top == new and mapped is None:
                mapped = rest
            if mapped is None:
                raise Stop(f"rollback: {root}: {path} is not a rename leftover; move it aside first")
            original = f"{old}/{mapped}"
            if original not in saved:
                raise Stop(f"rollback: {root}: {path} is not a rename leftover: the saved head has no "
                           f"{original}; move it aside first")
            leftovers.append(path)
        found[entry["root"]] = leftovers
    return found


def saved_blobs(root, head, paths):
    """Each file under `paths` at the commit `head`: its path mapped to (mode, blob)."""
    out = run("git", "-C", root, "ls-tree", "-r", "-z", head, "--", *paths)
    blobs = {}
    for line in filter(None, out.split("\0")):
        info, path = line.split("\t", 1)
        mode, _, blob = info.split()
        blobs[path] = (mode, blob)
    return blobs


def same_as_saved(root, path, saved):
    """Whether the file at `path` has the bytes of its saved blob (a link: its target, and
    the saved entry a link too). A file the saved head lacks is never the same."""
    if saved is None:
        return False
    mode, blob = saved
    path = Path(path)
    try:
        if path.is_symlink():
            if mode != "120000":
                return False
            data = os.fsencode(os.readlink(path))
        else:
            if mode == "120000":
                return False
            data = path.read_bytes()
    except OSError as error:
        raise Stop(f"rollback: cannot read {path}: {error.strerror}; make it readable or move it aside first")
    shown = subprocess.run(["git", "-C", str(root), "cat-file", "blob", blob], capture_output=True)
    if shown.returncode != 0:
        raise Stop(f"git -C {root} cat-file blob {blob}: {shown.stderr.decode(errors='replace').strip()}")
    return data == shown.stdout


def differing_files(meta, leftovers):
    """Step 2's other copies, found before any mutation: in each records repository, every
    file on disk under an owned path, `<p>/` included and ignored files too, that is not in
    the index and whose bytes differ from the saved head's blob at its path (absent counting
    as different), unless it is a leftover. The restore or the deletion of `<new>/` would
    remove it, and the patch, a diff of tracked content, does not hold it: a file recreated
    under `<old>/` after the rename's commit, or, on a retry after an earlier restore dropped
    `<new>/` from the index, a file at a path only the current HEAD holds. Returns each
    repository's files, relative to its top level."""
    found = {}
    for entry in meta["records_repos"]:
        root, owned = Path(entry["root"]), entry["owned"]
        skip = git_files(root, "index", owned) | set(leftovers.get(entry["root"], ()))
        saved = saved_blobs(root, entry["head"], owned)
        differ = []
        for name in owned:
            for path in files_on_disk(root / name.rstrip("/")):
                rel = str(path.relative_to(root))
                if rel not in skip and not same_as_saved(root, path, saved.get(rel)):
                    differ.append(rel)
        found[entry["root"]] = sorted(differ)
    return found


def records_label(entry):
    return f"records-{Path(entry['root']).name}"


def restore_dir(saved, live):
    shutil.rmtree(live)
    shutil.copytree(saved, live, symlinks=True)


def save_reset_patch(root, head, snap, label, paths=()):
    """`git reset --hard` is destructive; keep whatever it would discard as a patch. Given
    `paths` (a records repository's owned paths), only what restoring them discards.

    Covers commits made since save plus any working-tree edits, since diffing the
    working tree against the saved head captures both. Never overwrites an earlier
    patch: a rollback stopped and retried writes the next unused rollback-<label>-<n>.patch."""
    diff = run("git", "-C", root, "diff", "--binary", head, *(("--", *paths) if paths else ()))
    n = 1
    while (path := snap / f"rollback-{label}-{n}.patch").exists():
        n += 1
    path.write_text(diff)
    if diff.strip():
        print(f"rename-cutover: {'restore' if paths else 'reset'} {root}: changes since save kept in {path}",
              file=sys.stderr)


def leftovers_dir(snap):
    """This attempt's rollback-leftovers-<n>/, the next unused number: a retry never writes
    into an earlier attempt's copies."""
    n = 1
    while (path := snap / f"rollback-leftovers-{n}").exists():
        n += 1
    return path


def copy_leftovers(dest, copies):
    """Copy each leftover, as bytes and mode (a link as a link), to <dest>/<label>/<path>.
    `dest` is created here, never reused: an existing one stops the copy."""
    if not any(paths for _, _, paths in copies):
        return
    try:
        dest.mkdir()
    except FileExistsError:
        raise Stop(f"rollback: {dest} already exists, taken by another rollback since this one chose it; "
                   f"nothing was reset or restored, so rerun rollback")
    for label, root, paths in copies:
        for path in paths:
            source, target = Path(root) / path, dest / label / path
            try:
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(source, target, follow_symlinks=False)
            except OSError as error:
                raise Stop(f"rollback: cannot copy {source} to {target}: {error}; nothing was reset or "
                           f"restored; clear the cause, then rerun rollback")
    print(f"rename-cutover: leftovers kept in {dest}", file=sys.stderr)


def reset_all(resets, snap, records=(), copies=()):
    """Keep everything rollback discards before discarding any: every reset repository's
    patch, each records repository's patch of its owned paths, and a copy of each validated
    leftover and each differing file, `copies` holding (label, root, paths). A patch or
    copy that cannot be written stops rollback before the first reset or restore, not
    between two. The leftovers directory is chosen once, before anything is written."""
    dest = leftovers_dir(snap)
    for root, head, label in resets:
        save_reset_patch(root, head, snap, label)
    for entry in records:
        save_reset_patch(entry["root"], entry["head"], snap, records_label(entry), entry["owned"])
    copy_leftovers(dest, copies)
    for root, head, _ in resets:
        run("git", "-C", root, "reset", "-q", "--hard", head)


def prune_empty(directory, stop):
    """Remove `directory` and each parent it leaves empty, up to but not including `stop`."""
    while stop in directory.parents and directory.is_dir() and not any(directory.iterdir()):
        directory.rmdir()
        directory = directory.parent


def restore_records(meta, leftovers):
    """Each records repository's owned paths back to the saved head. `git restore` matches a
    pathspec only against its source and the index and fails on one it cannot match, so it
    is given the owned paths the index or the saved head holds; it removes tracked files the
    saved head lacks and overwrites uncommitted changes, which the patch holds. Any git
    failure stops rollback here. Then, where the renamed checkout's records live: `<new>/`
    is deleted whole (what is left there is untracked and was validated), the leftovers
    under `<old>/` and the directories they emptied are deleted, and every directory save
    listed under `<old>/` is recreated, empty ones included."""
    old, new = meta["old"], meta["new"]
    for entry in meta["records_repos"]:
        root = Path(entry["root"])
        paths = [p for p in entry["owned"] if holds(root, "index", p) or holds(root, entry["head"], p)]
        if paths:
            run("git", "-C", root, "restore", f"--source={entry['head']}", "--staged", "--worktree", "--", *paths)
        if not renames_records(meta, entry):
            continue
        if (root / new).exists():
            shutil.rmtree(root / new)
        under_old = [path for path in leftovers[entry["root"]] if path.startswith(f"{old}/")]
        for path in under_old:
            (root / path).unlink()
        for path in under_old:
            prune_empty((root / path).parent, root / old)
        for directory in meta["checkout"]["records"]["dirs"]:
            (root / directory).mkdir(parents=True, exist_ok=True)


def commit_records(meta):
    """Commit each records repository whose owned content differs from HEAD, after the
    registry is restored so that the repository's hook (`tasks check` for each staged
    prefix) sees the old prefix registered. The pathspec keeps any other project's staged
    change out and names only the owned paths the index or the current HEAD holds: a
    pathspec git does not know fails the commit."""
    for entry in meta["records_repos"]:
        root = entry["root"]
        paths = [p for p in entry["owned"] if holds(root, "index", p) or holds(root, "HEAD", p)]
        if not paths:
            continue
        same = subprocess.run(["git", "-C", root, "diff", "--quiet", "HEAD", "--", *paths], capture_output=True,
                              text=True)
        if same.returncode == 0:
            continue
        if same.returncode != 1:
            raise Stop(f"git -C {root} diff --quiet HEAD: {same.stderr.strip()}")
        run("git", "-C", root, "commit", "-q", "-m", f"revert: roll back rename {meta['old']} -> {meta['new']}",
            "--", *paths)


def check_records(meta):
    """After rollback, in each records repository: `<new>` absent where the renamed
    checkout's records live, no tracked change under the owned paths, and the owned paths
    equal to the saved head."""
    for entry in meta["records_repos"]:
        root, owned = Path(entry["root"]), entry["owned"]
        new = root / meta["new"]
        if renames_records(meta, entry) and (new.exists() or new.is_symlink()):
            raise Stop(f"check: {new} still exists")
        changes = run("git", "-C", root, "status", "--porcelain", "--untracked-files=no", "--", *owned)
        if changes.strip():
            raise Stop(f"check: {root} has uncommitted changes under {', '.join(owned)}: "
                       f"{', '.join(line.strip() for line in changes.splitlines())}")
        same = subprocess.run(["git", "-C", str(root), "diff", "--quiet", entry["head"], "--", *owned],
                              capture_output=True, text=True)
        if same.returncode != 0:
            raise Stop(f"check: {root} differs from the saved head {entry['head'][:7]} under {', '.join(owned)}"
                       + (f": {same.stderr.strip()}" if same.returncode != 1 else ""))


def restore_kept(checkout, snap, meta):
    """Copy each kept file back as it was saved, mode included. Run after the reset,
    which leaves an ignored file alone and rewrites a filtered one only when it sees a
    change, so neither can be trusted to have restored it."""
    for n, entry in enumerate(meta["kept"]):
        live = checkout / entry["path"]
        live.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(snap / "kept" / str(n), live)
        os.chmod(live, entry["mode"])


def refresh_kept(checkout, meta):
    """A filtered file whose size differs from its index entry shows as modified until
    the entry is refreshed, even when its filtered content is unchanged. Stage each kept
    file that is tracked and filtered-equal, as harness-state-refresh does: that writes
    the blob already in the index. A real change is left for the clean check to report."""
    for entry in meta["kept"]:
        path = entry["path"]
        tracked = subprocess.run(["git", "-C", str(checkout), "ls-files", "--error-unmatch", "--", path],
                                 capture_output=True).returncode == 0
        if tracked and subprocess.run(["git", "-C", str(checkout), "diff", "--quiet", "--", path]).returncode == 0:
            run("git", "-C", checkout, "add", "--", path)


def check_kept(checkout, snap, meta):
    for n, entry in enumerate(meta["kept"]):
        live = checkout / entry["path"]
        if not filecmp.cmp(live, snap / "kept" / str(n), shallow=False):
            raise Stop(f"check: {live} differs from its saved copy")
        if stat.S_IMODE(live.stat().st_mode) != entry["mode"]:
            raise Stop(f"check: {live} has mode {stat.S_IMODE(live.stat().st_mode):o}, "
                       f"saved {entry['mode']:o}")


def rollback(args):
    snap = Path(args.snapshot)
    meta = load_meta(snap)
    check_environment("rollback", meta)
    forward = snap / "forward.json"
    if forward.exists():
        try:
            roots = json.loads(forward.read_text())
        except json.JSONDecodeError as error:
            raise Stop(f"rollback: {forward} exists but is unreadable ({error}); rollback has ended")
        raise Stop("rollback: ended when retarget --forward first wrote outside the snapshot: "
                   + ", ".join(roots))
    guard(meta, snap)
    check_branches(meta)
    leftovers = validate_leftovers(meta)
    validate_kept_destinations(meta)
    records_leftovers = validate_records_repos(meta)
    differing = differing_files(meta, records_leftovers)
    move_back(meta)
    checkout = Path(meta["checkout"]["root"])
    resets = [(checkout, meta["checkout"]["head"], "checkout")]
    resets += [(Path(r["root"]), r["head"], Path(r["root"]).name) for r in in_tree_repos(meta)]
    # The in-tree leftovers were validated where the checkout was; move_back only renamed
    # it, so they are read at its old path.
    copies = [("checkout", checkout, leftovers)]
    copies += [(records_label(e), e["root"], sorted(records_leftovers.get(e["root"], []) + differing[e["root"]]))
               for e in meta["records_repos"]]
    reset_all(resets, snap, meta["records_repos"], copies)
    restore_records(meta, records_leftovers)
    remove_leftovers(checkout, leftovers)
    restore_kept(checkout, snap, meta)
    refresh_kept(checkout, meta)
    restore_dir(snap / "config", Path(meta["config"]))
    restore_dir(snap / "state", Path(meta["state"]))
    commit_records(meta)
    tool = link_tool(checkout, meta)
    run(tool, "--apply")
    if link_report(tool) != (snap / "links.txt").read_text():
        raise Stop("links: the fresh report differs from the saved one")
    for root, _, _ in resets:
        if run("tasks", "check", cwd=root).strip():
            raise Stop(f"check: tasks check reports findings in {root}")
        if porcelain(root):
            raise Stop(f"check: {root} is not clean")
    for repo in meta["repos"]:
        if repo["kind"] == "detached" and run("tasks", "check", cwd=repo["root"]).strip():
            raise Stop(f"check: tasks check reports findings in {repo['root']}")
    check_records(meta)
    check_kept(checkout, snap, meta)
    print("rolled back to " + ", ".join([f"{head[:7]} ({label})" for _, head, label in resets]
                                        + [f"{e['head'][:7]} ({records_label(e)})" for e in meta["records_repos"]]))


RETIRED_PREFIX_RE = re.compile(
    r'^depends on (?P<old_id>\S+) through retired prefix "(?P<prefix>[^"]*)"; it is now (?P<new_id>\S+)$')


def dependency_rewrites(root, old):
    """After `tasks init --prefix <new> --force`, a task elsewhere that depends on an
    old-prefix id still names it, and `tasks check` there reports each as a
    `retired_prefix` warning. Each warning through `old` (and no other rename's) maps the
    task's old id to the id the warning names as canonical. Returns each task's whole
    new dependency list, in order, read and validated before anything is written; a
    check that fails stops here, naming the repository."""
    try:
        output = run("tasks", "check", cwd=root)
    except Stop as error:
        raise Stop(f"retarget: tasks check fails in {root}: {error}")
    report = json.loads(output) if output.strip() else {"warnings": []}
    replacements = {}
    for warning in report.get("warnings", []):
        if warning.get("kind") != "retired_prefix":
            continue
        match = RETIRED_PREFIX_RE.match(warning.get("detail", ""))
        if not match:
            raise Stop(f"retarget: unparseable retired_prefix warning for {warning.get('id')}: "
                       f"{warning.get('detail')!r}")
        if match["prefix"] == old:
            replacements.setdefault(warning["id"], {})[match["old_id"]] = match["new_id"]
    rewrites = {}
    for task, pairs in replacements.items():
        try:
            depends = json.loads(run("tasks", "show", task, cwd=root))["task"].get("depends", [])
        except Stop as error:
            raise Stop(f"retarget: reading {task} fails in {root}: {error}")
        missing = sorted(set(pairs) - set(depends))
        if missing:
            raise Stop(f"retarget: {task} does not list {', '.join(missing)}")
        rewrites[task] = (pairs, [pairs.get(dep, dep) for dep in depends])
    return rewrites


def write_rewrites(root, rewrites, check=None):
    """Each task's whole list in one `tasks edit` save, its old ids replaced in place.
    Removing and re-adding in two writes would lose the dependency if interrupted between
    them, and a rerun would not see it again. A rerun reads the warnings left. `check`,
    when given, judges each edit's output before the next edit runs."""
    for task, (pairs, depends) in rewrites.items():
        output = run("tasks", "edit", task, "--no-depends",
                     *(arg for dep in depends for arg in ("--depends", dep)), cwd=root)
        for old_id, new_id in pairs.items():
            print(f"retarget: {task}: {old_id} -> {new_id}")
        if check:
            check(task, output)


# tasks names every record commit it did not make with a `commit_` warning:
# `commit_deferred:`, `commit_failed:` and `commit_unavailable:` (the records directory is
# not in a git repository, or git is missing), each followed by what it left uncommitted.
UNCOMMITTED = "commit_"


def committed_check(root):
    """A snapshot repository's edit must commit: a detached project's record commit is
    deferred while anything is staged in its records repository (which can happen after
    save) and fails when the hook refuses it; tasks cannot commit at all outside a git
    repository. Each would leave the record uncommitted for verify to find later, so any
    `commit_` warning stops the retarget here, naming it. Output that is not tasks' JSON
    report, or a warning that is not a string, is a stop too, never read as "no warnings"."""
    def check(task, output):
        try:
            report = json.loads(output)
        except json.JSONDecodeError as error:
            raise Stop(f"retarget: tasks edit {task} in {root} printed output that is not JSON ({error}): "
                       f"{output!r}; no further task was edited")
        warnings = report.get("warnings") if isinstance(report, dict) else None
        if not isinstance(warnings, list):
            raise Stop(f"retarget: tasks edit {task} in {root} printed no warnings list: {output!r}; "
                       f"no further task was edited")
        for warning in warnings:
            if not isinstance(warning, str):
                raise Stop(f"retarget: tasks edit {task} in {root} printed a warning that is not a string: "
                           f"{warning!r}; no further task was edited")
            if warning.startswith(UNCOMMITTED):
                raise Stop(f"retarget: tasks edit {task} in {root} left its record uncommitted: {warning}; "
                           f"no further task was edited; clear the cause, run `tasks commit` there, "
                           f"then rerun retarget --repo")
    return check


def retarget_dependencies(root, old):
    """Retarget one snapshot repository, so its `tasks check` comes back clean (`verify`
    requires that), each edit's record commit checked before the next edit."""
    write_rewrites(root, dependency_rewrites(root, old), committed_check(root))


def apply(args):
    snap = Path(args.snapshot)
    meta = load_meta(snap)
    check_environment("apply", meta)
    checkout, new_root, old, new = Path(meta["checkout"]["root"]), Path(meta["new_root"]), meta["old"], meta["new"]
    if new_root.exists():
        raise Stop(f"apply: {new_root} already exists")
    if meta["storage_new"] and Path(meta["storage_new"]).parent.exists():
        raise Stop(f"apply: {Path(meta['storage_new']).parent} already exists")
    records = meta["checkout"]["records"]
    if records:
        new_records, old_records = Path(records["records_root"]) / new, Path(records["records_root"]) / old
        if (new_records.exists() or new_records.is_symlink()) and not (old_records.exists() or old_records.is_symlink()):
            # save found <old> there and <new> absent: only tasks rename moves the one to the other.
            raise Stop(f"apply: {new_records} already exists and {old_records} is gone: an earlier apply "
                       f"stopped after tasks rename moved {old}'s records there; they are the rename's, so do "
                       f"not move them aside: run rollback, then apply again")
        if new_records.exists() or new_records.is_symlink():
            raise Stop(f"apply: {new_records} already exists; tasks rename writes {new}'s records there, "
                       f"so move it aside first")
    run("tasks", "rename", old, new, cwd=checkout)
    os.rename(checkout, new_root)
    if meta["storage_old"]:
        os.rename(Path(meta["storage_old"]).parent, Path(meta["storage_new"]).parent)
        (new_root / ".worktrees").unlink()
        run("work-link", "--root", new_root.parent, "--ensure", ".worktrees", cwd=new_root)
    if records:
        run("tasks", "init", "--prefix", new, "--records", records["records_root"], "--force", cwd=new_root)
    else:
        run("tasks", "init", "--prefix", new, "--force", cwd=new_root)
    print(f"applied: {old} -> {new} at {new_root}")
    if records:
        # Scoped to the rename's own paths, so another project's untracked draft stays out.
        repo, message = shlex.quote(records["repo"]), shlex.quote(f"chore(tasks): rename {old} -> {new}")
        print(f"commit the rename in the records repository {records['repo']} before retarget --repo:")
        print(f"  git -C {repo} add -A -- {old} {new} && git -C {repo} commit -m {message} -- {old} {new}")


def record_forward(snap, root):
    """Rollback could not restore a repository written outside the snapshot, so the
    first such write ends it. This record, made before the write, is what it refuses on."""
    path = snap / "forward.json"
    roots = json.loads(path.read_text()) if path.exists() else []
    if str(root) not in roots:
        path.write_text(json.dumps([*roots, str(root)], indent=2) + "\n")


def forward_roots(meta):
    """Every registered project outside the snapshot's repositories and the renamed
    checkout, with whether it is retired. One that is unreachable is named and not
    checked: its records cannot be read."""
    inside = {Path(r["root"]).resolve() for r in meta["repos"]}
    inside |= {Path(meta["new_root"]).resolve(), Path(meta["checkout"]["root"]).resolve()}
    roots = []
    for project in json.loads(run("tasks", "projects", "--json"))["projects"]:
        root = Path(project["root"]).resolve()
        if root in inside:
            continue
        if not project["reachable"]:
            print(f"retarget: {project['prefix']} is unreachable at {project['root']}; not checked")
        else:
            roots.append((project["prefix"], project["root"], root,
                          project.get("retired") is not None))   # omitted when unset
    return roots


def retarget_forward(snap, meta):
    """Every project outside the snapshot, selected here: each is checked and its rewrites
    read before anything is written, so a failing check stops the run with nothing
    changed. A retired project refuses writes, so one that needs a rewrite stops the run
    too. A project is recorded in forward.json just before its first write, and only when
    it has one."""
    found = []
    for prefix, shown, root, retired in forward_roots(meta):
        rewrites = dependency_rewrites(root, meta["old"])
        if retired and rewrites:
            raise Stop(f"retarget: {prefix} is retired at {shown} and depends on retired ids in "
                       f"{', '.join(rewrites)}; unretire it to retarget them")
        if retired:
            print(f"retarget: {prefix} is retired at {shown}; nothing to retarget")
        elif rewrites:
            found.append((root, rewrites))
    if not found:
        print("retarget: nothing to retarget outside the snapshot")
    for root, rewrites in found:
        record_forward(snap, root)
        write_rewrites(root, rewrites)
        print(f"retargeted in {root}")


def retarget(args):
    """`--repo`: one snapshot repository's retarget, run by the runbook before that
    repository's commit. A repository outside the snapshot is refused: rollback could not
    restore it. After the other host has adopted, rollback is over, and `--forward`
    retargets every project outside the snapshot and records that rollback has ended."""
    snap = Path(args.snapshot)
    meta = load_meta(snap)
    check_environment("retarget", meta)
    if args.forward:
        retarget_forward(snap, meta)
        return
    root = Path(args.repo).resolve()
    if root in (Path(meta["new_root"]), Path(meta["checkout"]["root"])):
        raise Stop(f"retarget: {root} is the renamed checkout; its own ids were renamed, not retargeted")
    if str(root) not in {r["root"] for r in meta["repos"]}:
        raise Stop(f"retarget: {root} is not in the snapshot; after the other host has adopted, "
                   f"retarget --forward selects the projects outside it")
    retarget_dependencies(root, meta["old"])


def link(args):
    meta = load_meta(args.snapshot)
    check_environment("link", meta)
    new_root = Path(meta["new_root"])
    if not new_root.exists():
        raise Stop(f"link: {new_root} does not exist; run apply first")
    run(link_tool(new_root, meta), "--apply")
    print(f"linked from {new_root}")


def sample_task(records, new):
    """One task under the new prefix, whose old-prefix id verify resolves through the alias."""
    found = next((p.stem for p in (Path(records) / "tasks").glob(f"{new}-*.md")), None)
    if found is None:
        raise Stop(f"verify: no {new}-*.md task under {Path(records) / 'tasks'} to resolve through the alias")
    return found.split("-", 1)[1]


def verify_records(meta):
    """A detached checkout's row names the new root and `<records-root>/<new>`, and
    `<records-root>/<old>` is gone. In every records repository the owned paths hold no
    uncommitted change (`<old>/` and `<new>/` no untracked file either): the rename and the
    retargets were committed, so the other host's sync carries a committed state."""
    old, new, new_root = meta["old"], meta["new"], Path(meta["new_root"])
    records = meta["checkout"]["records"]
    if records:
        records_root = Path(records["records_root"])
        row = project_row(new_root, "verify")
        found = {"kind": row.get("kind"), "checkout": Path(row["checkout"]).resolve() if row.get("checkout") else None,
                 "records": Path(row["records"]).resolve()}
        expected = {"kind": "detached", "checkout": new_root.resolve(), "records": (records_root / new).resolve()}
        wrong = [f"{key} is {found[key]}, expected {expected[key]}" for key in expected if found[key] != expected[key]]
        if wrong:
            raise Stop(f"verify: tasks projects' row for {new} at {new_root} does not match the rename: "
                       + "; ".join(wrong))
        old_records = records_root / old
        if old_records.exists() or old_records.is_symlink():
            raise Stop(f"verify: {old_records} still exists; the rename moved every record out of it, "
                       f"so move it aside")
    for entry in meta["records_repos"]:
        for path in entry["owned"]:
            untracked = "all" if path in (f"{old}/", f"{new}/") else "no"
            changes = run("git", "-C", entry["root"], "status", "--porcelain", f"--untracked-files={untracked}",
                          "--", path).splitlines()
            if changes:
                raise Stop(f"verify: {entry['root']} has uncommitted changes under {path}: "
                           f"{', '.join(line.strip() for line in changes)}; commit them there (the rename with "
                           f"the line apply printed) so the other host's sync carries them")


def verify(args):
    meta = load_meta(args.snapshot)
    check_environment("verify", meta)
    new_root, old, new = Path(meta["new_root"]), meta["old"], meta["new"]
    check = subprocess.run([str(link_tool(new_root, meta)), "--check"], text=True, capture_output=True)
    if check.returncode != 0:
        raise Stop(f"verify: link drift after apply:\n{check.stdout}")
    verify_records(meta)
    for root in (new_root, *(Path(r["root"]) for r in meta["repos"])):
        if run("tasks", "check", cwd=root).strip():
            raise Stop(f"verify: tasks check reports findings in {root}")
    hex_ = sample_task(project_row(new_root, "verify")["records"], new)
    run("tasks", "show", f"{old}-{hex_}", cwd=new_root)
    # The registry's location history: the old id, the old root and a path under the old
    # storage all answer the new prefix (tasks docs/project-operations.md,
    # Detached pairing and relocation).
    probes = [f"{old}-{hex_}", meta["checkout"]["root"]]
    if meta["storage_old"]:
        probes.append(str(Path(meta["storage_old"]) / "a-worktree"))
    rows = json.loads(run("tasks", "resolve", "--json", *probes))["results"]
    wrong = [f"{r['input']} ({r['status']} {r.get('prefix', '')})".replace(" )", ")") for r in rows
             if r["status"] != "resolved" or r.get("prefix") != new]
    if wrong:
        raise Stop(f"verify: tasks resolve does not answer {new} for " + ", ".join(wrong))
    if meta["storage_new"] and (new_root / ".worktrees").resolve() != Path(meta["storage_new"]).resolve():
        raise Stop("verify: .worktrees does not resolve to the moved storage")
    print("verified")


COMMANDS = {"save": save, "apply": apply, "retarget": retarget, "link": link, "verify": verify,
            "rollback": rollback}


def main(argv):
    parser = argparse.ArgumentParser(prog="rename-cutover")
    sub = parser.add_subparsers(dest="command", required=True)
    s = sub.add_parser("save")
    s.add_argument("--snapshot", required=True)
    s.add_argument("--checkout", required=True, help="the renamed project's checkout")
    s.add_argument("--repo", action="append", required=True,
                   help="a repository the cutover retargets in and rollback resets (repeatable)")
    s.add_argument("--new-root", required=True)
    s.add_argument("--old", required=True)
    s.add_argument("--new", required=True)
    s.add_argument("--link-tool", default="tools/harness-links",
                   help="the link tool's path inside the checkout")
    s.add_argument("--keep", action="append", default=[],
                   help="a file inside the checkout that git cannot restore, saved and "
                        "restored as a live file with its mode (repeatable)")
    r = sub.add_parser("retarget")
    r.add_argument("--snapshot", required=True)
    which = r.add_mutually_exclusive_group(required=True)
    which.add_argument("--repo", help="a repository in the snapshot")
    which.add_argument("--forward", action="store_true",
                       help="every registered project outside the snapshot, once rollback is over")
    for name in ("apply", "link", "verify", "rollback"):
        sub.add_parser(name).add_argument("--snapshot", required=True)
    args = parser.parse_args(argv)
    try:
        COMMANDS[args.command](args)
    except Stop as stop:
        print(f"rename-cutover: {stop}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
