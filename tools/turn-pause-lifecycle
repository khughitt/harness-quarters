def live_auth() -> pathlib.Path:
    return pathlib.Path(os.path.expanduser('~/.codex/auth.json')).resolve()


def auth_age(path: pathlib.Path) -> datetime.timedelta:
    """How long ago the live Codex login last refreshed; reads only that key."""
    stamp = json.loads(path.read_text()).get('last_refresh')
    if not stamp:
        raise SystemExit('live auth.json carries no last_refresh; not running')
    when = datetime.datetime.fromisoformat(re.sub(r'\.\d+', '', stamp).replace('Z', '+00:00'))
    return datetime.datetime.now(datetime.timezone.utc) - when


def check_link(link: pathlib.Path, live: pathlib.Path) -> str:
    if link.is_symlink():
        return 'symlink intact'
    if link.exists():
        shutil.copyfile(link, live)
        os.chmod(live, 0o600)
        link.unlink()
        return 'REPLACED: Codex wrote a regular auth.json; copied over the live file (mode 600)'
    return 'MISSING: the auth.json symlink is gone'


def write_codex_home(run: Run) -> pathlib.Path:
    home = run.harness_home
    writable = json.dumps([str(run.state / 'tasks'), str(run.config / 'tasks')])
    (home / 'config.toml').write_text(
        f'model = "{run.model}"\nmodel_reasoning_effort = "{CODEX_EFFORT}"\napproval_policy = "never"\n'
        'sandbox_mode = "workspace-write"\n\n'
        f'[sandbox_workspace_write]\nwritable_roots = {writable}\n\n'
        '[features]\nhooks = true\nmulti_agent = true\nshell_snapshot = true\n\n'
        '[agents]\nmax_concurrent_threads_per_session = 8\n\n'
        f'[projects."{run.work}"]\ntrust_level = "trusted"\n')
    (home / 'hooks.json').write_text(json.dumps(hook_entries(run, CODEX_EVENTS), indent=2) + '\n')
    link = home / 'auth.json'
    link.symlink_to(live_auth())
    return link


def rollouts(run: Run) -> list[pathlib.Path]:
    return sorted((run.harness_home / 'sessions').rglob('rollout-*.jsonl'))


def run_codex(run: Run) -> None:
    live = live_auth()
    age = auth_age(live)
    run.checks['auth_age_before'] = str(age)
    if age > MAX_AUTH_AGE and not run.accept_auth_age:
        raise NeedsContext(f'live Codex auth last refreshed {age} ago (over 7 days); not running')
    link = write_codex_home(run)
    env = run.harness_env()
    run.checks['version'] = subprocess.run(['codex', '--version'], env=env, capture_output=True, text=True,
                                           check=True).stdout.strip()
    tmux = ['tmux', '-L', 'turn-pause-lifecycle', '-f', '/dev/null']
    command = ['codex', '--no-daemon', '--dangerously-bypass-hook-trust', '-C', str(run.work), codex_prompt(run.task)]
    watcher = StateWatcher(run)
    watcher.start()
    start = time.time()

    def root(r):
        return not r['payload'].get('agent_id')

    def parked() -> bool:
        return any(r['event'] == 'PostToolUse' and root(r) and r['payload'].get('tool_name') == 'Bash'
                   and str((r['payload'].get('tool_input') or {}).get('command', '')).startswith('tasks park')
                   for r in records(run))

    def root_stop_after(t: float) -> float | None:
        stops = [r['t'] for r in records(run) if r['event'] == 'Stop' and root(r) and r['t'] > t]
        return stops[0] if stops else None

    def capture(name: str) -> None:
        pane = subprocess.run([*tmux, 'capture-pane', '-p', '-t', 'lc'], env=env, capture_output=True, text=True)
        (run.out / name).write_text(pane.stdout)

    try:
        subprocess.run([*tmux, 'new-session', '-d', '-s', 'lc', '-x', '220', '-y', '50', '-c', str(run.work), *command],
                       env=env, check=True)
        if not wait_until(parked, 1200, 1):
            run.notes.append('phase 1: no tasks park within 20 min')
        park_t = max([r['t'] for r in records(run) if r['event'] == 'PostToolUse' and root(r)
                      and str((r['payload'].get('tool_input') or {}).get('command', '')).startswith('tasks park')],
                     default=time.time())
        if not wait_until(lambda: root_stop_after(park_t) is not None, 300, 1):
            run.notes.append('phase 1: no root Stop within 5 min of the park')
        stop_t = root_stop_after(park_t) or time.time()
        run.checks['park_t'], run.checks['stop_t'] = park_t, stop_t
        # The goal row: watch for a continuation turn after the park (it fires no
        # UserPromptSubmit; any root hook event or a new rollout turn would show it).
        time.sleep(120)
        run.checks['watch_end'] = time.time()
        capture('tui-1.txt')
        host = (run.checks.get('kill_target') or {}).get('host_pid')
        run.checks['before_resume'] = {
            'kill_me_pid_alive': alive(read_pid(run, 'kill-me.pid') or 0),
            'kill_target_host_alive': alive(host) if host else None,
            'kill_me_pid_recorded': read_pid(run, 'kill-me.pid') is not None,
            'state': watcher.history[-1]['state'] if watcher.history else None,
        }
        run.checks['task_after_park'] = task_record(run)
        run.checks['continue_sent'] = time.time()
        subprocess.run([*tmux, 'send-keys', '-t', 'lc', '-l', 'continue'], env=env, check=True)
        time.sleep(1)
        subprocess.run([*tmux, 'send-keys', '-t', 'lc', 'Enter'], env=env, check=True)
        sent = run.checks['continue_sent']
        if not wait_until(lambda: root_stop_after(sent) is not None, 300, 1):
            run.notes.append('resume: no root Stop within 5 min of continue')
        time.sleep(5)
        capture('tui-2.txt')
        subprocess.run([*tmux, 'send-keys', '-t', 'lc', '-l', '/quit'], env=env)
        time.sleep(1)
        subprocess.run([*tmux, 'send-keys', '-t', 'lc', 'Enter'], env=env)
        wait_until(lambda: any(r['event'] == 'SessionEnd' for r in records(run)), 20)
    finally:
        subprocess.run([*tmux, 'kill-server'], env=env, capture_output=True)
        watcher.stop.set()
        watcher.join(timeout=5)
        run.checks['reaped'] = reap(run)
        run.checks['auth_after'] = check_link(link, live)
        if run.checks['auth_after'] == 'symlink intact':
            link.unlink()  # leave no live-login link behind in the run directory
    wall = round(time.time() - start, 1)
    run.runs.append({'command': ['codex', '--no-daemon', '--dangerously-bypass-hook-trust', '-C', '<run>/work',
                                 '<scripted prompt>'],
                     'runner': 'private tmux server (socket under <run>/tmux)', 'typed': ['continue', '/quit'],
                     'wall_s': wall})


class NeedsContext(Exception):
    pass


# ---- analysis ----------------------------------------------------------------------------------

def strings(value):
    if isinstance(value, str):
        yield value
    elif isinstance(value, dict):
        for v in value.values():
            yield from strings(v)
    elif isinstance(value, list):
        for v in value:
            yield from strings(v)


def transcript_texts(paths) -> list[tuple[str, str]]:
    """(file label, string) for every string in every JSON line of the transcripts."""
    out = []
    for path in paths:
        if not path.exists():
            continue
        for line in path.read_text(errors='replace').splitlines():
            try:
                value = json.loads(line)
            except ValueError:
                continue
            for s in strings(value):
                out.append((path.name, s))
    return out


def find(texts, regex) -> list[str]:
    """Labels of the transcripts holding a match, with the first match."""
    hits = {}
    for label, s in texts:
        m = regex.search(s)
        if m and label not in hits:
            hits[label] = m.group(0)
    return sorted(hits)


def states(run: Run) -> list[dict]:
    if not run.states_log.exists():
        return []
    return [json.loads(line) for line in run.states_log.read_text().splitlines() if line.strip()]


def tool_input(r: dict) -> dict:
    value = r['payload'].get('tool_input')
    return value if isinstance(value, dict) else {}


def command_of(r: dict) -> str:
    return str(tool_input(r).get('command', ''))


def stage(results: list, n: int, name: str, ok, detail: str) -> None:
    results.append({'stage': n, 'name': name, 'ok': bool(ok), 'detail': detail})


def common(run: Run):
    recs = records(run)
    root = lambda r: not r['payload'].get('agent_id')
    pre = [r for r in recs if r['event'] == 'PreToolUse' and root(r)]
    posts = {r['payload'].get('tool_use_id'): r for r in recs
             if r['event'] in ('PostToolUse', 'PostToolUseFailure')}
    snaps = [s for s in states(run) if s['state']]
    paused = [s for s in snaps if s['state'].get('paused')]
    return recs, pre, posts, snaps, paused


def analyze_claude(run: Run) -> tuple[list, dict]:
    recs, pre, posts, snaps, paused = common(run)
    texts = transcript_texts([run.out / 'stream.jsonl', *sorted(run.harness_home.rglob('*.jsonl'))])
    results, answers = [], {}
    allowed = lambda r: r['payload'].get('tool_use_id') in posts
    first_pause = paused[0] if paused else None
    seventh = pre[6] if len(pre) >= 7 else None
    bg = [r for r in pre[:6] if r['payload'].get('tool_name') == 'Bash' and tool_input(r).get('run_in_background')]
    root_hits = find(texts, ROOT_RE)
    turn = first_pause['state']['turn'] if first_pause else {}
    stage(results, 1, 'cross the call limit',
          seventh is not None and all(allowed(r) for r in pre[:6]) and not allowed(seventh)
          and first_pause is not None and first_pause['state']['paused'] == 'calls' and turn.get('calls') == 7
          and len(bg) >= 2 and bool(root_hits),
          f"root calls before the pause: {[r['payload'].get('tool_name') for r in pre[:6]]}, all allowed: "
          f"{all(allowed(r) for r in pre[:6])}; 7th {seventh['payload'].get('tool_name') if seventh else None} "
          f"allowed: {allowed(seventh) if seventh else None}; background Bash started: {len(bg)}; state paused="
          f"{first_pause['state']['paused'] if first_pause else None} calls={turn.get('calls')}/"
          f"{(turn.get('limits') or {}).get('calls')}; root text in: {root_hits}")
    t7 = seventh['t'] if seventh else float('inf')
    after = [r for r in pre if r['t'] > t7]
    reads = [r for r in after if r['payload'].get('tool_name') == 'Read']
    allowed_reads = [r for r in reads if allowed(r)]
    grace_max = max((s['state'].get('grace_used', {}).get('root', 0) for s in snaps), default=0)
    refused_read = next((r for r in reads if not allowed(r)), None)
    grace_hits = find(texts, GRACE_RE)
    stage(results, 2, 'spend the grace',
          len(allowed_reads) == 25 and grace_max == 25 and refused_read is not None
          and refused_read['t'] > allowed_reads[-1]['t'] and bool(grace_hits),
          f'reads after the pause: {len(reads)}, allowed {len(allowed_reads)}; state grace_used.root max {grace_max}; '
          f'a read refused after the 25th: {refused_read is not None}; grace text in: {grace_hits}')
    t_grace = refused_read['t'] if refused_read else float('inf')
    searches = [r for r in pre if r['payload'].get('tool_name') == 'ToolSearch']
    early = [r for r in searches if r['t'] <= t7]
    late = [r for r in searches if r['t'] > t7 and allowed(r)
            and str(tool_input(r).get('query', '')).replace(' ', '') == 'select:TaskStop']
    stops = [r for r in after if r['payload'].get('tool_name') == 'TaskStop']
    kills = [r for r in after if r['payload'].get('tool_name') == 'Bash' and command_of(r).startswith('kill')]
    before = run.checks.get('before_resume', {})
    gone = (before.get('task_stop_pid_recorded') and before.get('kill_me_pid_recorded')
            and not before.get('task_stop_pid_alive') and not before.get('kill_me_pid_alive'))
    # Each process is tied to its control: the step-2 shell's background task id to
    # TaskStop, the kill-me pid to kill (and the TaskStop pid to no kill).
    step2 = next((posts[r['payload']['tool_use_id']] for r in pre[:6] if f'sleep {SLEEP_TASK}' in command_of(r)
                  and r['payload'].get('tool_use_id') in posts), None)
    step2_id = (step2['payload'].get('tool_response') or {}).get('backgroundTaskId') if step2 else None
    stop_pid, kill_pid = read_pid(run, 'task-stop.pid'), read_pid(run, 'kill-me.pid')
    tied_stop = [r for r in stops if allowed(r) and r['t'] > t_grace and step2_id
                 and tool_input(r).get('task_id') == step2_id]
    kill_args = lambda r: command_of(r).split()[1:]
    tied_kill = [r for r in kills if allowed(r) and r['t'] > t_grace and str(kill_pid) in kill_args(r)]
    stray = [r for r in kills if str(stop_pid) in kill_args(r)]
    late_after_grace = [r for r in late if r['t'] > t_grace]
    stage(results, 3, 'stop own work after grace',
          not early and late_after_grace and tied_stop and tied_kill and not stray and gone,
          f'ToolSearch before the pause: {len(early)}; select:TaskStop allowed after grace: {len(late_after_grace)}; '
          f'TaskStop calls {[(tool_input(r), allowed(r), r["t"] > t_grace) for r in stops]} (input, allowed, after '
          f'grace), step-2 task {step2_id}, tied: {len(tied_stop)}; kill calls '
          f'{[(command_of(r), allowed(r), r["t"] > t_grace) for r in kills]}, kill-me pid {kill_pid}, tied: '
          f'{len(tied_kill)}, kills of the TaskStop pid: {len(stray)}; background pids recorded and gone: {gone}')
    parks = [r for r in after if r['payload'].get('tool_name') == 'Bash' and command_of(r).startswith('tasks park')]
    park_ok = [r for r in parks if allowed(r) and '"id"' in str(posts[r['payload']['tool_use_id']]['payload']
                                                                .get('tool_response'))]
    record = run.checks.get('task_after_park', {})
    parked = record.get('park') or {}
    t_park = park_ok[0]['t'] if park_ok else float('inf')
    stop_after = [r for r in recs if r['event'] == 'Stop' and r['t'] > t_park]
    stage(results, 4, 'park and end the turn',
          bool(park_ok) and parked.get('waiting_on') == 'user' and bool(stop_after),
          f'tasks park calls {[(command_of(r), allowed(r)) for r in parks]}; record parked waiting on '
          f'{parked.get("waiting_on")} ({parked.get("reason")}); root Stop after the park: {len(stop_after)}')
    sent = run.checks.get('continue_sent', float('inf'))
    prompts = [r for r in recs if r['event'] == 'UserPromptSubmit' and r['t'] >= sent - 1]
    cont = [r for r in prompts if r['payload'].get('prompt') == 'continue']
    t_c = cont[0]['t'] if cont else float('inf')
    reset = [s for s in snaps if s['t'] >= t_c and s['state'].get('turn', {}).get('started', 0) >= t_c - 1]
    fresh = reset[0]['state'] if reset else {}
    echo = [r for r in pre if r['t'] > t_c and r['payload'].get('tool_name') == 'Bash'
            and command_of(r).strip() == 'echo resumed']
    echo_ok = [r for r in echo if allowed(r) and 'resumed' in str(posts[r['payload']['tool_use_id']]['payload']
                                                                  .get('tool_response'))]
    still = (before.get('state') or {}).get('paused')
    final = reset[-1]['state'] if reset else {}
    stage(results, 5, 'resume with continue',
          still == 'calls' and bool(cont) and fresh.get('paused') is None and bool(echo_ok)
          and (final.get('turn') or {}).get('calls', 99) <= 2 and not final.get('grace_used'),
          f'paused before continue: {still}; continue prompt seen: {bool(cont)}; new turn state: paused='
          f"{fresh.get('paused')} calls={(final.get('turn') or {}).get('calls')} grace_used={final.get('grace_used')}; "
          f'echo resumed allowed: {bool(echo_ok)}')
    names = sorted({r['payload'].get('tool_name') for r in recs if r['event'] == 'PreToolUse'})
    child_hits = find(texts, CHILD_RE)
    children = [r for r in recs if r['event'] == 'PreToolUse' and r['payload'].get('agent_id')]
    answers['q2_hook_names'] = {'TaskStop': sorted({r['payload'].get('tool_name') for r in stops}),
                                'Read': sorted({r['payload'].get('tool_name') for r in reads}),
                                'all_pre_tool_names': names,
                                'toolsearch_after_pause': [tool_input(r) for r in late],
                                'taskstop_inputs': [tool_input(r) for r in stops]}
    answers['q4_texts'] = {'root_text_in': root_hits, 'child_text_in': child_hits,
                           'child_calls': [(r['payload'].get('tool_name'), command_of(r)[:80],
                                            r['payload'].get('tool_use_id') in posts) for r in children]}
    answers['warning_in'] = find(texts, WARNING_RE)
    wake_prompts = [str(r['payload'].get('prompt'))[:120] for r in recs if r['event'] == 'UserPromptSubmit']
    answers['prompts'] = wake_prompts
    answers['notify_log'] = run.notify_log.read_text().splitlines() if run.notify_log.exists() else []
    end = [s for s in states(run) if s['state'] is None]
    answers['state_removed_at_session_end'] = bool(end)
    answers['pause_state'] = {k: (first_pause['state'] if first_pause else {}).get(k)
                              for k in ('paused', 'harness_pid', 'notified', 'notify_error', 'worker_names', 'workers')}
    return results, answers


def analyze_codex(run: Run) -> tuple[list, dict]:
    recs, pre, posts, snaps, paused = common(run)
    texts = transcript_texts(rollouts(run))
    results, answers = [], {}
    allowed = lambda r: r['payload'].get('tool_use_id') in posts
    first_pause = paused[0] if paused else None
    turn = first_pause['state']['turn'] if first_pause else {}
    seventh = pre[6] if len(pre) >= 7 else None
    root_hits = find(texts, ROOT_RE)
    yielded = [r for r in pre[:6] if f'sleep {SLEEP_KILL}' in command_of(r)]
    stage(results, 1, 'cross the call limit',
          seventh is not None and not allowed(seventh) and first_pause is not None
          and first_pause['state']['paused'] == 'calls' and turn.get('calls') == 7 and bool(yielded) and bool(root_hits),
          f"root calls before the pause: {[(r['payload'].get('tool_name'), command_of(r)[:40]) for r in pre[:6]]}; "
          f"7th {seventh['payload'].get('tool_name') if seventh else None} {command_of(seventh)[:40] if seventh else ''} "
          f"allowed: {allowed(seventh) if seventh else None}; background command started: {bool(yielded)}; state paused="
          f"{first_pause['state']['paused'] if first_pause else None} calls={turn.get('calls')}; root text in: {root_hits}")
    t7 = seventh['t'] if seventh else float('inf')
    after = [r for r in pre if r['t'] > t7]
    reads = [r for r in after if r['payload'].get('tool_name') == 'Bash' and re.fullmatch(r'cat r\d\d\.txt', command_of(r).strip())]
    allowed_reads = [r for r in reads if allowed(r)]
    grace_max = max((s['state'].get('grace_used', {}).get('root', 0) for s in snaps), default=0)
    refused_read = next((r for r in reads if not allowed(r)), None)
    grace_hits = find(texts, GRACE_RE)
    stage(results, 2, 'spend the grace',
          len(allowed_reads) == 25 and grace_max == 25 and refused_read is not None and bool(grace_hits),
          f'reads after the pause: {len(reads)}, allowed {len(allowed_reads)}; state grace_used.root max {grace_max}; '
          f'a read refused: {refused_read is not None}; grace text in: {grace_hits}')
    t_grace = refused_read['t'] if refused_read else float('inf')
    kills = [r for r in after if r['payload'].get('tool_name') == 'Bash' and command_of(r).strip().startswith('kill')]
    interrupts = [r for r in after if r['payload'].get('tool_name') == 'collaborationinterrupt_agent']
    goals = [r for r in after if r['payload'].get('tool_name') == 'update_goal']
    before = run.checks.get('before_resume', {})
    # The host's view decides when it was captured: a namespaced pid names another process here.
    host_alive = before.get('kill_target_host_alive')
    gone = before.get('kill_me_pid_recorded') and not (before.get('kill_me_pid_alive') if host_alive is None else host_alive)
    kill_pid = read_pid(run, 'kill-me.pid')
    target = run.checks.get('kill_target')
    ns = namespaced(target)
    tied_kill = [r for r in kills if allowed(r) and r['t'] > t_grace and str(kill_pid) in command_of(r).split()[1:]]
    tied_interrupt = [r for r in interrupts if allowed(r) and r['t'] > t_grace
                      and tool_input(r).get('target') in ('lifecycle_worker', '/root/lifecycle_worker')]
    goal_paused = [r for r in goals if allowed(r) and r['t'] > t_grace and tool_input(r) == {'status': 'paused'}]
    ok = bool(tied_kill and tied_interrupt and goal_paused and gone)
    label = ''
    if not (tied_kill and gone) and ns:
        label = 'PID namespace (sandbox): the recorded pid is not the host pid, so the hook cannot check or reach it; '
    elif kills and not gone and tied_kill:
        label = 'kill allowed but the process survived (harness: the signal did not reach it); '
    stage(results, 3, 'stop own work after grace', ok,
          f'{label}kill calls {[(command_of(r), allowed(r), r["t"] > t_grace) for r in kills]}, kill-me pid {kill_pid}, '
          f'tied: {len(tied_kill)}; kill target {target} (namespaced: {ns}); interrupt_agent '
          f'{[(tool_input(r), allowed(r), r["t"] > t_grace) for r in interrupts]}, tied: {len(tied_interrupt)}; '
          f'update_goal {[(tool_input(r), allowed(r), r["t"] > t_grace) for r in goals]}; pid recorded and gone: {gone}')
    parks = [r for r in after if r['payload'].get('tool_name') == 'Bash' and command_of(r).startswith('tasks park')]
    park_ok = [r for r in parks if allowed(r)]
    record = run.checks.get('task_after_park', {})
    parked = record.get('park') or {}
    stop_t, watch_end = run.checks.get('stop_t', float('inf')), run.checks.get('watch_end', 0)
    sent = run.checks.get('continue_sent', float('inf'))
    between = [r for r in recs if stop_t < r['t'] < sent and not r['payload'].get('agent_id')]
    goal_turns = []
    for path in rollouts(run):
        for line in path.read_text(errors='replace').splitlines():
            if '"turn_trigger"' in line and '"goal"' in line:
                goal_turns.append(path.name)
    stage(results, 4, 'park, end the turn, no goal continuation',
          bool(park_ok) and parked.get('waiting_on') == 'user' and stop_t != float('inf') and not between
          and watch_end - stop_t >= 100,
          f'tasks park calls {[(command_of(r), allowed(r)) for r in parks]}; record parked waiting on '
          f'{parked.get("waiting_on")} ({parked.get("reason")}); root Stop after the park: {stop_t != float("inf")}; '
          f'root hook events between that Stop and continue ({round(sent - stop_t)} s): '
          f'{[(r["event"], r["payload"].get("tool_name")) for r in between]}; rollout goal-trigger lines: {len(goal_turns)}')
    cont = [r for r in recs if r['event'] == 'UserPromptSubmit' and r['payload'].get('prompt', '').strip() == 'continue']
    t_c = cont[0]['t'] if cont else float('inf')
    reset = [s for s in snaps if s['t'] >= t_c and s['state'].get('turn', {}).get('started', 0) >= t_c - 1]
    fresh = reset[0]['state'] if reset else {}
    final = reset[-1]['state'] if reset else {}
    echo = [r for r in pre if r['t'] > t_c and r['payload'].get('tool_name') == 'Bash' and command_of(r).strip() == 'echo resumed']
    echo_ok = [r for r in echo if allowed(r)]
    still = (before.get('state') or {}).get('paused')
    stage(results, 5, 'resume with continue',
          still == 'calls' and bool(cont) and fresh.get('paused') is None and bool(echo_ok)
          and (final.get('turn') or {}).get('calls', 99) <= 2 and not final.get('grace_used'),
          f'paused before continue: {still}; continue prompt seen: {bool(cont)}; new turn state: paused='
          f"{fresh.get('paused')} calls={(final.get('turn') or {}).get('calls')} grace_used={final.get('grace_used')}; "
          f'echo resumed allowed: {bool(echo_ok)}')
    children = [r for r in recs if r['event'] == 'PreToolUse' and r['payload'].get('agent_id')]
    answers['q1_warning_in'] = find(texts, WARNING_RE)
    answers['q3_goal'] = {'update_goal': [(tool_input(r), allowed(r)) for r in goals],
                          'root_events_between_stop_and_continue': [(r['event'], r['payload'].get('tool_name')) for r in between],
                          'watch_s': round(watch_end - stop_t, 1) if stop_t != float('inf') else None,
                          'goal_trigger_lines': len(goal_turns)}
    answers['q4_texts'] = {'root_text_in': root_hits, 'child_text_in': find(texts, CHILD_RE),
                           'child_calls': [(r['payload'].get('tool_name'), command_of(r)[:80], allowed(r)) for r in children]}
    answers['all_pre_tool_names'] = sorted({r['payload'].get('tool_name') for r in recs if r['event'] == 'PreToolUse'})
    answers['notify_log'] = run.notify_log.read_text().splitlines() if run.notify_log.exists() else []
    answers['pause_state'] = {k: (first_pause['state'] if first_pause else {}).get(k)
                              for k in ('paused', 'harness_pid', 'notified', 'notify_error', 'worker_names', 'workers')}
    return results, answers


# ---- entry ------------------------------------------------------------------------------------

def main(argv: list[str]) -> int:
    if argv[:1] == ['observe'] and len(argv) == 2:
        return observe(argv[1])
    parser = argparse.ArgumentParser(description=(__doc__ or '').split('\n\n')[0])
    parser.add_argument('--harness', required=True, choices=('claude-code', 'codex'))
    parser.add_argument('--out', help='run directory (default: a new temporary directory)')
    parser.add_argument('--model', help=f'default {CLAUDE_MODEL} (Claude Code) or {CODEX_MODEL} (Codex)')
    parser.add_argument('--accept-auth-age', action='store_true',
                        help='Codex: run even when the live login last refreshed over 7 days ago (a user ruling)')
    parser.add_argument('--analyze', action='store_true',
                        help='only judge the stages again from an earlier run in --out (its run.json and logs)')
    args = parser.parse_args(argv)
    if args.analyze:
        if not args.out:
            raise SystemExit('--analyze needs --out')
        return report(load_run(args.harness, pathlib.Path(args.out).resolve()))
    out = pathlib.Path(args.out).resolve() if args.out else pathlib.Path(tempfile.mkdtemp(prefix='turn-pause-lifecycle-'))
    out.mkdir(parents=True, exist_ok=True)
    if any(out.iterdir()):
        raise SystemExit(f'{out} is not empty')
    run = Run(args.harness, out, args.model or (CLAUDE_MODEL if args.harness == 'claude-code' else CODEX_MODEL))
    run.accept_auth_age = args.accept_auth_age

    def stop(signum, frame):
        raise SystemExit(f'stopped by signal {signum}')

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        setup(run)
        (run_claude if args.harness == 'claude-code' else run_codex)(run)
    except NeedsContext as e:
        print(f'{args.harness}: NEEDS_CONTEXT: {e}')
        return 3
    finally:
        reap(run)
        save_run(run)
    return report(run)


def save_run(run: Run) -> None:
    """What the analysis needs besides the logs, so --analyze can judge a run again."""
    (run.out / 'run.json').write_text(json.dumps({'model': run.model, 'task': run.task, 'token': run.token,
                                                 'runs': run.runs, 'notes': run.notes, 'checks': run.checks},
                                                indent=2, default=str) + '\n')


def load_run(harness: str, out: pathlib.Path) -> Run:
    data = json.loads((out / 'run.json').read_text())
    run = Run(harness, out, data['model'])
    run.task, run.token, run.runs, run.notes, run.checks = (data['task'], data['token'], data['runs'], data['notes'],
                                                            data['checks'])
    return run


def report(run: Run) -> int:
    args, out = argparse.Namespace(harness=run.harness), run.out
    results, answers = (analyze_claude if run.harness == 'claude-code' else analyze_codex)(run)
    for r in results:
        print(f"{args.harness} stage {r['stage']} {r['name']}: {'PASS' if r['ok'] else 'FAIL'} - {r['detail']}")
    failed = [r['stage'] for r in results if not r['ok']]
    summary = {'harness': args.harness, 'model': run.model, 'task': run.task, 'stages': results, 'answers': answers,
               'runs': run.runs, 'notes': run.notes,
               'checks': {k: v for k, v in run.checks.items() if k not in ('task_after_park',)},
               'park': (run.checks.get('task_after_park') or {}).get('park'),
               'verdict': 'PASS' if not failed else f'FAIL: stage {", ".join(map(str, failed))}'}
    (out / 'summary.json').write_text(json.dumps(run.portable(summary), indent=2, default=str) + '\n')
    for note in run.notes:
        print(f'{args.harness} note: {note}')
    print(summary['verdict'])
    print(f'run directory: {out}')
    return 0 if not failed else 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
