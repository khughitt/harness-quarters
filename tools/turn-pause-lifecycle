# ---- the recording hook ---------------------------------------------------------------

def observe(event: str) -> int:
    """Append {event, t, payload} to $TURN_PAUSE_LIFECYCLE_LOG; print nothing, exit 0."""
    raw = sys.stdin.read()
    try:
        payload = json.loads(raw)
    except ValueError:
        payload = {'_unparsed': raw[:2000]}
    log = os.environ.get(LOG_VAR)
    if log:
        with open(log, 'a') as out:
            fcntl.flock(out, fcntl.LOCK_EX)
            out.write(json.dumps({'event': event, 't': time.time(), 'payload': payload}) + '\n')
    return 0


# ---- texts ------------------------------------------------------------------------------

def _pattern(template: str, limit: str) -> str:
    pat = re.escape(template)
    pat = pat.replace(re.escape('{limit}'), re.escape(limit))
    for field in ('a', 'A'):
        pat = pat.replace(re.escape('{' + field + '}'), r'\d+:\d\d')
    for field in ('c', 'C', 's', 'S', 'k', 'K'):
        pat = pat.replace(re.escape('{' + field + '}'), r'\d+')
    return pat


ROOT_RE = re.compile(_pattern(tp.ROOT_TEXT, 'calls'))
CHILD_RE = re.compile(_pattern(tp.CHILD_TEXT, 'calls'))
GRACE_RE = re.compile(re.escape(tp.GRACE_TEXT))
WARNING_RE = re.compile(re.escape('turn-pause: calls at 83% (5 of 6). Finish a coherent step and prepare your report.'))


def claude_prompt(task: str) -> str:
    return f"""This is a scripted end-to-end test of a turn-pause hook, in a scratch directory. The hook counts your tool calls and pauses the turn after the sixth. Follow these phases exactly, one tool call per message.

Phase 1, before the pause:
1. Use the Agent tool once: subagent_type general-purpose, run_in_background true, description "lifecycle child", prompt: "Use the Bash tool (timeout 300000) to run: until [ -e go.flag ]; do sleep 1; done; echo released . Then use the Bash tool to run: echo child-after . If a call is refused, follow the refusal's instructions and reply with the refusal message verbatim."
2. Use Bash with run_in_background true to run: echo $$ > task-stop.pid; exec sleep {SLEEP_TASK}
3. Use Bash with run_in_background true to run: echo $$ > kill-me.pid; exec sleep {SLEEP_KILL}
4. Use Bash to run: sleep 2; cat task-stop.pid kill-me.pid
   Remember both pids.
5. Use Bash to run: echo step5
6. Use Bash to run: echo step6
7. Use Bash to run: echo step7
   This call will be refused with a "turn paused" message.

Phase 2, after that refusal: read the files r01.txt, r02.txt, r03.txt and so on up to r{READS}.txt, in order, with the Read tool, one file per call, until a Read is refused because the grace reads are used up. Do not stop reading before that refusal.

Phase 3, stop your own work:
a. Load the TaskStop tool with ToolSearch, query "select:TaskStop".
b. Use TaskStop on the background task you started in step 2.
c. Use Bash to run: kill <the pid from kill-me.pid>
d. If the subagent from step 1 is still running, stop it with TaskStop too.

Phase 4: use Bash to run: tasks park {task} "{NEXT_STEP}" --waiting-on user --reason decision
Then end your turn with a three-line pause report: what you did, what is left, what is running.

If a later message is a task notification, reply with the single word NOTED and use no tool.
If the user later sends the single word continue, use Bash to run: echo resumed . Then reply DONE."""


def codex_prompt(task: str) -> str:
    return f"""This is a scripted end-to-end test of a turn-pause hook, in a scratch directory. The hook counts your tool calls and pauses the turn after the sixth. Follow these phases exactly. Make one tool call at a time: each exec call makes exactly one nested tool call.

Phase 1, before the pause:
1. Run the shell command `tasks start {task}` with exec_command.
2. Create a goal in one exec call: create_goal with objective "Finish the scripted turn-pause lifecycle test from the first message."
3. Spawn one worker with spawn_agent: task_name lifecycle_worker, fork_turns none, message: "Run the shell command `until [ -e go.flag ]; do sleep 1; done; echo released` with exec_command and wait until it finishes. Then run `echo child-after` with exec_command. If a call is refused, follow the refusal's instructions and reply with the refusal message verbatim." Do not wait for the worker.
4. Run `sh -c 'echo $$ > kill-me.pid; grep NSpid /proc/$$/status >> kill-me.pid; exec sleep {SLEEP_KILL}'` with exec_command and yield_time_ms 1000. It keeps running in the background; do not wait for it.
5. Run `cat kill-me.pid` with exec_command. Remember the pid on its first line.
6. Run `echo step6` with exec_command.
7. Run `echo step7` with exec_command. This call will be refused with a "turn paused" message.

Phase 2, after that refusal: run `cat r01.txt`, `cat r02.txt`, `cat r03.txt` and so on up to `cat r{READS}.txt` with exec_command, in order, one file per call, until one is refused because the grace reads are used up. Do not stop reading before that refusal.

Phase 3, stop your own work:
a. Run `kill <the pid on the first line of kill-me.pid>` with exec_command.
b. Call interrupt_agent with target lifecycle_worker.
c. Set your goal to paused: update_goal with exactly {{status: "paused"}} and no other field.

Phase 4: run `tasks park {task} "{NEXT_STEP}" --waiting-on user --reason decision` with exec_command. Then end your turn with a three-line pause report: what you did, what is left, what is running.

If the user later sends the single word continue, run `echo resumed` with exec_command, then reply DONE and end your turn."""


# ---- the run directory --------------------------------------------------------------------

class Run:
    def __init__(self, harness: str, out: pathlib.Path, model: str):
        self.harness, self.out, self.model = harness, out, model
        self.token = uuid.uuid4().hex
        self.bin, self.home, self.work = out / 'bin', out / 'home', out / 'work'
        self.config, self.state, self.runtime, self.tmp = out / 'config', out / 'state', out / 'runtime', out / 'tmp'
        self.hooks_log, self.states_log, self.notify_log = out / 'hooks.jsonl', out / 'states.jsonl', out / 'notify.log'
        self.pause_dir = self.state / 'hq' / 'pause'
        self.harness_home = out / ('claude-config' if harness == 'claude-code' else 'codexhome')
        self.task = ''
        self.runs = []
        self.notes = []
        self.checks = {}
        self.accept_auth_age = False

    def portable(self, value):
        """value with host values replaced: <run> for OUT, ~ for the home directory, <host>
        for the host name and for any `host` field, <owner> for any `owner` field."""
        host = socket.gethostname()
        word = re.compile(rf'\b{re.escape(host)}\b') if host else None

        def clean(v, key=None):
            if isinstance(v, dict):
                return {k: clean(x, k) for k, x in v.items()}
            if isinstance(v, list):
                return [clean(x) for x in v]
            if isinstance(v, str):
                if key == 'owner':
                    return '<owner>'
                if key == 'host':
                    return '<host>'
                v = v.replace(str(self.out), '<run>').replace(os.path.expanduser('~'), '~')
                return word.sub('<host>', v) if word else v
            return v

        return clean(json.loads(json.dumps(value, default=str)))

    def env(self, **extra) -> dict:
        env = {
            'PATH': f'{self.bin}:/usr/bin:/bin', 'HOME': str(self.home), 'USER': os.environ.get('USER', 'lifecycle'),
            'LANG': 'C.UTF-8', 'TERM': 'dumb', 'TMPDIR': str(self.tmp),
            'XDG_CONFIG_HOME': str(self.config), 'XDG_STATE_HOME': str(self.state), 'XDG_RUNTIME_DIR': str(self.runtime),
            'XDG_CACHE_HOME': str(self.home / '.cache'), 'XDG_DATA_HOME': str(self.home / '.local' / 'share'),
            'GIT_CONFIG_GLOBAL': '/dev/null', 'GIT_CONFIG_NOSYSTEM': '1',
            'GIT_AUTHOR_NAME': 'lifecycle', 'GIT_AUTHOR_EMAIL': 'lifecycle@example.invalid',
            'GIT_COMMITTER_NAME': 'lifecycle', 'GIT_COMMITTER_EMAIL': 'lifecycle@example.invalid',
            LOG_VAR: str(self.hooks_log), MARKER: self.token,
        }
        env.update(extra)
        return env

    def harness_env(self) -> dict:
        if self.harness == 'claude-code':
            key = os.environ.get('ANTHROPIC_API_KEY')
            if not key:
                raise SystemExit('ANTHROPIC_API_KEY is not set; the Claude Code run authenticates with it')
            return self.env(CLAUDE_CONFIG_DIR=str(self.harness_home), ANTHROPIC_API_KEY=key, SHELL='/usr/bin/bash',
                            DISABLE_AUTOUPDATER='1')
        return self.env(CODEX_HOME=str(self.harness_home), SHELL='/usr/bin/zsh', TMUX_TMPDIR=str(self.out / 'tmux'))


def _which(name: str) -> str:
    found = shutil.which(name)
    if not found:
        raise SystemExit(f'{name} is not on PATH')
    return os.path.realpath(found)


def _script(path: pathlib.Path, text: str) -> None:
    path.write_text(text)
    path.chmod(0o755)


def _git_isolated(run: Run, *args: str) -> str:
    """git in the work directory, off the host's config, every inherited GIT_* dropped."""
    done = subprocess.run(['git', *args], cwd=run.work, env=run.env(), capture_output=True, text=True, check=True)
    return done.stdout


def setup(run: Run) -> None:
    out = run.out
    for d in (run.bin, run.home, run.work, run.config, run.state, run.tmp, run.harness_home, out / 'tmux'):
        d.mkdir(parents=True, exist_ok=True)
    run.runtime.mkdir(mode=0o700, parents=True, exist_ok=True)
    tools = ['tasks', 'claude' if run.harness == 'claude-code' else 'codex']
    for name in tools:
        (run.bin / name).symlink_to(_which(name))
    _script(run.bin / 'hq', f'#!/bin/sh\nexec /usr/bin/python3 {HQ} "$@"\n')
    _script(run.bin / 'notify-send', f'#!/bin/sh\nprintf \'%s\\n\' "$*" >> {run.notify_log}\nexit 0\n')
    # The throwaway tasks project, in its own git repository, registered under the temporary
    # XDG_CONFIG_HOME only.
    _git_isolated(run, 'init', '-q', '.')
    top = _git_isolated(run, 'rev-parse', '--show-toplevel', '--absolute-git-dir').split()
    if top != [str(run.work), str(run.work / '.git')]:
        raise SystemExit(f'git fixture escaped its directory: {top}')
    tasks = lambda *a, **kw: subprocess.run(['tasks', *a], cwd=run.work, env=run.env(**kw), capture_output=True,
                                            text=True, check=True).stdout
    tasks('init', '--prefix', 'tpl')
    run.task = json.loads(tasks('add', TASK_TITLE))['id']
    for i in range(1, READS + 1):
        (run.work / f'r{i:02d}.txt').write_text(f'lifecycle read {i:02d}\n')
    registry = (run.config / 'tasks' / 'projects.toml').read_text()
    if str(run.work) not in registry:
        raise SystemExit('the tasks project is not registered under the temporary XDG_CONFIG_HOME')


def hook_entries(run: Run, events: list[str]) -> dict:
    hooks = {}
    for event in events + OBSERVE_ONLY:
        commands = []
        if event not in OBSERVE_ONLY:
            commands.append({'type': 'command', 'timeout': HOOK_TIMEOUT,
                             'command': f'{HOOK} --limits {LIMITS} --harness {run.harness} {event}'})
        commands.append({'type': 'command', 'timeout': HOOK_TIMEOUT, 'command': f'/usr/bin/python3 {SELF} observe {event}'})
        entry: dict[str, object] = {'hooks': commands}
        if event in TOOL_EVENTS:
            entry['matcher'] = '*'
        hooks[event] = [entry]
    return {'hooks': hooks}


# ---- watching ----------------------------------------------------------------------------

class StateWatcher(threading.Thread):
    """Polls the pause state directory and appends each change to states.jsonl; touches
    work/go.flag once a pause is seen (it releases the child's pre-pause command)."""

    def __init__(self, run: Run):
        super().__init__(daemon=True)
        self.lc, self.stop = run, threading.Event()
        self.last = {}
        self.history = []

    def poll(self):
        current = {}
        if self.lc.pause_dir.exists():
            for path in sorted(self.lc.pause_dir.glob('*.json')):
                try:
                    current[path.name] = path.read_text()
                except OSError:
                    continue
        now = time.time()
        for name in sorted(set(current) | set(self.last)):
            if current.get(name) == self.last.get(name):
                continue
            try:
                state = json.loads(current[name]) if name in current else None
            except ValueError:
                continue  # a replace in progress; read again next poll
            entry = {'t': now, 'file': name, 'state': state}
            self.history.append(entry)
            with open(self.lc.states_log, 'a') as out:
                out.write(json.dumps(entry) + '\n')
            if state and state.get('paused') and not (self.lc.work / 'go.flag').exists():
                (self.lc.work / 'go.flag').write_text('go\n')
            self.last[name] = current.get(name)
        self.last = {k: v for k, v in self.last.items() if k in current}
        if 'kill_target' not in self.lc.checks and (self.lc.work / 'kill-me.pid').exists():
            target = kill_target(self.lc)
            if target is not None:
                self.lc.checks['kill_target'] = target

    def run(self):  # noqa: D401  (threading.Thread.run)
        while not self.stop.is_set():
            self.poll()
            time.sleep(0.2)
        self.poll()


def records(run: Run) -> list[dict]:
    if not run.hooks_log.exists():
        return []
    out = []
    for line in run.hooks_log.read_text().splitlines():
        try:
            out.append(json.loads(line))
        except ValueError:
            pass
    return out


def wait_until(pred, timeout: float, step: float = 0.5) -> bool:
    deadline = time.time() + timeout
    while time.time() < deadline:
        if pred():
            return True
        time.sleep(step)
    return pred()


def last_activity(run: Run, files) -> float:
    return max((f.stat().st_mtime for f in files if f.exists()), default=0.0)


def marked_pids(token: str) -> list[int]:
    """Processes whose environment carries this run's marker."""
    needle = f'{MARKER}={token}'.encode()
    pids = []
    for entry in os.listdir('/proc'):
        if not entry.isdigit():
            continue
        try:
            with open(f'/proc/{entry}/environ', 'rb') as f:
                if needle in f.read().split(b'\0'):
                    pids.append(int(entry))
        except OSError:
            continue
    return pids


def reap(run: Run) -> list[int]:
    """TERM, then KILL, every process carrying the marker. Returns those that were found."""
    found = marked_pids(run.token)
    for sig in (signal.SIGTERM, signal.SIGKILL):
        for pid in marked_pids(run.token):
            try:
                os.kill(pid, sig)
            except OSError:
                pass
        if not wait_until(lambda: not marked_pids(run.token), 3, 0.2):
            continue
        break
    return found


def alive(pid: int) -> bool:
    """Running, not a zombie."""
    try:
        with open(f'/proc/{pid}/stat') as f:
            return f.read().rsplit(')', 1)[1].split()[0] != 'Z'
    except (OSError, IndexError):
        return False


def read_pid(run: Run, name: str) -> int | None:
    try:
        return int((run.work / name).read_text().split('\n', 1)[0].strip())
    except (OSError, ValueError):
        return None


def _nspid(pid: int) -> list[int] | None:
    try:
        with open(f'/proc/{pid}/status') as f:
            for line in f:
                if line.startswith('NSpid:'):
                    return [int(x) for x in line.split()[1:]]
    except (OSError, ValueError):
        return None
    return None


def kill_target(run: Run) -> dict | None:
    """The process the agent will kill as the agent recorded it (kill-me.pid: the pid and
    its NSpid line) and as the host sees it (the marked `sleep` process, its host pid and
    NSpid). A recorded pid that differs from the host pid means the command ran in its own
    PID namespace (the harness sandbox), where the hook's ancestry check cannot follow."""
    try:
        recorded = (run.work / 'kill-me.pid').read_text().splitlines()
    except OSError:
        return None
    if not recorded:
        return None
    sleep = f'sleep{chr(0)}{SLEEP_KILL}'.encode()
    hosts = []
    for pid in marked_pids(run.token):
        try:
            with open(f'/proc/{pid}/cmdline', 'rb') as f:
                if f.read().rstrip(b'\0') == sleep:
                    hosts.append(pid)
        except OSError:
            continue
    if not hosts:
        return None
    host = hosts[0]
    return {'recorded': recorded, 'host_pid': host, 'host_nspid': _nspid(host), 'host_matches': len(hosts)}


def namespaced(target: dict | None) -> bool | None:
    """Whether the kill target ran in its own PID namespace; None when not captured."""
    if not target:
        return None
    try:
        recorded = int(target['recorded'][0].strip())
    except (ValueError, IndexError):
        return None
    return recorded != target['host_pid'] or len(target.get('host_nspid') or []) > 1


def task_record(run: Run) -> dict:
    done = subprocess.run(['tasks', 'show', run.task, '--no-fetch'], cwd=run.work, env=run.env(),
                          capture_output=True, text=True)
    try:
        return json.loads(done.stdout)
    except ValueError:
        return {'_error': done.stderr[-500:]}


# ---- Claude Code ----------------------------------------------------------------------------

def stream_events(path: pathlib.Path) -> list[dict]:
    if not path.exists():
        return []
    out = []
    for line in path.read_text().splitlines():
        try:
            out.append(json.loads(line))
        except ValueError:
            pass
    return out


def run_claude(run: Run) -> None:
    sid = str(uuid.uuid4())
    run.checks['session'] = sid
    # The session's claim, taken under the session id the run will use.
    subprocess.run(['tasks', 'start', run.task], cwd=run.work, check=True, capture_output=True, text=True,
                   env=run.env(CLAUDECODE='1', CLAUDE_CODE_SESSION_ID=sid))
    settings = run.out / 'settings.json'
    settings.write_text(json.dumps(hook_entries(run, CLAUDE_EVENTS), indent=2) + '\n')
    env = run.harness_env()
    version = subprocess.run(['claude', '--version'], env=env, capture_output=True, text=True, check=True).stdout.strip()
    run.checks['version'] = version
    command = ['claude', '-p', '--input-format', 'stream-json', '--output-format', 'stream-json', '--verbose',
               '--model', run.model, '--session-id', sid, '--setting-sources', 'project', '--strict-mcp-config',
               '--disable-slash-commands', '--settings', str(settings), '--permission-mode', 'bypassPermissions']
    stream, stderr = run.out / 'stream.jsonl', run.out / 'stderr.txt'
    watcher = StateWatcher(run)
    watcher.start()
    start = time.time()
    proc = None
    try:
        with open(stream, 'w') as so, open(stderr, 'w') as se:
            proc = subprocess.Popen(command, cwd=run.work, env=env, stdin=subprocess.PIPE, stdout=so, stderr=se,
                                    text=True, start_new_session=True)

            stdin = proc.stdin
            assert stdin is not None

            def send(text: str) -> None:
                stdin.write(json.dumps({'type': 'user', 'message': {'role': 'user', 'content': text}}) + '\n')
                stdin.flush()

            def results() -> int:
                return sum(e.get('type') == 'result' for e in stream_events(stream))

            def parked() -> bool:
                return any(r['event'] == 'PostToolUse' and not r['payload'].get('agent_id')
                           and str((r['payload'].get('tool_input') or {}).get('command', '')).startswith('tasks park')
                           for r in records(run))

            def quiet(seconds: float) -> bool:
                return time.time() - last_activity(run, [stream, run.hooks_log]) >= seconds

            send(claude_prompt(run.task))
            if not wait_until(lambda: proc.poll() is not None or (results() >= 1 and parked()), 1200, 1):
                run.notes.append('phase 1: no result after a park within 20 min')
            # Background notifications start wake turns; wait for them to settle.
            wait_until(lambda: proc.poll() is not None or quiet(25), 300, 1)
            run.checks['before_resume'] = {
                'task_stop_pid_alive': alive(read_pid(run, 'task-stop.pid') or 0),
                'kill_me_pid_alive': alive(read_pid(run, 'kill-me.pid') or 0),
                'task_stop_pid_recorded': read_pid(run, 'task-stop.pid') is not None,
                'kill_me_pid_recorded': read_pid(run, 'kill-me.pid') is not None,
                'results': results(),
                'state': watcher.history[-1]['state'] if watcher.history else None,
            }
            run.checks['task_after_park'] = task_record(run)
            if proc.poll() is None:
                before = results()
                run.checks['continue_sent'] = time.time()
                send('continue')
                if not wait_until(lambda: proc.poll() is not None or results() > before, 300, 1):
                    run.notes.append('resume: no result within 5 min of continue')
                wait_until(lambda: proc.poll() is not None or quiet(10), 120, 1)
            else:
                run.notes.append(f'claude exited (status {proc.returncode}) before continue')
            stdin.close()
            try:
                proc.wait(timeout=60)
            except subprocess.TimeoutExpired:
                run.notes.append('claude did not exit within 60 s of end of input; terminated')
                os.killpg(proc.pid, signal.SIGTERM)
                proc.wait(timeout=10)
    finally:
        if proc is not None and proc.poll() is None:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except OSError:
                pass
        watcher.stop.set()
        watcher.join(timeout=5)
        run.checks['reaped'] = reap(run)
    wall = round(time.time() - start, 1)
    shape = [c if c != str(settings) else '<run>/settings.json' for c in command]
    shape = ['<session id>' if c == sid else c for c in shape]
    # total_cost_usd is the session's running total, so the last result holds the run's cost.
    cost = max((e.get('total_cost_usd') or 0 for e in stream_events(stream) if e.get('type') == 'result'), default=0)
    run.runs.append({'command': shape, 'exit': proc.returncode if proc else None, 'wall_s': wall,
                     'cost_usd': round(cost, 4), 'stdin': ['<scripted prompt>', 'continue']})


