#!/usr/bin/env -S python3 -S
"""turn-pause: hq's turn-pause hook for Claude Code and Codex.

    turn-pause --harness claude-code|codex [--limits PATH] EVENT  < native hook payload

Prints at most one JSON object and exits 0. A PreToolUse it cannot judge is refused; no
other event is ever blocked. --limits is for tests and isolated runs only: the live
wiring never passes it. Python runs with -S (no site): the hook needs only the
standard library, and site costs several milliseconds a call. Spec: docs/specs/2026-11-01-turn-pause-design.md.
"""
import os
import sys

try:
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    from turn_pause.hook import main
except BaseException as error:  # a broken install must neither let a call through nor block a Stop
    import json
    if sys.argv[-1:] == ['PreToolUse']:
        print(json.dumps({'hookSpecificOutput': {
            'hookEventName': 'PreToolUse', 'permissionDecision': 'deny',
            'permissionDecisionReason': f'turn-pause cannot load, so this call is refused: {error!r}'}}))
    else:
        print(f'turn-pause: cannot load: {error!r}', file=sys.stderr)
    sys.exit(0)

sys.exit(main(sys.argv[1:]))
