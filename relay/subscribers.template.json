{
  "schema": 1,
  "subscribers": [
    {
      "name": "ops-guard",
      "role": "guard",
      "harnesses": ["claude-code", "codex", "agy"],
      "kinds": ["before-tool"],
      "tools": ["Bash"],
      "argv": ["/usr/bin/python3", "@HOME@/d/ops/hooks/relay-guard"],
      "timeoutMs": 30000
    },
    {
      "name": "familiar",
      "role": "observer",
      "harnesses": ["claude-code", "codex"],
      "kinds": [
        "session-start",
        "prompt",
        "before-tool",
        "activity",
        "idle",
        "needs-input",
        "needs-approval",
        "turn-end",
        "turn-error",
        "reconcile"
      ],
      "argv": ["@HOME@/d/familiar/bin/familiar", "observe"],
      "timeoutMs": 2000
    },
    {
      "name": "familiar-opencode",
      "role": "observer",
      "harnesses": ["opencode"],
      "kinds": [
        "session-start",
        "activity",
        "idle",
        "needs-approval",
        "turn-error",
        "session-end"
      ],
      "argv": ["@HOME@/d/familiar/bin/familiar", "observe"],
      "timeoutMs": 1000
    },
    {
      "name": "familiar-teardown",
      "role": "observer",
      "harnesses": ["claude-code"],
      "kinds": ["session-end"],
      "argv": ["@HOME@/d/familiar/bin/familiar", "observe"],
      "timeoutMs": 400
    },
    {
      "name": "familiar-teardown-codex",
      "role": "observer",
      "harnesses": ["codex"],
      "kinds": ["session-end"],
      "argv": ["@HOME@/d/familiar/bin/familiar", "observe"],
      "timeoutMs": 267
    },
    {
      "name": "familiar-agy",
      "role": "observer",
      "harnesses": ["agy"],
      "kinds": ["session-start", "before-tool", "turn-end"],
      "argv": ["@HOME@/d/familiar/bin/familiar", "observe"],
      "timeoutMs": 2000
    }
  ]
}
