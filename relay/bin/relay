#!/usr/bin/env bash
set -euo pipefail
pin="$(dirname "$(readlink -f "$0")")/.."
version=$(/usr/bin/node -p 'require(process.argv[1]).dependencies.relay.split("#")[1]' "$pin/package.json")
rel="$version/node_modules/relay/bin/relay.js"
if [[ -n ${RELAY_INSTALL_ROOT:-} ]]; then
    runtime="$RELAY_INSTALL_ROOT/$rel"
elif [[ -f "$HOME/.local/share/relay/$rel" ]]; then
    runtime="$HOME/.local/share/relay/$rel"
else
    real_home=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6 || true)
    if [[ -n $real_home && -f "$real_home/.local/share/relay/$rel" ]]; then
        runtime="$real_home/.local/share/relay/$rel"
    else
        runtime="$HOME/.local/share/relay/$rel"
    fi
fi
if [[ ! -f $runtime ]]; then
    echo "relay $version is not installed: run just relay-install in the hq checkout" >&2
    exit 127
fi
exec /usr/bin/node "$runtime" "$@"
