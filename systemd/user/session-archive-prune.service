# Design: docs/specs/2026-09-30-session-archive-design.md, in the repository that holds this unit.
[Unit]
Description=Prune archived, inactive agent sessions (dry run until the rollout gate)

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/.local/bin/session-archive prune
Nice=10
IOSchedulingClass=idle
