# Design: docs/specs/2026-11-07-session-archive-replica-design.md, in the repository that holds this unit.
[Unit]
Description=Copy the session archive into a verified generation on the replica disk

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/.local/bin/session-archive replicate
Nice=10
IOSchedulingClass=idle
