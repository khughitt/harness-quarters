#!/usr/bin/env python3
"""Keep Codex project trust across git commands that overwrite codex/config.toml.

The harness-state clean filter keeps Codex's [projects."<path>"] trust tables out of
the index, so a git command that writes a new blob of codex/config.toml over the live
file drops them. This tool saves them in local/codex/trust.toml, untracked and carried
between hosts by Dropbox, and puts back the ones a checkout dropped:

    capture       merge the live file's trust tables into the saved copy
    restore       insert each saved table whose project the live file lacks
    sync          capture, then restore
    forget <path> delete a project's table from both files
    hook <name>   restore from a git hook, then restage the file

capture never removes a saved table: a dropped list must not shrink the saved one, and
nothing prunes it; forget is the one way a table leaves. The saved copy is machine-owned:
capture writes it whole from the tables, so a comment added by hand is lost. restore
inserts before the live file's first table header, which leaves the filter's output,
and so what git stages, unchanged. The Stop hook harness-state-refresh runs sync; the
post-checkout, post-merge and post-rewrite hooks run hook, which skips a linked worktree
silently and, from post-checkout, a rebase in progress. A hook reports a failure on stderr
and exits 0: git ends a checkout with the hook's status, and a switch that worked must not
exit 1. The next turn end retries. restore also takes group and other access off the live
file: a checkout writes it with the umask's mode, and Codex's config is private.
Every operation holds local/harness-state.lock, the host lock live-picks also takes. The tool works on the checkout
it lives in and refuses a linked worktree, whose codex/config.toml is not live. Design:
docs/specs/2026-09-29-codex-trust-restore-design.md.
"""
import contextlib
import os
import runpy
import sys
import tomllib

import harness_state

CHECKOUT = harness_state.Checkout("codex-trust")
HERE = harness_state.HERE
REPO = harness_state.REPO
LIVE_NAME = "codex/config.toml"
SAVED_NAME = "local/codex/trust.toml"
LIVE = REPO / LIVE_NAME
SAVED = REPO / SAVED_NAME
USAGE = ("usage: codex-trust capture | restore | sync | forget <project path> | "
         "hook post-checkout|post-merge|post-rewrite")
# The filter decides what a checkout drops; reading its patterns keeps the saved tables
# exactly the dropped ones.
FILTER = runpy.run_path(str(HERE / "harness-state-clean"))
TOML_HEADER = FILTER["TOML_HEADER"]
PROJECT_TRUST = FILTER["PROJECT_TRUST"]
CLEAN_TOML = FILTER["clean_toml"]
fail = CHECKOUT.fail
git = CHECKOUT.git
git_path = CHECKOUT.git_path
linked_worktree = CHECKOUT.linked_worktree


def parse(text, name):
    try:
        return tomllib.loads(text)
    except tomllib.TOMLDecodeError as error:
        fail(f"{name} is not valid TOML: {error}")


def trust_tables(text, name):
    """The [projects."<path>"] tables in text, as {path: table text} in file order.

    A table runs from its header to the next header, trailing blank lines dropped. Trust
    written any other way (an inline table, dotted keys) is refused: the filter would
    not drop it, and restore could not put it back.
    """
    blocks = []
    for line in text.splitlines(keepends=True):
        header = TOML_HEADER.match(line)
        if header:
            blocks.append([line] if PROJECT_TRUST.fullmatch(header.group(1)) else None)
        elif blocks and blocks[-1] is not None:
            blocks[-1].append(line)
    tables = {}
    for block in (block for block in blocks if block is not None):
        table = "".join(block).rstrip("\n") + "\n"
        paths = list(parse(table, name).get("projects", {}))
        if len(paths) != 1:
            fail(f"{name}: {block[0].strip()} does not name one project")
        if paths[0] in tables:
            fail(f"{name}: project {paths[0]!r} has more than one table")
        tables[paths[0]] = table
    if set(parse(text, name).get("projects", {})) != set(tables):
        fail(f'{name} declares project trust outside [projects."<path>"] tables')
    return tables


def render(tables):
    """Table texts separated by one blank line."""
    return "\n".join(tables)


def read_saved():
    if not SAVED.exists():
        return {}
    text = SAVED.read_text()
    other = set(parse(text, SAVED_NAME)) - {"projects"}
    if other:
        fail(f"{SAVED_NAME} holds more than project trust: {', '.join(sorted(other))}")
    return trust_tables(text, SAVED_NAME)
write = harness_state.write


def placements(live, tables):
    """live with tables before each header-like line in turn, then at its end.

    The filter drops everything from a trust header to the next header, so tables
    inserted before a header, with the blank line that ends them, leave its output
    unchanged. Text appended after the last table would not: the blank line before it is
    kept. A header-like line can sit inside a multi-line string, so restore takes the
    first placement that keeps every value. A file with no header and no final newline
    is refused: the newline a table needs before it would change what git stages.
    """
    offset = 0
    for line in live.splitlines(keepends=True):
        if TOML_HEADER.match(line):
            yield live[:offset] + tables + "\n" + live[offset:]
        offset += len(line)
    if live and not live.endswith("\n"):
        fail(f"{LIVE_NAME} has no table header and no final newline; add the newline")
    yield live + tables


def loads(text):
    try:
        return tomllib.loads(text)
    except tomllib.TOMLDecodeError:
        return None


def capture():
    merged = read_saved() | trust_tables(LIVE.read_text(), LIVE_NAME)
    text = render(merged.values())
    if text != (SAVED.read_text() if SAVED.exists() else ""):
        write(SAVED, text)


def keep_private():
    """Take group and other access off the live file, which git rewrites with the umask's mode."""
    target = LIVE.resolve()
    mode = target.stat().st_mode & 0o7777
    if mode & 0o077:
        os.chmod(target, mode & ~0o077)


def restore():
    """Insert the saved tables the live file lacks; True when it wrote."""
    keep_private()
    live = LIVE.read_text()
    present = trust_tables(live, LIVE_NAME)
    missing = [table for path, table in read_saved().items() if path not in present]
    if not missing:
        return False
    tables = render(missing)
    want = parse(live, LIVE_NAME)
    want.setdefault("projects", {}).update(parse(tables, SAVED_NAME)["projects"])
    for result in placements(live, tables):
        if loads(result) == want and CLEAN_TOML(result) == CLEAN_TOML(live):
            write(LIVE.resolve(), result)
            return True
    fail(f"found no place in {LIVE_NAME} for the saved tables that keeps its values and "
         "what git stages; nothing written")


def without_table(text, project):
    """text without the [projects."<project>"] table, its header through the next header."""
    kept, skipping = [], False
    for line in text.splitlines(keepends=True):
        header = TOML_HEADER.match(line)
        if header:
            skipping = (PROJECT_TRUST.fullmatch(header.group(1)) is not None
                        and project in parse(line, LIVE_NAME).get("projects", {}))
        if not skipping:
            kept.append(line)
    return "".join(kept)


def forget(project):
    """Delete a project's table from the saved copy and the live file, under one lock."""
    tables = read_saved()
    live = LIVE.read_text()
    in_live = project in trust_tables(live, LIVE_NAME)
    if project not in tables and not in_live:
        fail(f"no trust for {project!r} in {SAVED_NAME} or {LIVE_NAME}")
    if in_live:
        result = without_table(live, project)
        if CLEAN_TOML(result) != CLEAN_TOML(live) or project in trust_tables(result, LIVE_NAME):
            fail(f"could not remove {project!r} from {LIVE_NAME} without changing what git "
                 "stages; nothing written")
        write(LIVE.resolve(), result)
    if project in tables:
        del tables[project]
        write(SAVED, render(tables.values()))
    restage()


def restage():
    CHECKOUT.restage(LIVE_NAME)
rebasing = CHECKOUT.rebasing


@contextlib.contextmanager
def locked():
    """Hold the host lock live-picks shares: both rewrite codex/config.toml."""
    if not SAVED.parent.is_dir():
        fail("local/codex/ is missing; run `just setup`")
    if not LIVE.is_file():
        fail(f"{LIVE_NAME} is missing")
    with CHECKOUT.locked():
        yield


def main(argv):
    args = argv[1:]
    if not (len(args) == 1 and args[0] in ("capture", "restore", "sync")
            or len(args) == 2 and args[0] in ("forget", "hook")
            and (args[0] == "forget" or args[1] in harness_state.GIT_HOOKS)):
        fail(USAGE)
    if linked_worktree():
        if args[0] == "hook":
            return
        fail(f"{REPO} is a linked worktree; its {LIVE_NAME} is not live")
    if args[0] == "hook":
        if args[1] == "post-checkout" and rebasing():
            return
        try:
            with locked():
                if restore():
                    restage()
        except SystemExit as error:
            print(f"{error}\ncodex-trust: trust not restored; the next turn end retries",
                  file=sys.stderr)
        return
    with locked():
        if args[0] == "forget":
            forget(args[1])
            return
        if args[0] in ("capture", "sync"):
            capture()
        if args[0] in ("restore", "sync"):
            restore()


if __name__ == "__main__":
    main(sys.argv)
