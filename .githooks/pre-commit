#!/usr/bin/env python3
"""Run the shared hygiene checks, check the residue guide and refuse staged local/ host state.

The generated global-instruction block is checked by lore tools/check-projects-block.
After refusing every staged path under local/, this hook runs the vendored tools/ops-check
(guide references, layout, vendored contracts) and then the vendored tools/ops-docs, both
against the working tree as they read it everywhere, preserving the README/AGENTS identity
contract.
The staged tools/harness-facts must pass its own check over the staged tree.
Installed by git config core.hooksPath .githooks.
"""
import os
import pathlib
import shutil
import subprocess
import sys
import tempfile


def fail(message):
    sys.stderr.write(f"pre-commit: {message}\n")
    return 1


DOCS = pathlib.Path("tools") / "ops-docs"
HYGIENE = pathlib.Path("tools") / "ops-check"


def hygiene_check():
    """The shared hygiene checks, read from the working tree as ops-check reads it everywhere.
    Exit 1 is findings; any other failure means the checker could not run, never a pass."""
    if not HYGIENE.is_file():
        return fail(f"{HYGIENE} not found; adopt it from ops with `bin/vendored adopt ops-check`")
    done = subprocess.run([sys.executable, str(HYGIENE)], text=True, capture_output=True)
    if done.returncode == 1:
        sys.stderr.write(done.stderr)
        return fail("the shared hygiene checks found the findings above in the working tree; "
                    "fix them (AGENTS.md Gates)")
    if done.returncode:
        sys.stderr.write(done.stderr)
        return fail(f"{HYGIENE} could not run (exit {done.returncode})")
    return 0


def docs_check():
    """The guide contract, read from the working tree as ops-docs reads it everywhere."""
    if not DOCS.is_file():
        return fail(f"{DOCS} not found; it is vendored from ops bin/ops-docs")
    done = subprocess.run([sys.executable, str(DOCS), "check"], text=True, capture_output=True)
    if done.returncode:
        sys.stderr.write(done.stderr)
        return fail(f"{DOCS} check failed; run `just docs`, or fix identity.toml")
    return 0


def local_layer():
    """local/ holds host and work state that must never be tracked; only `git add -f`
    can stage it, and this refuses that."""
    names = subprocess.run(["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR",
                            "--", "local"], check=True, text=True, capture_output=True).stdout.split()
    if names:
        return fail("staged paths under local/, which is untracked host and work state: "
                    + ", ".join(names) + "; unstage them with `git restore --staged`")
    return 0


FACTS = "facts/capabilities.toml"
FACTS_TOOL = pathlib.Path("tools") / "harness-facts"


def git(*args, env=None):
    return subprocess.run(["git", *args], check=True, text=True, capture_output=True, env=env).stdout.strip()


def staged_tree(directory):
    """Write the tree this commit will hold into directory/tree. It goes through
    write-tree and a fresh index, so intent-to-add entries, which the commit leaves out,
    stay out, and skip-worktree or sparse entries, which it keeps, come along. It works
    on a copy of the index being committed, so it neither takes nor waits on that
    index's lock."""
    index = os.path.join(directory, "index")
    shutil.copyfile(git("rev-parse", "--git-path", "index"), index)   # honours GIT_INDEX_FILE
    env = {**os.environ, "GIT_INDEX_FILE": index}
    git("read-tree", git("write-tree", env=env), env=env)
    git("checkout-index", "--all", f"--prefix={directory}/tree/", env=env)
    return pathlib.Path(directory) / "tree"


def facts_check():
    """The staged reader must pass its own check over the staged tree, at its own default
    path. A blob check of the fact file alone misses a file deleted or renamed away, a
    reader whose default moved without the file, and a deleted probe; a move that updates
    the reader in the same commit passes."""
    with tempfile.TemporaryDirectory(prefix="staged-tree-") as directory:
        try:
            tree = staged_tree(os.path.realpath(directory))     # the reader names resolved paths
        except subprocess.CalledProcessError as error:
            return fail(f"could not export the staged tree: `{' '.join(error.cmd)}`: {error.stderr.strip()}")
        tool = tree / FACTS_TOOL
        if not tool.is_file():
            return fail(f"{FACTS_TOOL} is not staged; this commit would leave the fact file without its reader")
        done = subprocess.run([sys.executable, str(tool), "check"], text=True, capture_output=True)
        if done.returncode:
            sys.stderr.write(done.stderr.replace(f"{tree}/", ""))
            return fail(f"the staged tree does not pass its own `{FACTS_TOOL} check`; fix what it "
                        f"names, and if {FACTS} moved, stage the reader's default with it")
    return 0


def main(argv):
    if argv:
        return fail("pre-commit accepts no arguments")
    return local_layer() or hygiene_check() or docs_check() or facts_check()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
