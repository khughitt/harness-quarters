#!/usr/bin/env python3
"""Check the residue guide and refuse staged local/ host state.

The generated global-instruction block is checked by lore tools/check-projects-block.
This hook runs the vendored tools/ops-docs against the working tree, preserving the
README/AGENTS identity contract, and rejects every staged path under local/.
A staged facts/capabilities.toml is validated as staged and, until the claim guard reads
the facts itself, checked against ops's constants by ops's own test.
Installed by git config core.hooksPath .githooks.
"""
import os
import pathlib
import shutil
import signal
import subprocess
import sys
import tempfile
import tomllib


def fail(message):
    sys.stderr.write(f"pre-commit: {message}\n")
    return 1


DOCS = pathlib.Path("tools") / "ops-docs"


def docs_check():
    """The guide contract, read from the working tree as ops-docs reads it everywhere."""
    if not DOCS.is_file():
        return fail(f"{DOCS} not found; it is vendored from ops bin/ops-docs")
    done = subprocess.run([sys.executable, str(DOCS), "check"], text=True, capture_output=True)
    if done.returncode:
        sys.stderr.write(done.stderr)
        return fail(f"{DOCS} check failed; run `just docs`, or fix identity.toml")
    return 0


def local_layer():
    """local/ holds host and work state that must never be tracked; only `git add -f`
    can stage it, and this refuses that."""
    names = subprocess.run(["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR",
                            "--", "local"], check=True, text=True, capture_output=True).stdout.split()
    if names:
        return fail("staged paths under local/, which is untracked host and work state: "
                    + ", ".join(names) + "; unstage them with `git restore --staged`")
    return 0


FACTS = "facts/capabilities.toml"
FACTS_TOOL = pathlib.Path("tools") / "harness-facts"


def facts_blob():
    """The staged fact file, written to a temporary file; None when it is not staged."""
    names = subprocess.run(["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR", "--", FACTS],
                           check=True, text=True, capture_output=True).stdout.split()
    if not names:
        return None
    blob = subprocess.run(["git", "show", f":{FACTS}"], check=True, capture_output=True).stdout
    handle = tempfile.NamedTemporaryFile(prefix="capabilities-", suffix=".toml", delete=False)
    with handle:
        handle.write(blob)
    return pathlib.Path(handle.name)


MIRROR_TEST = "tests.test_claim_guard.FactsMirrorTests"
MIRROR_TIMEOUT = 300   # seconds; the run takes well under one


def ops_root():
    """The ops checkout whose guard holds the constants: FACTS_MIRROR_OPS (a worktree, when
    a value change lands as a pair), else the registered one; None when neither is named."""
    named = os.environ.get("FACTS_MIRROR_OPS")
    if named:
        return pathlib.Path(named)
    registry = pathlib.Path(os.environ.get("XDG_CONFIG_HOME") or pathlib.Path.home() / ".config") / "tasks" / "projects.toml"
    roots = tomllib.loads(registry.read_text()).get("projects", {}) if registry.is_file() else {}
    return pathlib.Path(os.path.expanduser(roots["ops"])) if isinstance(roots.get("ops"), str) else None


def mirror(candidate):
    """ops's own test of its constants against this fact file. Interim: deleted with the
    constants (docs/specs/2026-10-06-residue-design.md §4.7)."""
    ops = ops_root()
    named = os.environ.get("FACTS_MIRROR_OPS")
    if named and not (ops / "tests" / "test_claim_guard.py").is_file():
        # Named for a value change landing as a pair: a typo must not skip the check.
        return fail(f"FACTS_MIRROR_OPS={named} is not an ops checkout (no tests/test_claim_guard.py there)")
    if ops is None or not ops.is_dir() or shutil.which("just") is None:
        sys.stderr.write("pre-commit: no ops checkout to ask (unregistered, missing, or `just` absent); "
                         "the claim-guard mirror was not checked\n")
        return 0
    # git exports this commit's GIT_DIR and index file to a hook. ops's recipes run git, and
    # must run it against ops.
    env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
    env.update(HARNESS_FACTS_TOOL=str(FACTS_TOOL.resolve()), HARNESS_FACTS_FILE=str(candidate))
    run = subprocess.Popen(["just", "test-one", MIRROR_TEST], cwd=ops, env=env, text=True,
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
    try:
        out, err = run.communicate(timeout=MIRROR_TIMEOUT)
    except subprocess.TimeoutExpired:
        os.killpg(run.pid, signal.SIGKILL)   # just and everything it started
        run.communicate()
        return fail(f"the claim-guard mirror in {ops} timed out after {MIRROR_TIMEOUT} s")
    if run.returncode:
        sys.stderr.write((out + err)[-2000:])
        return fail(f"{FACTS} disagrees with, or could not be tested against, claim-guard's constants in {ops}; change them as a pair "
                    "(README.md, Capability facts), naming an ops worktree with FACTS_MIRROR_OPS")
    return 0


def facts_check():
    """A staged fact file must pass harness-facts as staged."""
    blob = facts_blob()
    if blob is None:
        return 0
    try:
        done = subprocess.run([sys.executable, str(FACTS_TOOL), "check", "--file", str(blob)], text=True, capture_output=True)
        if done.returncode:
            sys.stderr.write(done.stderr)
            return fail(f"{FACTS} as staged does not pass `{FACTS_TOOL} check`")
        return mirror(blob)
    finally:
        blob.unlink()


def main(argv):
    if argv == ["facts-mirror"]:
        return mirror(pathlib.Path(FACTS).resolve())
    return local_layer() or docs_check() or facts_check()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
