#!/usr/bin/env python3
"""Refuse a commit whose staged AGENTS.md carries a hand-edited projects block.

The block between the ops:projects markers is generated by `ops-projects` in the ops
checkout from identity-mirror.toml there; edits belong in that file, applied with
`just projects` in ops. This hook renders the block through the registered ops
checkout and compares it with what is staged — the staged content, not the working
tree, is what the commit records. Installed by `git config core.hooksPath .githooks`.

It also runs the vendored `tools/ops-docs check` on every commit: the identity regions
in README.md and AGENTS.md are generated from identity.toml (`just docs`), and the
README follows the guide contract. ops's docs/specs/2026-09-22-project-guides-design.md.

It refuses any staged path under local/, the untracked layer
(docs/specs/2026-09-28-local-layer-design.md).
"""
import difflib
import os
import pathlib
import subprocess
import sys
import tomllib

MARK_START = "<!-- ops:projects start — generated by ops-projects; edit identity-mirror.toml in ops -->"
PREVIOUS_MARK_START = "<!-- ops:projects start — generated by ops-projects; edit identity.toml in ops -->"
MARK_END = "<!-- ops:projects end -->"
TARGET = "AGENTS.md"


def fail(message):
    sys.stderr.write(f"pre-commit: {message}\n")
    return 1


def ops_root():
    config = pathlib.Path(os.environ.get("XDG_CONFIG_HOME") or pathlib.Path.home() / ".config")
    path = config / "tasks" / "projects.toml"
    if not path.is_file():
        raise LookupError(f"{path} is missing; the tasks registry locates the ops checkout")
    roots = tomllib.loads(path.read_text()).get("projects", {})
    if "ops" not in roots:
        raise LookupError("ops is not a registered project; run `tasks init` in the ops checkout")
    return pathlib.Path(os.path.expanduser(roots["ops"]))


def staged(path):
    """The staged content of `path`; None when it is not part of this commit.

    A staged deletion (or the old side of a rename) is listed by `--name-only` but has
    no index entry to show, so it raises rather than being mistaken for "not staged"."""
    names = subprocess.run(["git", "diff", "--cached", "--name-only", "--", path],
                           check=True, text=True, capture_output=True).stdout.split()
    if not names:
        return None
    shown = subprocess.run(["git", "show", f":{path}"], text=True, capture_output=True)
    if shown.returncode:
        raise LookupError(f"{path} is staged for deletion or rename; the generated block must stay")
    return shown.stdout


def projects_block():
    try:
        text = staged(TARGET)
    except LookupError as error:
        return fail(str(error))
    if text is None:
        return 0
    try:
        ops = ops_root()
    except LookupError as error:
        return fail(str(error))
    tool = ops / "bin" / "ops-projects"
    if not tool.is_file():
        return fail(f"{tool} not found; the registered ops checkout has no ops-projects")
    rendered = subprocess.run([sys.executable, str(tool), "render"], cwd=ops, text=True,
                              capture_output=True)
    if rendered.returncode:
        return fail(f"ops-projects render failed:\n{rendered.stderr.rstrip()}")
    start, end = text.find(MARK_START), text.find(MARK_END)
    if start < 0 or end < 0 or end < start:
        return fail(f"staged {TARGET} has no ops:projects markers; the generated block must stay")
    current = text[start:end + len(MARK_END)]
    expected = rendered.stdout.rstrip("\n")
    if current == expected or current == expected.replace(PREVIOUS_MARK_START, MARK_START, 1):
        return 0
    diff = difflib.unified_diff(expected.splitlines(), current.splitlines(),
                                "ops-projects render", f"staged {TARGET}", lineterm="")
    sys.stderr.write("\n".join(diff) + "\n")
    return fail("the projects block in staged AGENTS.md differs from ops-projects render — either "
                "it was edited by hand, or identity-mirror.toml in ops changed and `just projects` has not "
                "been run here; edit identity-mirror.toml in ops and run `just projects` there")


DOCS = pathlib.Path("tools") / "ops-docs"


def docs_check():
    """The guide contract, read from the working tree as ops-docs reads it everywhere."""
    if not DOCS.is_file():
        return fail(f"{DOCS} not found; it is vendored from ops bin/ops-docs")
    done = subprocess.run([sys.executable, str(DOCS), "check"], text=True, capture_output=True)
    if done.returncode:
        sys.stderr.write(done.stderr)
        return fail(f"{DOCS} check failed; run `just docs`, or fix identity.toml")
    return 0


def local_layer():
    """local/ holds host and work state that must never be tracked; only `git add -f`
    can stage it, and this refuses that."""
    names = subprocess.run(["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR",
                            "--", "local"], check=True, text=True, capture_output=True).stdout.split()
    if names:
        return fail("staged paths under local/, which is untracked host and work state: "
                    + ", ".join(names) + "; unstage them with `git restore --staged`")
    return 0


def main():
    return local_layer() or projects_block() or docs_check()


if __name__ == "__main__":
    sys.exit(main())
