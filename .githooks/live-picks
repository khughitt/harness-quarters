#!/usr/bin/env python3
"""Keep the model and effort picks in the live harness configs across git commands that drop them.

The harness-state clean filter keeps the picks out of the index. Which config each
harness picks in, the keys its pickers write, how they group into units and which
record under local/ saves them come from harnesses.toml (`[harnesses.<name>.live_state]`
entries with `picks_record` and `pick_units`): today Claude's `model`, `modelSettings`
and `effortLevel` in claude/settings.json and the top-level `model` and
`model_reasoning_effort` in codex/config.toml, saved in local/live-picks.json; pi's
`defaultProvider`, `defaultModel` and `defaultThinkingLevel` in pi/settings.json, saved in
local/live-picks-pi.json; agy's `model`, `effort`, `effortByBase`, `trustedWorkspaces` and
`seasonalThemesOptIn` in agy/settings.json, saved in local/live-picks-agy.json. A git command that writes a new
blob of a file over the live one drops the pick, and the harness runs on its default.
The records are untracked and carried between hosts by Dropbox; this tool puts the
picks back:

    capture               save the pick each file holds; absence never records a reset
    restore               put a saved pick into a file holding none of its fields
    sync                  capture, then restore
    first-run             adopt agy's first-run home file before its anchors are linked
    forget <file>         record the file's default and remove its pick from the file
    hook <name>           restore from a git hook, then restage what it wrote

Each picker's owned fields are one unit (`pick_units`): Codex's model and effort; Claude's
model and modelSettings (/model), and its effortLevel (/effort); pi's defaultProvider and
defaultModel, and its defaultThinkingLevel; agy's model (/model), effort and effortByBase
(/effort), trustedWorkspaces, and seasonalThemesOptIn. Each separate picker writes one unit. Keys the filter
drops that no picker owns (`unrestored_keys`, such as pi's installation ids) are neither
saved nor restored, and forget leaves them in the file. An entry with no `picks_record`
is the filter's alone: live-picks skips it.
Git drops all of a file's fields together, so a unit holding none is the only state a
git rewrite leaves; any other state was written by a harness or a person, and the live
file wins. Absence alone cannot tell a rewrite from a return to
the default, so only forget records `default`. Claude, Codex and agy capture at Stop; pi
captures through its extension after picker events, at turn end and at shutdown.
Because agy saves `~/.gemini/antigravity-cli/settings.json` by atomic rename over the
home link when persisting picks or `/config` edits, an anchored host whose
`~/.gemini/config` links point into this checkout also reads any regular file there
during capture and adopts it back into `agy/settings.json`, restoring the symlink on
restore, hook and forget. A host not anchored yet can hold a first-run file agy wrote
before this checkout linked its home: it never held the tracked config, so `first-run`
(run by `tools/harness-links --apply` before it links the anchors) keeps
`agy/settings.json` as the base, refuses any key outside the live state that the config
does not already hold, takes the pick units only that file holds, adds its new list items
to a held list pick (trustedWorkspaces), and relinks. It refuses while agy runs, since a
session still holding the first-run settings would save them over the new link.
Setting the current selection as a default emits no event: it is saved at turn end
or exit, so a git rewrite before then restores the previous saved default. restore
fills only units holding none of their fields, so a newer pick is never overwritten, and
capture replaces only the units the file holds, so a pick of one picker keeps the
other's saved value; a saved pick lists its units in declaration order. forget resets
every unit of the file. A TOML pick is one-line top-level keys, which restore prepends,
and writes happen only when the result parses to the live values plus the saved ones
and the filter's output, what git stages, is unchanged.

Each record is machine-owned and written whole only when changed; an invalid one is
refused independently, never overwritten. A file that cannot be read is refused alone.
harnesses.toml is read after the argument and worktree checks and before the host
lock, local/harness-state.lock, which every operation holds and codex-trust also takes.
A hook reports a failure, a broken harnesses.toml included, on stderr and exits 0, and
skips a linked worktree silently and, from post-checkout, a rebase in progress; the next
turn end retries. Every other operation refuses a linked worktree, whose configs are not
live, and a broken harnesses.toml. Design:
docs/specs/2026-10-10-live-model-preservation-design.md, extended by
docs/specs/2026-10-15-pi-live-picks-design.md and
docs/specs/2026-11-01-harness-manifest-design.md §5.3.
"""
import json
import os
from pathlib import Path
import stat
import subprocess
import sys
import tomllib

try:
    import harness_state
    from harness_state import TOML_HEADER, TOML_KEY
except (ImportError, SyntaxError) as error:
    # A module that will not import (conflict markers after a merge) must not traceback.
    message = f"live-picks: cannot load .githooks/harness_state.py: {error}; resolve or restore it"
    if sys.argv[1:2] == ["hook"]:
        print(f"{message}\nlive-picks: a pick was not restored; the next turn end retries", file=sys.stderr)
        sys.exit(0)
    sys.exit(message)

CHECKOUT = harness_state.Checkout("live-picks")
fail = CHECKOUT.fail
REPO = harness_state.REPO
SYNOPSIS = ("usage: live-picks capture | restore | sync | first-run | forget <file> | "
            "hook post-checkout|post-merge|post-rewrite")
# The record field that holds a set pick, by config format.
FIELD = {"json": "values", "toml": "lines"}
# agy's home adoption: an anchored host's agy home link, replaced by a regular file.
AGY_CONFIG = "agy/settings.json"
AGY_HOME = Path(".gemini/antigravity-cli")
AGY_LINK = AGY_HOME / "settings.json"
AGY_ANCHORS = (
    (Path(".gemini/config/hooks.json"), Path("agy/hooks.json")),
    (Path(".gemini/config/skills.json"), Path("agy/skills.json")),
)


class Refused(Exception):
    """One file cannot be read or written; the others are still handled."""


def usage():
    """The synopsis, naming the files live-picks owns while harnesses.toml loads."""
    try:
        manifest = harness_state.load_manifest()
    except harness_state.ManifestError:
        return SYNOPSIS
    files = [spec.config for spec in manifest.live_state if spec.picks_record is not None]
    return f"{SYNOPSIS} (files: {', '.join(files)})"


def load_specs():
    """The live-state entries live-picks owns, by config path; exits on a broken manifest."""
    manifest = harness_state.load_manifest_or_exit("live-picks")
    return {spec.config: spec for spec in manifest.live_state if spec.picks_record is not None}


def field(spec):
    return FIELD[spec.format]


def parse(spec, text):
    try:
        data = json.loads(text) if spec.format == "json" else tomllib.loads(text)
    except (json.JSONDecodeError, tomllib.TOMLDecodeError) as error:
        raise Refused(f"{spec.config} does not parse: {error}")
    if not isinstance(data, dict):
        raise Refused(f"{spec.config} is not an object")
    return data


def key_of(line):
    key = TOML_KEY.match(line)
    return key.group(1) if key else None


def toml_lines(spec, text):
    """The owned key lines before the first table header, in file order."""
    lines = []
    for line in text.splitlines(keepends=True):
        if TOML_HEADER.match(line):
            break
        if key_of(line) in spec.pick_keys:
            lines.append(line if line.endswith("\n") else line + "\n")
    return lines


def toml_or_none(text):
    try:
        return tomllib.loads(text)
    except tomllib.TOMLDecodeError:
        return None


def lines_parse(spec, lines):
    """What lines parse to when they are duplicate-free owned one-line keys, else None."""
    keys = [key_of(line) for line in lines]
    text = "".join(lines)
    if len(keys) != len(set(keys)) or toml_lines(spec, text) != lines:
        return None
    return toml_or_none(text)


def pick(spec, text):
    """The owned fields text holds: JSON values or TOML lines; empty when none.

    A TOML pick the filter could not drop line by line (a multi-line value, a quoted
    key, a key after a header-like line) is refused.
    """
    data = parse(spec, text)
    if spec.format == "json":
        return {key: data[key] for key in spec.pick_keys if key in data}
    lines = toml_lines(spec, text)
    if lines_parse(spec, lines) != {key: data[key] for key in spec.pick_keys if key in data}:
        raise Refused(f"{spec.config}: write {' and '.join(spec.pick_keys)} as one-line keys "
                      "before the first table")
    return lines


def invalid(spec, saved):
    """Why a record entry for spec's config is malformed, or None."""
    if not isinstance(saved, dict) or saved.get("state") not in ("set", "default"):
        return 'state must be "set" or "default"'
    if saved["state"] == "default":
        return None if set(saved) == {"state"} else "a default entry holds only its state"
    if set(saved) != {"state", field(spec)}:
        return f'a set entry holds its state and "{field(spec)}"'
    held = saved[field(spec)]
    if spec.format == "json":
        if isinstance(held, dict) and held and set(held) <= set(spec.pick_keys):
            return None
        return f"values must name some of {', '.join(spec.pick_keys)}"
    if isinstance(held, list) and held and all(isinstance(line, str) for line in held):
        parsed = lines_parse(spec, held)
        if parsed is not None and set(parsed) <= set(spec.pick_keys):
            return None
    return f"lines must be one-line {' or '.join(spec.pick_keys)} keys, each once"


def read_record(record_name, specs):
    path = REPO / record_name
    if not path.exists():
        return {}
    try:
        record = json.loads(path.read_text())
    except json.JSONDecodeError as error:
        raise Refused(f"{record_name} is not valid JSON: {error}; fix or delete it") from None
    if not isinstance(record, dict):
        raise Refused(f"{record_name} is not an object; fix or delete it")
    for name, saved in record.items():
        spec = specs.get(name)
        problem = (invalid(spec, saved) if spec is not None and spec.picks_record == record_name
                   else "not a file this record owns")
        if problem:
            raise Refused(f"{record_name}: {name}: {problem}; fix or delete it")
    return record


def read_records(specs):
    records, refusals = {}, []
    for record_name in dict.fromkeys(spec.picks_record for spec in specs.values()):
        try:
            records[record_name] = read_record(record_name, specs)
        except Refused as error:
            refusals.append(str(error))
        except (OSError, UnicodeError) as error:
            refusals.append(f"{record_name}: {error}")
    return records, refusals


def write_record(record_name, record):
    path = REPO / record_name
    harness_state.write(path, json.dumps(record, indent=2, ensure_ascii=False) + "\n")


def read_text(path, label):
    try:
        if not path.is_file():
            raise Refused(f"{label} is missing")
        return path.read_text()
    except (OSError, UnicodeError) as error:
        raise Refused(f"{label} cannot be read: {error}") from None


def live(spec):
    return read_text(REPO / spec.config, spec.config)


def points_to(link, target):
    if not link.is_symlink() or not link.exists():
        return False
    try:
        actual = link.parent / os.readlink(link)
        return actual.parent.resolve() / actual.name == target.parent.resolve() / target.name
    except OSError:
        return False


def agy_anchored():
    home = Path.home()
    agy_dir = home / AGY_HOME
    if not (agy_dir.is_dir() and not agy_dir.is_symlink()):
        return False
    return any(points_to(home / link, REPO / target) for link, target in AGY_ANCHORS)


def detached_home(spec):
    """A regular file that replaced spec's home symlink on an anchored host, or None."""
    if spec.config != AGY_CONFIG or not agy_anchored():
        return None
    path = Path.home() / AGY_LINK
    try:
        mode = path.lstat().st_mode
    except FileNotFoundError:
        return None
    except OSError as error:
        raise Refused(f"{path} cannot be stat'd: {error}") from None
    if stat.S_ISLNK(mode):
        return None
    if not stat.S_ISREG(mode):
        raise Refused(f"{path} is not a regular file")
    return path


def relink_home(path, target):
    """Atomically replace a detached regular file at path with a symlink to target."""
    staging = path.with_name(f".{path.name}.live-picks.{os.getpid()}")
    try:
        staging.unlink(missing_ok=True)
        staging.symlink_to(target)
        if not stat.S_ISREG(path.lstat().st_mode):
            staging.unlink(missing_ok=True)
            raise Refused(f"{path} changed before relinking")
        os.replace(staging, path)
    except BaseException:
        staging.unlink(missing_ok=True)
        raise


def saved_pick(spec, saved):
    """The saved pick's values or lines; empty unless the entry is set."""
    if saved and saved["state"] == "set":
        return saved[field(spec)]
    return {} if spec.format == "json" else []


def merged_values(spec, saved, held):
    """JSON values to save: each unit the file holds, else the saved unit, in unit order."""
    saved = saved_pick(spec, saved)
    values = {}
    for unit in spec.pick_units:
        source = held if any(key in held for key in unit) else saved
        values.update({key: source[key] for key in unit if key in source})
    return values


def merged_lines(spec, saved, held):
    """TOML lines to save: each unit the file holds, else the saved unit, in unit order."""
    saved = saved_pick(spec, saved)
    lines = []
    for unit in spec.pick_units:
        source = held if any(key_of(line) in unit for line in held) else saved
        lines += [line for line in source if key_of(line) in unit]
    return lines


def merge_picks(spec, saved, held):
    return (merged_values if spec.format == "json" else merged_lines)(spec, saved, held)


def missing(spec, text, saved):
    """The saved pick for the units text holds none of; None when there is none."""
    held = pick(spec, text)
    if spec.format == "json":
        held_keys = set(held)
        wanted = {key: value for unit in spec.pick_units if not held_keys & set(unit)
                  for key, value in saved["values"].items() if key in unit}
    else:
        held_keys = {key_of(line) for line in held}
        wanted = [line for unit in spec.pick_units if not held_keys & set(unit)
                  for line in saved["lines"] if key_of(line) in unit]
    return {"state": "set", field(spec): wanted} if wanted else None


def capture(specs):
    """Save the pick each file holds; returns the refusals."""
    records, refusals = read_records(specs)
    updated = {path: dict(record) for path, record in records.items()}
    for name, spec in specs.items():
        record_name = spec.picks_record
        if record_name not in records:
            continue
        try:
            detached = detached_home(spec)
            source = read_text(detached, str(detached)) if detached is not None else live(spec)
            held = pick(spec, source)
        except Refused as error:
            refusals.append(str(error))
            continue
        if held:
            merged = merge_picks(spec, records[record_name].get(name), held)
            updated[record_name][name] = {"state": "set", field(spec): merged}
    for record_name, record in updated.items():
        if record != records[record_name]:
            try:
                write_record(record_name, record)
            except (OSError, UnicodeError) as error:
                refusals.append(f"{record_name}: {error}")
    return refusals


def checked(spec, text, result, want):
    """result, when it parses to want and the filter's output is text's; else refused."""
    try:
        got = parse(spec, result)
    except Refused:
        got = None
    if (got != want or harness_state.clean_for_spec(spec, result)
            != harness_state.clean_for_spec(spec, text)):
        raise Refused(f"found no way to change {spec.config} that keeps its other values and "
                      "what git stages; nothing written")
    return result


def with_pick(spec, text, saved):
    data = parse(spec, text)
    if spec.format == "json":
        want = {**data, **saved["values"]}
        result = json.dumps(want, indent=2, ensure_ascii=False) + "\n"
    else:
        want = {**data, **tomllib.loads("".join(saved["lines"]))}
        result = "".join(saved["lines"]) + text
    return checked(spec, text, result, want)


def without_pick(spec, text):
    """text without the pick keys; unrestored keys such as installation ids stay."""
    data = parse(spec, text)
    want = {key: value for key, value in data.items() if key not in spec.pick_keys}
    if spec.format == "json":
        result = json.dumps(want, indent=2, ensure_ascii=False) + "\n"
    else:
        kept, top = [], True
        for line in text.splitlines(keepends=True):
            top = top and not TOML_HEADER.match(line)
            if not (top and key_of(line) in spec.pick_keys):
                kept.append(line)
        result = "".join(kept)
    return checked(spec, text, result, want)


def adopt_detached(spec, detached, records, from_hook):
    """Sync a regular file that replaced spec's home symlink back into its config and relink."""
    name, record_name = spec.config, spec.picks_record
    h_text = read_text(detached, str(detached))
    r_text = live(spec)
    h_picks = pick(spec, h_text)
    r_picks = pick(spec, r_text)
    saved = records[record_name].get(name)
    merged = merge_picks(spec, saved, h_picks)
    repo_mtime = (REPO / name).stat().st_mtime_ns
    detached_mtime = detached.stat().st_mtime_ns
    git_rewrote_r = not r_picks and (
        repo_mtime >= detached_mtime if from_hook else repo_mtime > detached_mtime
    )
    base_text = r_text if git_rewrote_r else h_text
    clean_base = without_pick(spec, base_text)
    entry = {"state": "set", field(spec): merged}
    result = with_pick(spec, clean_base, entry) if merged else clean_base
    if merged and records[record_name].get(name) != entry:
        updated = {**records[record_name], name: entry}
        write_record(record_name, updated)
        records[record_name] = updated
    harness_state.write((REPO / name).resolve(), result)
    relink_home(detached, REPO / name)


def first_run_home(spec):
    """A first-run regular file at spec's home link on a host not yet anchored, or None.

    The harness wrote it before this checkout linked its home, so it never held the
    tracked config. An anchored host's regular file is a replaced link: `sync` adopts it.
    """
    if spec.config != AGY_CONFIG:
        return None
    home = Path.home()
    agy_dir = home / AGY_HOME
    if not (agy_dir.is_dir() and not agy_dir.is_symlink()):
        return None
    path = home / AGY_LINK
    try:
        mode = path.lstat().st_mode
    except FileNotFoundError:
        return None
    except OSError as error:
        raise Refused(f"{path} cannot be stat'd: {error}") from None
    if stat.S_ISLNK(mode):
        return None
    if not stat.S_ISREG(mode):
        raise Refused(f"{path} is not a regular file")
    if agy_anchored():
        raise Refused(f"{path}: the agy home is anchored, so this file replaced its link; "
                      "`live-picks sync` adopts it")
    refuse_running_agy(path)
    return path


def refuse_running_agy(path):
    """Refuse while agy runs: a session holding first-run settings in memory would save
    them over the new link, and once the anchors exist `sync` would adopt them as the base."""
    try:
        found = subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "agy"],
                               text=True, capture_output=True)
    except OSError as error:
        raise Refused(f"{path}: cannot check for a running agy (pgrep: {error}); nothing written") from None
    if found.returncode == 0:
        pids = ", ".join(found.stdout.split())
        raise Refused(f"{path}: agy is running (pid {pids}); quit every agy session, then rerun; "
                      "nothing written")
    if found.returncode != 1:
        raise Refused(f"{path}: cannot check for a running agy (pgrep exited {found.returncode}: "
                      f"{found.stderr.strip()}); nothing written")


def adopt_first_run(spec, path, records):
    """Merge a first-run file's picks into spec's config, keeping the config, and relink.

    Keys outside the live state must already match the config; any other key refuses,
    since adopting it would change the tracked config without a commit's review. A pick
    unit the checkout holds (in the file or the saved record) wins; a list value gains
    the first-run file's new items. Units only the first-run file holds are taken.
    """
    name, record_name = spec.config, spec.picks_record
    h_text = read_text(path, str(path))
    try:
        first = json.loads(h_text)
    except json.JSONDecodeError as error:
        raise Refused(f"{path} does not parse: {error}") from None
    if not isinstance(first, dict):
        raise Refused(f"{path} is not an object")
    r_text = live(spec)
    tracked = parse(spec, r_text)
    live_keys = set(spec.pick_keys) | set(spec.unrestored_keys)
    unlike = sorted(key for key in first
                    if key not in live_keys and (key not in tracked or tracked[key] != first[key]))
    if unlike:
        raise Refused(f"{path}: the first-run file sets {', '.join(unlike)} unlike {name}; set "
                      f"{'it' if len(unlike) == 1 else 'them'} in {name} or declare "
                      f"{'it' if len(unlike) == 1 else 'them'} live state in harnesses.toml; "
                      "nothing written")
    held = merge_picks(spec, records[record_name].get(name), pick(spec, r_text))
    merged = {}
    for unit in spec.pick_units:
        if any(key in held for key in unit):
            for key in unit:
                if key not in held:
                    continue
                value = held[key]
                if isinstance(value, list) and isinstance(first.get(key), list):
                    value = value + [item for item in first[key] if item not in value]
                merged[key] = value
        else:
            merged.update({key: first[key] for key in unit if key in first})
    clean_base = without_pick(spec, r_text)
    entry = {"state": "set", "values": merged}
    result = with_pick(spec, clean_base, entry) if merged else clean_base
    if merged and records[record_name].get(name) != entry:
        updated = {**records[record_name], name: entry}
        write_record(record_name, updated)
        records[record_name] = updated
    harness_state.write((REPO / name).resolve(), result)
    relink_home(path, REPO / name)


def first_run(specs):
    """Adopt each first-run home file; returns the files written and the refusals."""
    records, refusals = read_records(specs)
    written = []
    for name, spec in specs.items():
        if spec.picks_record not in records:
            continue
        try:
            path = first_run_home(spec)
            if path is None:
                continue
            adopt_first_run(spec, path, records)
        except Refused as error:
            refusals.append(str(error))
            continue
        except (OSError, UnicodeError) as error:
            refusals.append(f"{name}: {error}")
            continue
        written.append(name)
    return written, refusals


def restore(specs, from_hook=False):
    """Put each saved pick into a file holding none of its fields (per picker unit).

    Returns the files written and the refusals.
    """
    records, refusals = read_records(specs)
    written = []
    for name, spec in specs.items():
        if spec.picks_record not in records:
            continue
        saved = records[spec.picks_record].get(name)
        try:
            detached = detached_home(spec)
            if detached is not None:
                adopt_detached(spec, detached, records, from_hook)
                written.append(name)
                continue
            if saved is None or saved["state"] != "set":
                continue
            text = live(spec)
            wanted = missing(spec, text, saved)
            if wanted is None:
                continue
            result = with_pick(spec, text, wanted)
            harness_state.write((REPO / name).resolve(), result)
        except Refused as error:
            refusals.append(str(error))
            continue
        except (OSError, UnicodeError) as error:
            refusals.append(f"{name}: {error}")
            continue
        written.append(name)
    return written, refusals


def forget(spec, specs):
    name, record_name = spec.config, spec.picks_record
    try:
        record = read_record(record_name, specs)
        detached = detached_home(spec)
        if detached is not None:
            h_text = read_text(detached, str(detached))
            r_text = live(spec)
            git_rewrote_r = (not pick(spec, r_text)
                             and (REPO / name).stat().st_mtime_ns > detached.stat().st_mtime_ns)
            base_text = r_text if git_rewrote_r else h_text
            harness_state.write((REPO / name).resolve(), without_pick(spec, base_text))
            relink_home(detached, REPO / name)
        else:
            text = live(spec)
            if pick(spec, text):
                harness_state.write((REPO / name).resolve(), without_pick(spec, text))
    except Refused as error:
        fail(str(error))
    if record.get(name) != {"state": "default"}:
        record[name] = {"state": "default"}
        write_record(record_name, record)
    CHECKOUT.restage(name)


def refuse(refusals):
    if refusals:
        fail("; ".join(refusals))


def operate(args, specs):
    """Run the operation args name under the host lock.

    A filesystem or decoding failure (an unreadable record, a directory where a file
    belongs) fails like any refusal, with the tool's name and no traceback.
    """
    try:
        with CHECKOUT.locked():
            if args[0] == "hook":
                written, refusals = restore(specs, from_hook=True)
                for name in written:
                    CHECKOUT.restage(name)
            elif args[0] == "forget":
                forget(specs[args[1]], specs)
                return
            else:
                refusals = []
                if args[0] in ("capture", "sync"):
                    refusals += capture(specs)
                if args[0] in ("restore", "sync"):
                    refusals += restore(specs)[1]
                if args[0] == "first-run":
                    refusals += first_run(specs)[1]
            refuse(refusals)
    except (OSError, UnicodeError) as error:
        fail(str(error))


def cli_specs(args):
    """The owned entries for a CLI operation, after checking forget names one of them."""
    specs = load_specs()
    if args[0] == "forget" and args[1] not in specs:
        fail(f"{args[1]!r} is not a file live-picks owns; forget takes {' or '.join(specs)}")
    return specs


def main(argv):
    args = argv[1:]
    if not (args in (["capture"], ["restore"], ["sync"], ["first-run"])
            or len(args) == 2 and (args[0] == "forget" or args[0] == "hook"
                                   and args[1] in harness_state.GIT_HOOKS)):
        fail(usage())
    if CHECKOUT.linked_worktree():
        if args[0] == "hook":
            return
        fail(f"{REPO} is a linked worktree; its harness configs are not live")
    if args[0] != "hook":
        operate(args, cli_specs(args))
        return
    if args[1] == "post-checkout" and CHECKOUT.rebasing():
        return
    try:
        operate(args, load_specs())
    except SystemExit as error:
        print(f"{error}\nlive-picks: a pick was not restored; the next turn end retries",
              file=sys.stderr)


if __name__ == "__main__":
    main(sys.argv)
