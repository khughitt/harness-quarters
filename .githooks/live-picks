#!/usr/bin/env python3
"""Keep the model and effort picks in the live harness configs across git commands that drop them.

The harness-state clean filter keeps the picks out of the index: `model`,
`modelSettings` and `effortLevel` in claude/settings.json, the top-level `model` and
`model_reasoning_effort` in codex/config.toml; `defaultProvider`, `defaultModel` and
`defaultThinkingLevel` in pi/settings.json; `model`, `effort`, `effortByBase` and
`trustedWorkspaces` in agy/settings.json. A git command that writes a new blob of
a file over the live one drops the pick, and the harness runs on its default. This
tool saves Claude and Codex picks in local/live-picks.json, pi picks in
local/live-picks-pi.json and agy picks in local/live-picks-agy.json, untracked and
carried between hosts by Dropbox, and puts them back:

    capture               save the pick each file holds; absence never records a reset
    restore               put a saved pick into a file holding none of its fields
    sync                  capture, then restore
    forget <file>         record the file's default and remove its pick from the file
    hook <name>           restore from a git hook, then restage what it wrote

Each picker's owned fields are one unit: Codex's model and effort; Claude's model and
modelSettings (/model), and its effortLevel (/effort); pi's defaultProvider and
defaultModel, and its defaultThinkingLevel; agy's model (/model), effort and effortByBase
(/effort), and trustedWorkspaces. Each separate picker writes one unit.
Git drops all of a file's fields together, so a unit holding none is the only state a
git rewrite leaves; any other state was written by a harness or a person, and the live
file wins. Absence alone cannot tell a rewrite from a return to
the default, so only forget records `default`. Claude, Codex and agy capture at Stop; pi
captures through its extension after picker events, at turn end and at shutdown.
Because agy saves `~/.gemini/antigravity-cli/settings.json` by atomic rename over the
home link when persisting picks or `/config` edits, an anchored host whose
`~/.gemini/config` links point into this checkout also reads any regular file there
during capture and adopts it back into `agy/settings.json`, restoring the symlink on
restore, hook and forget.
Setting the current selection as a default emits no event: it is saved at turn end
or exit, so a git rewrite before then restores the previous saved default. restore
fills only units holding none of their fields, so a newer pick is never overwritten, and capture replaces
only the units the file holds, so a pick of one JSON picker keeps the other's saved
value. forget resets every unit of the file. It prepends Codex's lines, which are top-level keys
whatever follows, and writes only when the result parses to the live values plus the
saved ones and the filter's output, what git stages, is unchanged.

Each record is machine-owned and written whole only when changed; an invalid one is
refused independently, never overwritten. A file that cannot be read is refused alone.
Every operation holds local/harness-state.lock, the host lock codex-trust also takes. A
hook reports a failure on stderr and exits 0, and skips a linked worktree silently and,
from post-checkout, a rebase in progress; the next turn end retries. Every other
operation refuses a linked worktree, whose configs are not live. Design:
docs/specs/2026-10-10-live-model-preservation-design.md, extended by
docs/specs/2026-10-15-pi-live-picks-design.md.
"""
import fnmatch
import functools
import json
import os
from pathlib import Path
import runpy
import stat
import sys
import tomllib

import harness_state

CHECKOUT = harness_state.Checkout("live-picks")
fail = CHECKOUT.fail
REPO = harness_state.REPO
CLAUDE = "claude/settings.json"
CODEX = "codex/config.toml"
PI = "pi/settings.json"
AGY = "agy/settings.json"
OWNED = (CLAUDE, CODEX, PI, AGY)
RECORDS = {CLAUDE: "local/live-picks.json", CODEX: "local/live-picks.json",
           PI: "local/live-picks-pi.json", AGY: "local/live-picks-agy.json"}
USAGE = ("usage: live-picks capture | restore | sync | forget <file> | "
         "hook post-checkout|post-merge|post-rewrite (files: " + ", ".join(OWNED) + ")")
# Every owned field must be dropped by the filter for absence to imply a rewrite.
FILTER = runpy.run_path(str(harness_state.HERE / "harness-state-clean"))
TOML_KEYS = tuple(name for table, name in FILTER["TOML_KEYS"] if table.fullmatch(""))
TOML_HEADER = FILTER["TOML_HEADER"]
TOML_KEY = FILTER["TOML_KEY"]
# Each picker is a unit: a pick of one keeps the other picker's saved value.
CLAUDE_GROUPS = (("model", "modelSettings"), ("effortLevel",))
AGY_GROUPS = (("model",), ("effort", "effortByBase"), ("trustedWorkspaces",))
JSON_GROUPS = {CLAUDE: CLAUDE_GROUPS,
               PI: (("defaultProvider", "defaultModel"), ("defaultThinkingLevel",)),
               AGY: AGY_GROUPS}
JSON_KEYS = {name: sum(groups, ()) for name, groups in JSON_GROUPS.items()}
for name, keys in JSON_KEYS.items():
    dropped = [keys for pattern, keys in FILTER["JSON_FILES"] if fnmatch.fnmatch(name, pattern)]
    if (len(dropped) != 1 or len(keys) != len(set(keys))
            or not set(keys) <= set(dropped[0])
            or name in (CLAUDE, AGY) and set(keys) != set(dropped[0])):
        sys.exit(f"live-picks: {name} groups {JSON_GROUPS[name]} must be disjoint and "
                 "within the filter's keys (equal for Claude and agy)")
CLEAN = {CLAUDE: functools.partial(FILTER["clean_json"], keys=FILTER["CLAUDE_JSON_KEYS"]),
         CODEX: FILTER["clean_toml"],
         PI: functools.partial(FILTER["clean_json"], keys=FILTER["PI_JSON_KEYS"]),
         AGY: functools.partial(FILTER["clean_json"], keys=FILTER["AGY_JSON_KEYS"])}
FIELD = {CLAUDE: "values", CODEX: "lines", PI: "values", AGY: "values"}
AGY_HOME = Path(".gemini/antigravity-cli")
AGY_LINK = AGY_HOME / "settings.json"
AGY_ANCHORS = (
    (Path(".gemini/config/hooks.json"), Path("agy/hooks.json")),
    (Path(".gemini/config/skills.json"), Path("agy/skills.json")),
)


class Refused(Exception):
    """One file cannot be read or written; the others are still handled."""


def parse(name, text):
    try:
        data = json.loads(text) if name in JSON_GROUPS else tomllib.loads(text)
    except (json.JSONDecodeError, tomllib.TOMLDecodeError) as error:
        raise Refused(f"{name} does not parse: {error}")
    if not isinstance(data, dict):
        raise Refused(f"{name} is not an object")
    return data


def codex_lines(text):
    """The owned key lines before the first table header, in file order."""
    lines = []
    for line in text.splitlines(keepends=True):
        if TOML_HEADER.match(line):
            break
        key = TOML_KEY.match(line)
        if key and key.group(1) in TOML_KEYS:
            lines.append(line if line.endswith("\n") else line + "\n")
    return lines


def toml_or_none(text):
    try:
        return tomllib.loads(text)
    except tomllib.TOMLDecodeError:
        return None


def pick(name, text):
    """The owned fields text holds: JSON values or Codex's lines; empty when none.

    A Codex pick the filter could not drop line by line (a multi-line value, a key after
    a header-like line) is refused.
    """
    data = parse(name, text)
    if name in JSON_GROUPS:
        return {key: data[key] for key in JSON_KEYS[name] if key in data}
    lines = codex_lines(text)
    if toml_or_none("".join(lines)) != {key: data[key] for key in TOML_KEYS if key in data}:
        raise Refused(f"{name}: write {' and '.join(TOML_KEYS)} as one-line keys "
                      "before the first table")
    return lines


def invalid(name, saved):
    """Why a record entry is malformed, or None."""
    if name not in OWNED:
        return "not a file live-picks owns"
    if not isinstance(saved, dict) or saved.get("state") not in ("set", "default"):
        return 'state must be "set" or "default"'
    if saved["state"] == "default":
        return None if set(saved) == {"state"} else "a default entry holds only its state"
    if set(saved) != {"state", FIELD[name]}:
        return f'a set entry holds its state and "{FIELD[name]}"'
    held = saved[FIELD[name]]
    if name in JSON_GROUPS:
        if isinstance(held, dict) and held and set(held) <= set(JSON_KEYS[name]):
            return None
        return f"values must name some of {', '.join(JSON_KEYS[name])}"
    if isinstance(held, list) and held and all(isinstance(line, str) for line in held):
        text = "".join(held)
        parsed = toml_or_none(text)
        if parsed is not None and set(parsed) <= set(TOML_KEYS) and codex_lines(text) == held:
            return None
    return f"lines must be one-line {' or '.join(TOML_KEYS)} keys"


def read_record(record_name):
    path = REPO / record_name
    if not path.exists():
        return {}
    try:
        record = json.loads(path.read_text())
    except json.JSONDecodeError as error:
        raise Refused(f"{record_name} is not valid JSON: {error}; fix or delete it") from None
    if not isinstance(record, dict):
        raise Refused(f"{record_name} is not an object; fix or delete it")
    for name, saved in record.items():
        problem = (invalid(name, saved) if RECORDS.get(name) == record_name
                   else "not a file this record owns")
        if problem:
            raise Refused(f"{record_name}: {name}: {problem}; fix or delete it")
    return record


def read_records():
    records, refusals = {}, []
    for record_name in dict.fromkeys(RECORDS.values()):
        try:
            records[record_name] = read_record(record_name)
        except Refused as error:
            refusals.append(str(error))
        except (OSError, UnicodeError) as error:
            refusals.append(f"{record_name}: {error}")
    return records, refusals


def write_record(record_name, record):
    path = REPO / record_name
    harness_state.write(path, json.dumps(record, indent=2, ensure_ascii=False) + "\n")


def read_text(path, label):
    try:
        if not path.is_file():
            raise Refused(f"{label} is missing")
        return path.read_text()
    except (OSError, UnicodeError) as error:
        raise Refused(f"{label} cannot be read: {error}") from None


def live(name):
    return read_text(REPO / name, name)


def points_to(link, target):
    if not link.is_symlink() or not link.exists():
        return False
    try:
        actual = link.parent / os.readlink(link)
        return actual.parent.resolve() / actual.name == target.parent.resolve() / target.name
    except OSError:
        return False


def agy_anchored():
    home = Path.home()
    agy_dir = home / AGY_HOME
    if not (agy_dir.is_dir() and not agy_dir.is_symlink()):
        return False
    return any(points_to(home / link, REPO / target) for link, target in AGY_ANCHORS)


def detached_home(name):
    """A regular file that replaced name's home symlink on an anchored host, or None."""
    if name != AGY or not agy_anchored():
        return None
    path = Path.home() / AGY_LINK
    try:
        mode = path.lstat().st_mode
    except FileNotFoundError:
        return None
    except OSError as error:
        raise Refused(f"{path} cannot be stat'd: {error}") from None
    if stat.S_ISLNK(mode):
        return None
    if not stat.S_ISREG(mode):
        raise Refused(f"{path} is not a regular file")
    return path


def relink_home(path, target):
    """Atomically replace a detached regular file at path with a symlink to target."""
    staging = path.with_name(f".{path.name}.live-picks.{os.getpid()}")
    try:
        staging.unlink(missing_ok=True)
        staging.symlink_to(target)
        if not stat.S_ISREG(path.lstat().st_mode):
            staging.unlink(missing_ok=True)
            raise Refused(f"{path} changed before relinking")
        os.replace(staging, path)
    except BaseException:
        staging.unlink(missing_ok=True)
        raise


def merged_values(name, saved, held):
    """JSON values to save: each group the file holds, else the saved group."""
    saved = saved["values"] if saved and saved["state"] == "set" else {}
    values = {}
    for group in JSON_GROUPS[name]:
        source = held if any(key in held for key in group) else saved
        values.update({key: source[key] for key in group if key in source})
    return values


def missing(name, text, saved):
    """The saved pick for the groups text holds none of; None when there is none."""
    held = pick(name, text)
    if name == CODEX:
        return None if held else saved
    values = {key: value for group in JSON_GROUPS[name] if not any(key in held for key in group)
              for key, value in saved["values"].items() if key in group}
    return {"state": "set", "values": values} if values else None


def capture():
    """Save the pick each file holds; returns the refusals."""
    records, refusals = read_records()
    updated = {path: dict(record) for path, record in records.items()}
    for name in OWNED:
        record_name = RECORDS[name]
        if record_name not in records:
            continue
        try:
            detached = detached_home(name)
            source = read_text(detached, str(detached)) if detached is not None else live(name)
            held = pick(name, source)
        except Refused as error:
            refusals.append(str(error))
            continue
        if name in JSON_GROUPS:
            held = merged_values(name, records[record_name].get(name), held)
        if held:
            updated[record_name][name] = {"state": "set", FIELD[name]: held}
    for record_name, record in updated.items():
        if record != records[record_name]:
            try:
                write_record(record_name, record)
            except (OSError, UnicodeError) as error:
                refusals.append(f"{record_name}: {error}")
    return refusals


def checked(name, text, result, want):
    """result, when it parses to want and the filter's output is text's; else refused."""
    try:
        got = parse(name, result)
    except Refused:
        got = None
    if got != want or CLEAN[name](result) != CLEAN[name](text):
        raise Refused(f"found no way to change {name} that keeps its other values and what "
                      "git stages; nothing written")
    return result


def with_pick(name, text, saved):
    data = parse(name, text)
    if name in JSON_GROUPS:
        want = {**data, **saved["values"]}
        result = json.dumps(want, indent=2, ensure_ascii=False) + "\n"
    else:
        want = {**data, **tomllib.loads("".join(saved["lines"]))}
        result = "".join(saved["lines"]) + text
    return checked(name, text, result, want)


def without_pick(name, text):
    data = parse(name, text)
    if name in JSON_GROUPS:
        want = {key: value for key, value in data.items() if key not in JSON_KEYS[name]}
        result = json.dumps(want, indent=2, ensure_ascii=False) + "\n"
    else:
        want = {key: value for key, value in data.items() if key not in TOML_KEYS}
        kept, top = [], True
        for line in text.splitlines(keepends=True):
            top = top and not TOML_HEADER.match(line)
            key = top and TOML_KEY.match(line)
            if not (key and key.group(1) in TOML_KEYS):
                kept.append(line)
        result = "".join(kept)
    return checked(name, text, result, want)


def adopt_detached(name, detached, records, from_hook):
    """Sync a regular file that replaced name's home symlink back into REPO / name and relink."""
    record_name = RECORDS[name]
    h_text = read_text(detached, str(detached))
    r_text = live(name)
    h_picks = pick(name, h_text)
    r_picks = pick(name, r_text)
    saved = records[record_name].get(name)
    merged = merged_values(name, saved, h_picks)
    repo_mtime = (REPO / name).stat().st_mtime_ns
    detached_mtime = detached.stat().st_mtime_ns
    git_rewrote_r = not r_picks and (
        repo_mtime >= detached_mtime if from_hook else repo_mtime > detached_mtime
    )
    base_text = r_text if git_rewrote_r else h_text
    clean_base = without_pick(name, base_text)
    result = (with_pick(name, clean_base, {"state": "set", "values": merged})
              if merged else clean_base)
    if merged:
        entry = {"state": "set", FIELD[name]: merged}
        if records[record_name].get(name) != entry:
            updated = {**records[record_name], name: entry}
            write_record(record_name, updated)
            records[record_name] = updated
    harness_state.write((REPO / name).resolve(), result)
    relink_home(detached, REPO / name)


def restore(from_hook=False):
    """Put each saved pick into a file holding none of its fields (per JSON picker group).

    Returns the files written and the refusals.
    """
    records, refusals = read_records()
    written = []
    for name in OWNED:
        if RECORDS[name] not in records:
            continue
        saved = records[RECORDS[name]].get(name)
        try:
            detached = detached_home(name)
            if detached is not None:
                adopt_detached(name, detached, records, from_hook)
                written.append(name)
                continue
            if saved is None or saved["state"] != "set":
                continue
            text = live(name)
            wanted = missing(name, text, saved)
            if wanted is None:
                continue
            result = with_pick(name, text, wanted)
            harness_state.write((REPO / name).resolve(), result)
        except Refused as error:
            refusals.append(str(error))
            continue
        except (OSError, UnicodeError) as error:
            refusals.append(f"{name}: {error}")
            continue
        written.append(name)
    return written, refusals


def forget(name):
    record_name = RECORDS[name]
    try:
        record = read_record(record_name)
        detached = detached_home(name)
        if detached is not None:
            h_text = read_text(detached, str(detached))
            r_text = live(name)
            git_rewrote_r = (not pick(name, r_text)
                             and (REPO / name).stat().st_mtime_ns > detached.stat().st_mtime_ns)
            base_text = r_text if git_rewrote_r else h_text
            harness_state.write((REPO / name).resolve(), without_pick(name, base_text))
            relink_home(detached, REPO / name)
        else:
            text = live(name)
            if pick(name, text):
                harness_state.write((REPO / name).resolve(), without_pick(name, text))
    except Refused as error:
        fail(str(error))
    if record.get(name) != {"state": "default"}:
        record[name] = {"state": "default"}
        write_record(record_name, record)
    CHECKOUT.restage(name)


def refuse(refusals):
    if refusals:
        fail("; ".join(refusals))


def operate(args):
    """Run the operation args name under the host lock.

    A filesystem or decoding failure (an unreadable record, a directory where a file
    belongs) fails like any refusal, with the tool's name and no traceback.
    """
    try:
        with CHECKOUT.locked():
            if args[0] == "hook":
                written, refusals = restore(from_hook=True)
                for name in written:
                    CHECKOUT.restage(name)
            elif args[0] == "forget":
                forget(args[1])
                return
            else:
                refusals = []
                if args[0] in ("capture", "sync"):
                    refusals += capture()
                if args[0] in ("restore", "sync"):
                    refusals += restore()[1]
            refuse(refusals)
    except (OSError, UnicodeError) as error:
        fail(str(error))


def main(argv):
    args = argv[1:]
    if not (args in (["capture"], ["restore"], ["sync"])
            or len(args) == 2 and (args[0] == "forget" or args[0] == "hook"
                                   and args[1] in harness_state.GIT_HOOKS)):
        fail(USAGE)
    if args[0] == "forget" and args[1] not in OWNED:
        fail(f"forget takes {' or '.join(OWNED)}, not {args[1]!r}")
    if CHECKOUT.linked_worktree():
        if args[0] == "hook":
            return
        fail(f"{REPO} is a linked worktree; its harness configs are not live")
    if args[0] != "hook":
        operate(args)
        return
    if args[1] == "post-checkout" and CHECKOUT.rebasing():
        return
    try:
        operate(args)
    except SystemExit as error:
        print(f"{error}\nlive-picks: a pick was not restored; the next turn end retries",
              file=sys.stderr)


if __name__ == "__main__":
    main(sys.argv)
