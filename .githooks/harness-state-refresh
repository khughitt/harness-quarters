#!/usr/bin/env python3
"""Harness refresh: clear git's size-only "modified" mark on tracked harness configs.

A model or effort switch rewrites `harnesses/claude/settings*.json`, `harnesses/codex/config*.toml`,
`harnesses/pi/settings*.json` or `harnesses/agy/settings*.json` through the homes' symlinks (or, for agy's
atomic saves, replaces `~/.gemini/antigravity-cli/settings.json` with a regular file that
`live-picks` adopts back into `harnesses/agy/settings.json` and relinks). The harness-state
clean filter keeps those keys out of the index, but git calls a file modified when its size
differs from the index entry without running the filter, so `git status` shows `M` on a file
whose filtered diff is empty. Staging such a file writes the blob already in the index and
refreshes its stat; a file with a real change is left alone.

Claude Code runs this from Stop because `/effort` fires no hook (PostModelSwitch covers
`/model` only; ConfigChange does not fire on the harness's own writes; probed with Claude
Code 2.1.283); Codex and agy have no event nearer their pickers than Stop. pi's extension
calls this after picker events, at turn end and at shutdown. The refresh runs in every
project, so it works on the checkout it lives in, not the cwd. The mark is cosmetic and
must never block a turn: when another git process holds the index lock it skips, and the
next refresh retries. Any other git failure exits non-zero, which the calling harness
reports without blocking. The hooks and pi extension call it through
`~/.local/bin/harness-state-refresh`, a link `links.toml` manages, so the command never
names the checkout.

It first runs `live-picks capture`, which reads the live configs and writes only
local/live-picks.json (Claude and Codex), local/live-picks-pi.json (pi) and
local/live-picks-agy.json (agy), so it runs even while another git process holds the index. Capture never records an absence as a
reset; only forget records the default. Then, unless the index is locked,
`codex-trust sync` saves and restores Codex's project trust and `live-picks restore` puts back a dropped pick; the staging below clears the mark
their inserts leave. A failed step still lets the others run, then fails the hook with
every failing step's message. After capture, a broken harnesses.toml fails the refresh
before it syncs, restores or stages anything, and so does a filter config other than the
one `just setup` writes (`filter.harness-state.clean`, `required = true` and the identity
`smudge = cat`), with a
message naming `just setup`. Design:
docs/specs/2026-10-10-live-model-preservation-design.md §3.3, extended by
docs/specs/2026-10-15-pi-live-picks-design.md §3.3 and
docs/specs/2026-11-01-harness-manifest-design.md §5.3.
"""
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
if str(HERE) not in sys.path:
    sys.path.insert(0, str(HERE))

try:
    import harness_state
except (ImportError, SyntaxError) as error:
    # A harness hook: drain its stdin payload, then fail with a named message, not a traceback.
    sys.stdin.read()
    sys.exit(f"harness-state-refresh: cannot load .githooks/harness_state.py: {error}; "
             "resolve or restore it")

REPO = HERE.parent
TRUST = HERE / "codex-trust"
PICKS = HERE / "live-picks"


def git(*args):
    return subprocess.run(["git", "-C", str(REPO), *args], text=True, capture_output=True)


def checked(*args):
    result = git(*args)
    if result.returncode != 0:
        sys.exit(f"harness-state-refresh: git {' '.join(args)}: {result.stderr.strip()}")
    return result.stdout


def filtered_equal(path):
    result = git("diff", "--quiet", "--", path)
    if result.returncode not in (0, 1):
        sys.exit(f"harness-state-refresh: git diff {path}: {result.stderr.strip()}")
    return result.returncode == 0


def run(label, *command):
    try:
        result = subprocess.run([str(part) for part in command], text=True, capture_output=True)
    except OSError as error:
        result = subprocess.CompletedProcess(command, 1, stdout="",
                                             stderr=f"harness-state-refresh: {label}: {error}")
    return label, result


def main():
    sys.stdin.read()
    steps = [run("live-picks capture", PICKS, "capture")]
    failed = []
    try:
        manifest = harness_state.load_manifest_or_exit("harness-state-refresh")
        try:
            harness_state.check_filter_config()
        except harness_state.ManifestError as error:
            sys.exit(f"harness-state-refresh: {error}")
        patterns = tuple(f":(glob){spec.filter_glob}" for spec in manifest.live_state)
        lock = Path(checked("rev-parse", "--path-format=absolute", "--git-path", "index.lock").strip())
        if not lock.exists():
            steps.append(run("codex-trust sync", TRUST, "sync"))
            steps.append(run("live-picks restore", PICKS, "restore"))
            marked = checked("diff-files", "--name-only", "--", *patterns).split()
            stale = [path for path in marked if filtered_equal(path)]
            if stale:
                checked("add", "--", *stale)
    except SystemExit as error:
        failed.append(str(error))
    failed += [result.stderr.strip()
               or f"harness-state-refresh: {label} exited {result.returncode} with no message"
               for label, result in steps if result.returncode != 0]
    if failed:
        sys.exit("\n".join(failed))


if __name__ == "__main__":
    main()
