#!/usr/bin/env python3
"""Git clean filter: keep model and effort switches out of the tracked harness configs.

The harness homes symlink to `harnesses/claude/settings*.json`, `harnesses/codex/config*.toml`,
`harnesses/pi/settings*.json` and `harnesses/agy/settings*.json`, so `/model` and `/effort` in a session write
straight into the checkout (pi: a model or thinking level set as its default). Those keys
are session state, not configuration: this filter drops them from what git stages and leaves
the working tree — the live file — untouched. Codex also writes bookkeeping (the
screen-reader probe flag, model-announcement counters, marketplace fetch stamps),
dropped the same way, as are the installation ids pi creates. Project trust
(`harnesses/codex/config*.toml` `[projects.*]` and `harnesses/agy/settings*.json` `trustedWorkspaces`) is host
state and is dropped too; `codex-trust` and `live-picks` save it in local/ and
put it back after a checkout drops it. Everything else the harness writes (plugin
toggles, marketplace sources, hook trust hashes) stays tracked. Wired by
`.gitattributes` and `git config filter.harness-state.clean`; the smudge side is
identity, so a checkout drops the pick and `live-picks` puts the saved one back
for Claude, Codex, pi and agy; pi's installation ids are not saved.
"""
import sys
from pathlib import Path

if str(Path(__file__).resolve().parent) not in sys.path:
    sys.path.insert(0, str(Path(__file__).resolve().parent))

try:
    import harness_state
    from harness_state import TOML_HEADER, TOML_KEY, clean_json, clean_toml  # noqa: F401  re-exported
except (ImportError, SyntaxError) as error:
    # Git runs this filter as required: a traceback here fails every status, diff and add.
    sys.exit(f"harness-state-clean: cannot load .githooks/harness_state.py: {error}; "
             "resolve or restore it")

# harnesses.toml names each config this filter cleans, the keys and tables it drops, and
# the path glob .gitattributes routes to it.
MANIFEST = harness_state.load_manifest_or_exit("harness-state-clean")

# tools/relay_cutover_bootstrap/inputs.py reads this name through runpy until hq-7e1e9c
# retires it. Bound only when the manifest gives claude-code a JSON config: no fallback.
_CLAUDE = MANIFEST.by_harness.get("claude-code")
if _CLAUDE is not None and _CLAUDE.format == "json":
    CLAUDE_JSON_KEYS = _CLAUDE.json_clean_keys


def main(argv):
    if len(argv) != 2:
        sys.exit("harness-state-clean: usage: harness-state-clean <path>  (stdin -> stdout)")
    path = argv[1]
    text = sys.stdin.read()
    matches = [spec for spec in MANIFEST.live_state if spec.filter_re.fullmatch(path)]
    if not matches:
        sys.exit(f"harness-state-clean: {path} is not a harness config; check .gitattributes")
    try:
        cleaned = harness_state.clean_for_spec(matches[0], text)
    except ValueError as error:  # includes json.JSONDecodeError and the non-object refusal
        sys.exit(f"harness-state-clean: {path}: {error}; fix the file, then retry")
    sys.stdout.write(cleaned)


if __name__ == "__main__":
    main(sys.argv)
