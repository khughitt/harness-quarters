git restore --staged -- f                            {"d":"forbidden","m":["git restore"]}
git restore f                                        {"d":"forbidden","m":["git restore"]}
git restore --source=MERGE_HEAD --staged --worktree x {"d":"forbidden","m":["git restore"]}
git reset -q -- f                                    {"d":"allow","m":["git reset -q --"]}
git reset -q --hard                                  {"d":null,"m":[]}
git reset --hard                                     {"d":null,"m":[]}
git reset -q -- --hard                               {"d":"allow","m":["git reset -q --"]}
git rm --cached -- f                                 {"d":"allow","m":["git rm --cached --"]}
git rm --cached --no-cached -f -- f                  {"d":null,"m":[]}
git rm --cached -f -- f                              {"d":null,"m":[]}
git rm --cached f                                    {"d":null,"m":[]}
git rm --cached -- --no-cached -f f                  {"d":"allow","m":["git rm --cached --"]}
justification as parsed:
git restore can overwrite uncommitted work. To unstage, run git reset -q -- <path>; for a newly added file, git rm --cached -- <path> also works. To take one side of a conflict, write git show :3:./<path> (theirs; :2:./<path> for ours) to a temporary file and, only if that succeeds, copy it over the file: tmp=$(mktemp) && git show :3:./<path> > "$tmp" && cp "$tmp" "<path>" && rm "$tmp". Then run git add <path> as its own command.
codex-cli 0.164.0
