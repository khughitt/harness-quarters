{
  "hq": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "~/d/hq/harnesses/agy/hook SessionStart --runtime /home/keith/.local/share/relay/v0.6.0/node_modules/relay --delegate 'lore hook profile-notice' --delegate 'mindful notice session-start'"
      },
      {
        "type": "command",
        "command": "'/usr/bin/node' '/home/keith/.local/share/relay/v0.5.0/node_modules/relay/bin/relay.js' hook --harness agy --outer-ms 60000 --subscribers '/home/keith/.config/relay/v0.5.0/relay/subscribers.json' SessionStart",
