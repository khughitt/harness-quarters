{
  "hq": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "~/d/hq/harnesses/agy/hook SessionStart ~/d/lore/hooks/claude-profile ~/d/ops/hooks/capture-notice"
      },
      {
        "type": "command",
        "command": "'/usr/bin/node' '/home/keith/.local/share/relay/v0.3.0/node_modules/relay/bin/relay.js' hook --harness agy --outer-ms 60000 --subscribers '/home/keith/.config/relay/subscribers.json' SessionStart",
        "timeout": 60
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "~/d/hq/harnesses/agy/hook PreToolUse"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "'/usr/bin/node' '/home/keith/.local/share/relay/v0.3.0/node_modules/relay/bin/relay.js' hook --harness agy --outer-ms 60000 --subscribers '/home/keith/.config/relay/subscribers.json' PreToolUse",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "~/d/hq/harnesses/agy/hook Stop"
      },
      {
        "type": "command",
        "command": "~/.local/bin/harness-state-refresh"
      },
      {
        "type": "command",
        "command": "'/usr/bin/node' '/home/keith/.local/share/relay/v0.3.0/node_modules/relay/bin/relay.js' hook --harness agy --outer-ms 60000 --subscribers '/home/keith/.config/relay/subscribers.json' Stop",
        "timeout": 60
      }
    ]
  }
}
