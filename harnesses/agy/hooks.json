    ],
    "Stop": [
      {
        "type": "command",
        "command": "~/d/hq/harnesses/agy/hook Stop --runtime /home/keith/.local/share/relay/v0.5.0/node_modules/relay --guard 'tasks hook claim-guard'"
      },
      {
        "type": "command",
        "command": "~/.local/bin/harness-state-refresh"
