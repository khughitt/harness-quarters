            "command": "'/usr/bin/node' '/home/keith/.local/share/relay/v0.5.0/node_modules/relay/bin/relay.js' hook --harness agy --outer-ms 60000 --subscribers '/home/keith/.config/relay/v0.5.0/relay/subscribers.json' PreToolUse",
