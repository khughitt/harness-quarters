#!/usr/bin/env python3
"""Adapt native agy events to the configured owner commands.

SessionStart heals detached settings before collecting the owners' notices. PreToolUse
heals detached settings and leaves permission handling to agy. Stop delegates claim
policy to tasks and preserves native termination and refire behavior on transport failure.
"""
import argparse
import ctypes
import json
import os
from pathlib import Path
import re
import shlex
import signal
import stat
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[2]
TIMEOUT_S = 10
MAX_NATIVE_BYTES = 4 * 1024 * 1024
NON_BLOCKING_REASONS = frozenset({
    "ERROR",
    "USER_CANCELED",
    "MAX_INVOCATIONS",
    "MAX_FORCED_INVOCATIONS",
    "MAX_TOKEN_BUDGET_EXCEEDED",
    "TERMINAL_CUSTOM_HOOK",
})


def _profile_failure_line(detail):
    return f"profile: unresolved — {detail}; run ops-profile session"


def refresh_detached_settings(env):
    """Best-effort adopt and relink `~/.gemini/antigravity-cli/settings.json` when agy replaced it."""
    home = env.get("HOME")
    if not isinstance(home, str) or not home or "\x00" in home:
        return
    settings = Path(home) / ".gemini" / "antigravity-cli" / "settings.json"
    try:
        mode = settings.lstat().st_mode
    except OSError:
        return
    if not stat.S_ISREG(mode):
        return
    refresh = ROOT / ".githooks" / "harness-state-refresh"
    if not refresh.is_file():
        return
    child_env = {k: v for k, v in env.items() if k != "CLAUDE_ENV_FILE"}
    child_env["PYTHONDONTWRITEBYTECODE"] = "1"
    try:
        done = subprocess.run(
            [sys.executable, "-B", str(refresh)],
            input="",
            env=child_env,
            capture_output=True,
            text=True,
            timeout=TIMEOUT_S,
        )
    except subprocess.TimeoutExpired:
        sys.stderr.write(f"agy-hook: harness-state-refresh timed out after {TIMEOUT_S} s\n")
        return
    except OSError as error:
        sys.stderr.write(f"agy-hook: harness-state-refresh failed ({error})\n")
        return
    if done.returncode != 0:
        detail = done.stderr.strip() or f"exit {done.returncode}"
        sys.stderr.write(f"agy-hook: {detail}\n")


def _inject(text):
    return {"injectSteps": [{"systemMessage": {"systemMessage": text}}]} if text else {}


def _invalid_json_constant(value):
    raise ValueError(f"invalid JSON constant {value}")


def _decode_stop(raw):
    return json.loads(raw, parse_int=float, parse_constant=_invalid_json_constant)


def _decode_stop_fields(raw):
    # Validate in slices of 64 levels. Replace each validated inner container
    # with null in its parent: only the top-level scalar values are needed.
    boundary = re.compile(r'["{}\[\]]')
    pieces = []
    starts = []
    depth = start = pos = 0
    while match := boundary.search(raw, pos):
        char = match[0]
        pos = match.end()
        if char == '"':
            _, pos = json.decoder.scanstring(raw, pos)
        elif char in "[{":
            if depth and depth % 64 == 0:
                pieces.append(raw[start:match.start()])
                starts.append(len(pieces))
                start = match.start()
            depth += 1
        else:
            depth -= 1
            if depth < 0:
                raise ValueError("unexpected JSON closing delimiter")
            if depth and depth % 64 == 0:
                segment = starts.pop()
                pieces.append(raw[start:pos])
                _decode_stop("".join(pieces[segment:]))
                pieces[segment:] = ["null"]
                start = pos
    if depth:
        raise ValueError("unclosed JSON container")
    pieces.append(raw[start:])
    return _decode_stop("".join(pieces))


def _owner_failure_exempt(raw):
    # Relay reads JavaScript numbers, including integral decimal and exponent forms.
    try:
        raw = raw.removeprefix("\ufeff")  # Relay's UTF-8 TextDecoder consumes one BOM.
        event = _decode_stop_fields(raw)
    except ValueError:
        return False
    if not isinstance(event, dict):
        return False
    reason = event.get("terminationReason")
    count = event.get("executionNum")
    return (isinstance(reason, str) and reason in NON_BLOCKING_REASONS) or (
        type(count) is float and 0 < count <= 2**53 - 1 and count.is_integer()
    )


def _run_owner(argv, envelope, env, *, cwd=None):
    # Adopt descendants (including a guard's separately grouped facts reader)
    # when the direct owner command exits or times out.
    children = Path("/proc/thread-self/children")
    with children.open("rb") as owned:
        libc = ctypes.CDLL(None, use_errno=True)
        if libc.prctl(36, 1, 0, 0, 0) != 0:  # PR_SET_CHILD_SUBREAPER
            raise OSError(ctypes.get_errno(), "cannot supervise owner descendants")
        signal.signal(signal.SIGCHLD, signal.SIG_DFL)
        try:
            return subprocess.run(argv, input=json.dumps(envelope).encode(), env=env, cwd=cwd,
                                  stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=TIMEOUT_S)
        finally:
            # run() has reaped the direct owner. Each PID here is now our own
            # unreaped child. Reaping one parent can reveal a further generation.
            while children_left := owned.read().split():
                for value in children_left:
                    pid = int(value)
                    os.kill(pid, signal.SIGKILL)
                    os.waitpid(pid, 0)
                owned.seek(0)


def _owner_argv(command):
    argv = tuple(shlex.split(command))
    if not argv or not argv[0] or "/" in argv[0]:
        raise ValueError("expected an owner command on PATH")
    return argv


def _owner_notices(stdin, runtime, delegates, env):
    refresh_detached_settings(env)
    sys.path.insert(0, str(ROOT / "tools"))
    from hook_routes import relay_runtime

    native = stdin.buffer.read(MAX_NATIVE_BYTES + 1)
    if len(native) > MAX_NATIVE_BYTES:
        raise ValueError("SessionStart input exceeds 4 MiB")
    project = {"harness": "agy", "event": "SessionStart", "raw": native.decode("utf-8"),
               "invokingCwd": os.getcwd(), "registry": {"status": "not-requested"}}
    child_env = {k: v for k, v in env.items() if k != "CLAUDE_ENV_FILE"}
    contexts = []
    dropped_diagnostics = []
    for argv in delegates:
        label = shlex.join(argv)
        envelope = relay_runtime.call(runtime, "project", {
            **project, "subscriber": {"name": argv[0], "role": "notice"},
        })
        try:
            done = _run_owner(argv, envelope, child_env, cwd=envelope["event"]["cwd"])
            if done.returncode:
                raise ValueError(f"exited {done.returncode}")
            reply = relay_runtime.call(runtime, "parse-notice", {"output": done.stdout.decode("utf-8")})
            context = reply.get("context")
            dropped = f"agy-hook SessionStart: {label} exceeded the combined notice limit"
        except (OSError, ValueError, subprocess.TimeoutExpired) as error:
            detail = " ".join(str(error).splitlines())
            context = f"agy-hook SessionStart: {label} failed ({detail})"
            if argv == ("lore", "hook", "profile-notice"):
                context = _profile_failure_line(context)
            dropped = context
        if context:
            contexts.append(context)
            dropped_diagnostics.append(dropped)
    combined = relay_runtime.call(runtime, "combine", {"contexts": contexts})
    for index in combined["dropped"]:
        print(dropped_diagnostics[index], file=sys.stderr)
    return _inject(combined.get("context"))


def owner_stop(stdin, runtime, guard, env):
    raw = ""
    stage = "read Stop input"
    try:
        data = stdin.buffer.read(MAX_NATIVE_BYTES + 1)
        if len(data) > MAX_NATIVE_BYTES:
            raise ValueError("native input exceeds 4 MiB")
        raw = data.decode("utf-8")
        stage = "project Stop input"
        sys.path.insert(0, str(ROOT / "tools"))
        from hook_routes import relay_runtime

        envelope = relay_runtime.call(runtime, "project", {
            "harness": "agy", "event": "Stop", "raw": raw, "invokingCwd": os.getcwd(),
            "subscriber": {"name": "claim-guard", "role": "guard"},
            "registry": {"status": "not-requested"},
        })
        stage = "invoke guard"
        argv = shlex.split(guard)
        if not argv or not argv[0] or "/" in argv[0]:
            raise ValueError("expected a guard command on PATH")
        stage = f"invoke {argv[0]}"
        child_env = {key: env[key] for key in ("PATH", "HOME", "XDG_CONFIG_HOME", "XDG_STATE_HOME")
                     if key in env}
        done = _run_owner(argv, envelope, child_env)
        if done.returncode:
            raise ValueError(f"exited {done.returncode}")
        stage = "parse guard reply"
        reply = relay_runtime.call(runtime, "parse-guard", {"output": done.stdout.decode("utf-8")})
        if reply["decision"] == "deny":
            return {"decision": "continue", "reason": reply["reason"]}
        return {}
    except (ImportError, OSError, ValueError, subprocess.TimeoutExpired) as error:
        if _owner_failure_exempt(raw):
            return {}
        detail = " ".join(str(error).splitlines())
        return {"decision": "continue", "reason": f"agy claim-guard: could not {stage} ({detail})"}


def main(argv, stdin, stdout, env):
    if not argv:
        sys.stderr.write("usage: harnesses/agy/hook <SessionStart|PreToolUse|Stop> ...\n")
        return 2
    sub = argv[0]
    if sub == "SessionStart":
        parser = argparse.ArgumentParser(prog="harnesses/agy/hook SessionStart")
        parser.add_argument("--runtime", required=True, type=Path)
        parser.add_argument("--delegate", required=True, type=_owner_argv, action="append")
        try:
            args = parser.parse_args(argv[1:])
            if len(set(args.delegate)) != len(args.delegate):
                parser.error("duplicate delegate command")
        except SystemExit:
            return 2
        try:
            reply = _owner_notices(stdin, args.runtime, args.delegate, env)
        except (ImportError, OSError, ValueError) as error:
            detail = " ".join(str(error).splitlines())
            reply = _inject(_profile_failure_line(f"agy-hook SessionStart failed ({detail})"))
        stdout.write(json.dumps(reply))
        return 0

    if sub == "PreToolUse":
        stdin.read()
        if len(argv) != 1:
            sys.stderr.write("usage: harnesses/agy/hook PreToolUse\n")
            return 2
        try:
            refresh_detached_settings(env)
        except Exception as error:
            sys.stderr.write(f"agy-hook PreToolUse: {error!r}\n")
        return 0

    if sub == "Stop":
        parser = argparse.ArgumentParser(prog="harnesses/agy/hook Stop")
        parser.add_argument("--runtime", required=True, type=Path)
        parser.add_argument("--guard", required=True)
        try:
            args = parser.parse_args(argv[1:])
        except SystemExit:
            return 2
        stdout.write(json.dumps(owner_stop(stdin, args.runtime, args.guard, env)))
        return 0

    sys.stderr.write(f"harnesses/agy/hook: unknown event {sub!r}\n")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:], sys.stdin, sys.stdout, os.environ))
